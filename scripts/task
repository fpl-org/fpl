#!/usr/bin/env python3
"""scripts/task — FPL's task graph, kept in the repository as Radicle COBs.

    scripts/task new "<title>" [-d <description>] [-b <id>]...   open a task, optionally blocked
    scripts/task list [--all]        open tasks; --all includes done and dropped
    scripts/task ready               tasks nothing is waiting on; exit 1 if a loop is left
    scripts/task show <id>
    scripts/task start|done|drop|reopen <id>
    scripts/task block [-f] <id> <by>  <id> must wait for <by>;  unblock removes it
    scripts/task assign <id> <did>|me|nobody
    scripts/task edit <id> [-t <title>] [-d <description>]

Exit: 0 the answer, 1 an answer with a loop in it, 2 the command was refused.

An <id> is the first word of a title ("A6a lander-core" is A6a), or any unambiguous prefix of
the object id; the first word wins when both would match. Tasks live under refs/cobs/<TYPE>/
of the Radicle repository, as signed operations: who opened, moved or blocked what is part
of the record, and it travels with the repository, not with a forge. scripts/rad-cob-dagtaak
gives the operations their meaning and says who may do what; this file only reads state and
writes actions through `rad cob`. Needs rad (`scripts/layer on radicle`) and a repository that
went through `rad init`. `--self-test` runs the whole thing in a throwaway Radicle home.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile

TYPE = "nl.psjs.dagtaak"
OPEN_STATES = ("todo", "doing")
VERBS = {"start": "doing", "done": "done", "drop": "dropped", "reopen": "todo"}
HERE = os.path.dirname(os.path.abspath(__file__))


def die(message):
    """Refused: the command did not do what was asked. Exit 2, on the model of grep --
    0 the answer, 1 an answer with bad news in it, 2 the question was no good. A harness
    can then tell 'you asked wrong' from 'the graph is stuck' by the code alone.
    """
    print(f"task: {message}", file=sys.stderr)
    sys.exit(2)


def rad(*args, stdin=None):
    """Run rad with scripts/ on PATH, where it finds the rad-cob-dagtaak helper."""
    env = dict(os.environ, PATH=HERE + os.pathsep + os.environ.get("PATH", ""))
    try:
        done = subprocess.run(
            ["rad", *args], env=env, input=stdin, capture_output=True, text=True, check=False
        )
    except FileNotFoundError:
        die("rad not found; scripts/layer on radicle")
    if done.returncode != 0:
        die(f"rad {' '.join(args[:2])} failed: {done.stderr.strip() or done.stdout.strip()}")
    return done.stdout


class Graph:
    def __init__(self):
        self.rid = rad(".").strip()
        if not self.rid.startswith("rad:"):
            die("this is not a Radicle repository; run rad init first")
        self.tasks = {}
        for oid in rad("cob", "list", "--repo", self.rid, "--type", TYPE).split():
            state = json.loads(
                rad("cob", "show", "--repo", self.rid, "--type", TYPE, "--object", oid)
            )
            if state.get("title"):  # an object that never got a valid `open` is not a task
                self.tasks[oid] = state

    def resolve(self, prefix):
        named = [oid for oid, t in self.tasks.items() if label(t).lower() == prefix.lower()]
        if len(named) == 1:
            return named[0]
        hits = [oid for oid in self.tasks if oid.startswith(prefix.lower())]
        if len(hits) != 1:
            die(f"'{prefix}' matches {len(hits)} tasks")
        return hits[0]

    def waiting_on(self, oid):
        """Blockers of `oid` that are still open. An unknown blocker counts as open."""
        blockers = self.tasks[oid].get("blockedBy", [])
        return [b for b in blockers if self.tasks.get(b, {}).get("state", "todo") in OPEN_STATES]

    def path_to(self, src, dst):
        """The chain of open tasks from `src` down to `dst` along `blockedBy`, or None.

        `block a b` makes a loop exactly when `a` is already reachable from `b` this way.
        """
        seen, stack = {src}, [(src, [src])]
        while stack:
            oid, path = stack.pop()
            for nxt in self.waiting_on(oid):
                if nxt == dst:
                    return [*path, nxt]
                if nxt in self.tasks and nxt not in seen:
                    seen.add(nxt)
                    stack.append((nxt, [*path, nxt]))
        return None

    def cycles(self):
        """Open tasks that wait on each other, one list per cycle, each starting at its
        lowest id so the same cycle reads the same way twice.

        A `block` that closes a loop is not refused. Two tasks that each need the other
        is a thing that happens -- the grammar needs to know which nodes carry a span,
        the node set needs to know what the grammar emits -- and the record should be
        able to say so. What it must not do is go quiet: `ready` would come back empty
        with no reason given. So the loop is reported, and splitting one of the tasks is
        the maintainer's call, not the tool's.
        """

        def edges(oid):
            # A blocker nobody has replicated yet holds the task up, but it cannot be
            # part of a loop we can see, so it is not walked.
            return iter([b for b in self.waiting_on(oid) if b in self.tasks])

        found, colour = [], {}  # colour: 1 on the stack, 2 finished
        for root in sorted(self.tasks):
            if colour.get(root) or self.tasks[root]["state"] not in OPEN_STATES:
                continue
            stack = [(root, edges(root))]
            colour[root] = 1
            while stack:
                oid, rest = stack[-1]
                nxt = next(rest, None)
                if nxt is None:
                    colour[oid] = 2
                    stack.pop()
                elif colour.get(nxt) == 1:  # back onto the stack: a loop
                    at = next(i for i, (o, _) in enumerate(stack) if o == nxt)
                    loop = [o for o, _ in stack[at:]]
                    found.append(loop[loop.index(min(loop)) :] + loop[: loop.index(min(loop))])
                elif not colour.get(nxt):
                    colour[nxt] = 1
                    stack.append((nxt, edges(nxt)))
        return found

    def act(self, oid, message, *actions):
        with tempfile.NamedTemporaryFile("w", suffix=".jsonl") as handle:
            handle.write("".join(json.dumps(a) + "\n" for a in actions))
            handle.flush()
            if oid is None:
                return rad(
                    "cob",
                    "create",
                    "--repo",
                    self.rid,
                    "--type",
                    TYPE,
                    "--message",
                    message,
                    handle.name,
                ).strip()
            rad(
                "cob",
                "update",
                "--repo",
                self.rid,
                "--type",
                TYPE,
                "--object",
                oid,
                "--message",
                message,
                handle.name,
            )
            return oid

    def show(self, oid):
        """The state of `oid` as the reducer reads it now, after what this run wrote."""
        return json.loads(rad("cob", "show", "--repo", self.rid, "--type", TYPE, "--object", oid))

    def must_change(self, oid, field, expected):
        """The reducer skips what is not allowed without an error; say so here."""
        if self.show(oid).get(field) != expected:
            die(
                f"{oid[:7]}: not applied. Only the author, or the assignee for state and "
                f"blockers, may do that (scripts/rad-cob-dagtaak)"
            )


def label(task):
    """The first word of the title, without a trailing colon: how a task is named in prose."""
    words = task.get("title", "").split()
    return words[0].rstrip(":") if words else ""


def line(graph, oid):
    task = graph.tasks[oid]
    waiting = graph.waiting_on(oid)
    tail = f"  <- {' '.join(b[:7] for b in waiting)}" if waiting else ""
    who = f"  @{task['assignee'][-8:]}" if task.get("assignee") else ""
    return f"{oid[:7]}  {task['state']:<7}  {task['title']}{who}{tail}"


def parser():
    """The command line, as the module's docstring gives it."""
    top = argparse.ArgumentParser(prog="scripts/task", description=__doc__.split("\n\n")[0])
    sub = top.add_subparsers(dest="cmd", required=True)
    new = sub.add_parser("new")
    new.add_argument("title")
    new.add_argument("-d", "--description", default="")
    new.add_argument("-b", "--blocked-by", action="append", default=[])
    sub.add_parser("list").add_argument("--all", action="store_true")
    sub.add_parser("ready")
    sub.add_parser("show").add_argument("id")
    for verb in VERBS:
        sub.add_parser(verb).add_argument("id")
    for verb in ("block", "unblock"):
        p = sub.add_parser(verb)
        p.add_argument("id")
        p.add_argument("by")
        if verb == "block":
            p.add_argument("-f", "--force", action="store_true")
    assign = sub.add_parser("assign")
    assign.add_argument("id")
    assign.add_argument("to")
    edit = sub.add_parser("edit")
    edit.add_argument("id")
    edit.add_argument("-t", "--title")
    edit.add_argument("-d", "--description")
    return top


def opening(graph, args):
    blockers = [graph.resolve(b) for b in args.blocked_by]
    actions = [{"type": "open", "title": args.title, "description": args.description}]
    actions += [{"type": "block", "by": b} for b in blockers]
    print(graph.act(None, f"open: {args.title}", *actions)[:7])


def listing(graph, args):
    """`list` and `ready`: one line per task, oldest first."""
    for oid in sorted(graph.tasks, key=lambda o: (graph.tasks[o].get("opened", 0), o)):
        state = graph.tasks[oid]["state"]
        if args.cmd == "ready":
            keep = state in OPEN_STATES and not graph.waiting_on(oid)
        else:
            keep = args.all or state in OPEN_STATES
        if keep:
            print(line(graph, oid))
    return report_loops(graph) if args.cmd == "ready" else 0


def report_loops(graph):
    """Each blocker loop as a comment line on stdout; 1 if there is one.

    On stdout, and with a non-zero exit. Not stderr: an agent's harness may drop that
    stream, or show it only when a command fails, and this is the one thing that must not
    go unseen. `#` is the usual skip marker, so `grep -v '^#'` leaves a list of tasks. The
    exit code answers rather than complains, the way `git diff --exit-code` does; `|| true`
    where the answer does not matter.
    """
    loops = graph.cycles()
    for loop in loops:
        ids = " -> ".join(o[:7] for o in [*loop, loop[0]])
        print(f"# waiting on each other, nothing here can start: {ids}")
    return 1 if loops else 0


def showing(graph, args):
    oid = graph.resolve(args.id)
    print(json.dumps({"id": oid, **graph.tasks[oid]}, indent=2))


def moving(graph, args):
    oid = graph.resolve(args.id)
    graph.act(oid, f"{args.cmd}", {"type": "state", "state": VERBS[args.cmd]})
    graph.must_change(oid, "state", VERBS[args.cmd])


def blocking(graph, args):
    oid, by = graph.resolve(args.id), graph.resolve(args.by)
    if oid == by:
        die("a task cannot block itself")
    # Closing a loop is usually a sign that one of the two wants splitting into the
    # part the other needs. Usually, not always -- so this is a stop, not a refusal.
    back = None if args.cmd == "unblock" or args.force else graph.path_to(by, oid)
    if back:
        chain = " -> ".join(o[:7] for o in [oid, *back])
        die(
            f"that makes a loop: {chain}\n"
            "     nothing in it would be ready. See whether one of them splits into\n"
            "     the part the other needs; to record the loop anyway, block --force."
        )
    graph.act(oid, f"{args.cmd} {by[:7]}", {"type": args.cmd, "by": by})


def assigning(graph, args):
    oid = graph.resolve(args.id)
    to = {"me": rad("self", "--did").strip(), "nobody": None}.get(args.to, args.to)
    graph.act(oid, f"assign {args.to}", {"type": "assign", "to": to})
    graph.must_change(oid, "assignee", to)


def editing(graph, args):
    oid = graph.resolve(args.id)
    action = {"type": "edit"}
    if args.title is not None:
        action["title"] = args.title
    if args.description is not None:
        action["description"] = args.description
    if len(action) == 1:
        die("nothing to edit: give -t and/or -d")
    graph.act(oid, "edit", action)


# Each command, by name: it gets the graph and the parsed arguments, and returns the exit
# code, or None for 0.
COMMANDS = {
    "new": opening,
    "list": listing,
    "ready": listing,
    "show": showing,
    **dict.fromkeys(VERBS, moving),
    "block": blocking,
    "unblock": blocking,
    "assign": assigning,
    "edit": editing,
}


def main(argv):
    args = parser().parse_args(argv)
    return COMMANDS[args.cmd](Graph(), args) or 0


def without_git_location(environ):
    """`environ` less every GIT_* variable, so git finds a repository by its working
    directory or -C alone. Under `git rebase -x`, a hook or an editor, git hands
    GIT_DIR (and its kin: `git rev-parse --local-env-vars`) down to what it runs; a
    child's `git init` then re-initialises THAT repository whatever its cwd, and with
    GIT_DIR set but no GIT_WORK_TREE it writes core.bare=true into it. Dropping the
    whole GIT_ prefix is a superset of git's own list and needs no git to compute.
    """
    return {k: v for k, v in environ.items() if not k.startswith("GIT_")}


def tree_bytes(top):
    """Every file under `top` with its contents: a repository's whole state, to compare."""
    seen = {}
    for root, _, files in os.walk(top):
        for name in files:
            path = os.path.join(root, name)
            with open(path, "rb") as handle:
                seen[os.path.relpath(path, top)] = handle.read()
    return seen


def decoy(tmp):
    """A repository at `tmp`/decoy with a linked worktree; the GIT_DIR of that worktree.

    It is made with every GIT_* variable dropped, so it lands where it is told to.
    """
    clean = dict(without_git_location(os.environ), GIT_CONFIG_GLOBAL="/dev/null")
    for cmd in (
        ["init", "-q", f"{tmp}/decoy"],
        [
            "-C",
            f"{tmp}/decoy",
            "-c",
            "user.name=t",
            "-c",
            "user.email=t@t",
            "commit",
            "-q",
            "--allow-empty",
            "-m",
            "decoy",
        ],
        ["-C", f"{tmp}/decoy", "worktree", "add", "-q", "-b", "w", f"{tmp}/decoy-w"],
    ):
        subprocess.run(["git", *cmd], env=clean, check=True, capture_output=True)
    return f"{tmp}/decoy/.git/worktrees/decoy-w"


class Fixture:
    """A throwaway Radicle home and repository under `tmp`, and the way the self-test runs
    anything there: with the environment built here, never the caller's."""

    def __init__(self, tmp):
        self.tmp, self.repo, self.checks = tmp, f"{tmp}/repo", []
        self.env = dict(
            without_git_location(os.environ),
            RAD_HOME=f"{tmp}/home",
            RAD_PASSPHRASE="self-test",
            GIT_CONFIG_GLOBAL="/dev/null",
        )
        os.makedirs(self.repo)

    def sh(self, *cmd, ok=True):
        done = subprocess.run(
            cmd,
            cwd=self.repo,
            env=self.env,
            capture_output=True,
            text=True,
            check=False,
        )
        if ok and done.returncode != 0:
            sys.exit(f"self-test: {' '.join(cmd)}\n{done.stdout}{done.stderr}")
        return done

    def task(self, *args, ok=True):
        return self.sh(sys.executable, os.path.abspath(__file__), *args, ok=ok)

    def out(self, *args):
        """What a task command that must succeed prints."""
        return self.task(*args).stdout

    def check(self, name, ok):
        self.checks.append((name, bool(ok)))

    def init(self, untouched):
        """rad auth, a git repository with one commit, rad init. `untouched` is asked
        between git and rad, so a fixture whose git went astray stops before rad does."""
        self.sh("rad", "auth", "--alias", "selftest")
        self.sh("git", "-C", self.repo, "init", "-q", "-b", "main")
        identity = ["-c", "user.name=t", "-c", "user.email=t@t"]
        self.sh("git", "-C", self.repo, *identity, "commit", "-q", "--allow-empty", "-m", "init")
        if not untouched():
            sys.exit("self-test: the fixture's git reached the repository GIT_DIR names")
        self.sh(
            *("rad", "init", "--name", "selftest", "--description", "x"),
            *("--default-branch", "main", "--private", "--no-confirm"),
        )


def basics(f):
    """new, ready, list, the state verbs, assign and edit. Returns the two tasks' ids."""
    lexer = f.out("new", "lexer: integer literals").strip()
    parser = f.out("new", "parser: integer expressions", "-b", lexer).strip()
    f.check("ids are 7 characters", len(lexer) == 7 and len(parser) == 7)
    ready = f.out("ready")
    f.check("blocked task is not ready", lexer in ready and parser not in ready)
    f.check("list shows the blocker", f"<- {lexer}" in f.out("list"))
    f.task("start", lexer)
    f.check("start", "doing" in f.out("list"))
    f.task("done", lexer)
    ready = f.out("ready")
    f.check("done unblocks", parser in ready and lexer not in ready)
    f.check(
        "list hides done, --all shows it",
        lexer not in f.out("list") and lexer in f.out("list", "--all"),
    )
    f.task("assign", parser, "me")
    f.check("assign me", json.loads(f.out("show", parser))["assignee"].startswith("did:key:"))
    f.task("edit", parser, "-t", "parser: expressions")
    f.check("edit", "parser: expressions" in f.out("list"))
    f.check("self-block refused", f.task("block", parser, parser, ok=False).returncode == 2)
    return lexer, parser


def lanes(f):
    """Labels: a task is named by the first word of its title."""
    f.out("new", "lane-X the lane")
    f.check("a label names a task", f.task("show", "lane-X").returncode == 0)


def loops(f):
    """A loop may be recorded; what it may not do is make `ready` go quiet."""
    left = f.out("new", "span: pick the representation").strip()
    right = f.out("new", "grammar: emit spans").strip()
    f.task("block", left, right)
    refused = f.task("block", right, left, ok=False)
    f.check("a loop is refused by default, with the refusal code", refused.returncode == 2)
    f.check(
        "and the message names the chain and the way out",
        "makes a loop" in refused.stderr and "--force" in refused.stderr,
    )
    f.task("block", right, left, "--force")
    done = f.task("ready", ok=False)
    f.check(
        "a loop keeps both out of the list",
        f"\n{left}" not in done.stdout and f"\n{right}" not in done.stdout,
    )
    f.check("and ready exits 1, the answer-with-bad-news code", done.returncode == 1)
    f.check(
        "and says so on stdout, naming them",
        "waiting on each other" in done.stdout and left in done.stdout and right in done.stdout,
    )
    f.check(
        "the notice is a comment, so a filter leaves tasks only",
        all(
            not row.startswith("#")
            for row in done.stdout.splitlines()
            if row and "waiting" not in row
        ),
    )
    f.task("drop", left)
    freed = f.task("ready")
    f.check("dropping one ends the loop", right in freed.stdout and freed.returncode == 0)
    f.check("unknown id refused", f.task("done", "ffffffff", ok=False).returncode != 0)


def self_test():
    """End to end against a real rad, in a throwaway home and repository.

    It runs with GIT_DIR pointing at a linked worktree of a decoy repository, as
    `git rebase -x` in a worktree hands the caller's down, and checks at the end that
    the decoy did not change by a byte. That is the shape that bit: a `git init` under
    such a GIT_DIR writes core.bare=true into the shared config of every worktree.
    """
    inherited = os.environ.get("GIT_DIR")
    with tempfile.TemporaryDirectory() as tmp:
        os.environ["GIT_DIR"] = decoy(tmp)
        before = tree_bytes(f"{tmp}/decoy/.git")
        f = Fixture(tmp)
        f.init(lambda: tree_bytes(f"{tmp}/decoy/.git") == before)
        lexer, _ = basics(f)
        lanes(f)
        loops(f)
        oid = json.loads(f.out("show", lexer))["id"]
        rid = f.sh("rad", ".").stdout.strip()
        log = f.sh("rad", "cob", "log", "--repo", rid, "--type", TYPE, "--object", oid).stdout
        f.check("every operation is a signed-off commit with an author", log.count("author") >= 3)
        f.check(
            "an inherited GIT_DIR's repository is left as it was",
            tree_bytes(f"{tmp}/decoy/.git") == before,
        )
    os.environ.pop("GIT_DIR")
    if inherited is not None:
        os.environ["GIT_DIR"] = inherited
    failed = [name for name, ok in f.checks if not ok]
    for name in failed:
        print(f"FAIL {name}", file=sys.stderr)
    print(f"task: self-test {'ok' if not failed else 'FAILED'} ({len(f.checks)} checks)")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        self_test()
    sys.exit(main(sys.argv[1:]) or 0)

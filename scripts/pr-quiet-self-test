#!/usr/bin/env bash
#
# scripts/pr-quiet-self-test — proof that scripts/pr calls a head quiet only when every bot
# is and no review thread is open: --quiet says so and reads only, --reviewer asks nobody and
# --ready marks nothing otherwise, and neither acts on what moved since it judged. Run by
# `make gates`.
#
# The forge is a small HTTP server of the test's own on 127.0.0.1 (FPL_API_URL): it answers
# from one file of routes a scene writes, by method and path or a GraphQL query's field, and
# logs every write, one line each. A scene is a pull request in a state measured on
# fpl-org/fpl (2026-10-21): Codex clean, at its usage limit, running, or with only a 👀 on the
# ask; threads open, resolved or deferred; CodeRabbit and the Claude job running or done; the
# bots' own bodies, trimmed. The token is a made-up line in .git/agent-credentials, a gh that
# has none comes first on PATH, and git's config, HOME and gh's config point away from the
# maintainer's.
#
# Where there is a /bin/bash other than the bash running this, the whole run is made a second
# time with it first on PATH: on a Mac that is bash 3.2.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
command -v gitleaks >/dev/null || {
	echo "pr-quiet-self-test: needs gitleaks, for the leak gate --defer passes; enter the dev shell (nix develop)" >&2
	exit 1
}
tmp="$(mktemp -d "${TMPDIR:-/tmp}/pr-quiet-self-test.XXXXXX")"
server=""
# The forge is reaped as well as killed: bash 3.2 reports a killed job it never waited for.
trap '[ -z "$server" ] || { kill "$server"; wait "$server"; } 2>/dev/null || true; rm -rf "$tmp"' EXIT
: >"$tmp/gitconfig"
# shellcheck disable=SC2046 # one name a line, split on purpose
unset GH_TOKEN GITHUB_TOKEN GH_HOST FPL_API_URL FPL_PR_TIMEOUT FPL_PR_ROUNDS GIT_NAMESPACE \
	GIT_CEILING_DIRECTORIES $(git rev-parse --local-env-vars)
export GIT_CONFIG_GLOBAL="$tmp/gitconfig" GIT_CONFIG_NOSYSTEM=1 HOME="$tmp/home" \
	XDG_CONFIG_HOME="$tmp/xdg" GH_CONFIG_DIR="$tmp/gh" GIT_AUTHOR_NAME=t \
	GIT_AUTHOR_EMAIL=t@example.invalid GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.invalid \
	FPL_PR_WAIT=0 FPL_PR_POLL=0
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$GH_CONFIG_DIR"

forge="$tmp/forge"
mkdir -p "$forge"
cat >"$tmp/forge.py" <<'PY'
import json, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

forge = sys.argv[1]
MUTATIONS = {  # the mutations scripts/pr sends, and GitHub's answer to each
    "markPullRequestReadyForReview": {"pullRequest": {"isDraft": False}},
    "resolveReviewThread": {"thread": {"isResolved": True}},
}


class Handler(BaseHTTPRequestHandler):
    def serve(self, method):
        url = urlparse(self.path)
        body = self.rfile.read(int(self.headers.get("Content-Length") or 0)).decode()
        routes = json.load(open(f"{forge}/routes.json"))
        query = json.loads(body).get("query", "") if url.path == "/graphql" else ""
        if method != "GET" and not query.lstrip().startswith("query"):  # a GraphQL query reads
            with open(f"{forge}/log", "a") as log:
                log.write(f"{method} {url.path} {body}\n")
        if self.headers.get("Authorization") != "Bearer made-up-token":
            return self.reply(401, {"message": "Bad credentials"})
        if url.path == "/graphql":
            if query.count("{") != query.count("}"):  # GitHub would answer with a parse error
                return self.reply(200, {"errors": [{"message": "Expected NAME"}]})
            for name, answer in MUTATIONS.items():
                if query.lstrip().startswith("mutation") and name in query:
                    return self.reply(200, routes.get(f"graphql {name}", {"data": {name: answer}}))
            if "PullRequestReviewThread" in query:  # the rest of one thread's comments
                return self.reply(200, routes["graphql comments"])
            if "reviewThreads" in query:
                return self.reply(200, self.take(routes, "graphql reviewThreads"))
            return self.reply(200, {"errors": [{"message": "not served"}]})
        key = f"{method} {url.path}"
        if key in routes:
            return self.reply(200, self.take(routes, key))
        if method == "POST":
            return self.reply(201, {})
        return self.reply(404, {"message": "Not Found"})

    def take(self, routes, key):  # a "<key> next" route answers every read after the first
        got = routes[key]
        if f"{key} next" in routes:
            routes[key] = routes.pop(f"{key} next")
            json.dump(routes, open(f"{forge}/routes.json", "w"))
        return got

    def reply(self, code, answer):
        data = json.dumps(answer).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    do_GET, do_POST = (lambda self: self.serve("GET")), (lambda self: self.serve("POST"))
    log_message = lambda self, *args: None


httpd = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
with open(f"{forge}/port", "w") as f:
    f.write(str(httpd.server_port))
httpd.serve_forever()
PY

# scene <word>...: write the forge's routes for pull request 7, head H, as the words say.
cat >"$tmp/scene.py" <<'PY'
import json, sys

words, forge = set(sys.argv[2:]), sys.argv[1]
H, OLD = "c0ffee" * 6 + "abcd", "0dd" * 13 + "0"
R, U = "/repos/pr-test/fpl", "https://github.com/pr-test/fpl"
CODEX, BOT = "chatgpt-codex-connector[bot]", {"__typename": "Bot", "login": "chatgpt-codex-connector"}
ASK = {"id": 11, "user": {"login": "psjg"}, "body": "@codex review\n", "created_at": "2026-10-21T02:17:01Z"}


def comment(i, body, at="2026-10-21T02:18:00Z", who=CODEX):
    return {"id": i, "user": {"login": who}, "body": body, "created_at": at, "updated_at": at}


def state(sha, status, unresolved=False):
    blob = json.dumps({"code_review": {"commit_sha": sha, "has_any_findings": unresolved,
                                       "has_unresolved_findings": unresolved, "status": status}})
    row = "🔄 **Running** since <relative-time datetime=\"2026-10-21T02:17:20Z\">" if status == "running" else "✅ **Completed**"
    return comment(10, f"<!-- codex-pull-request-review-summary -->\n<!-- codex-review-state:v1 {blob} -->\n\n"
                   f"## Codex Review Summary\n\n| 📝 **Code Review** | {row} | `{sha[:7]}` |", "2026-10-20T19:11:39Z")


def thread(i, resolved=False, at=OLD, author=BOT, outdated=False, replies=()):
    first = {"databaseId": 100 + i, "url": f"{U}/pull/7#discussion_r{100 + i}", "author": author,
             "body": f"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Finding {i}**", "originalCommit": {"oid": at}}
    rest = [{"databaseId": 200 + i, "url": "", "author": {"__typename": "User", "login": "psjg-claude"},
             "body": text, "originalCommit": {"oid": at}} for text in replies]
    return {"id": f"T{i}", "isResolved": resolved, "isOutdated": outdated, "path": "scripts/x", "line": i,
            "comments": {"pageInfo": {"hasNextPage": False}, "nodes": [first] + rest}}


said, threads, reviews, runs, statuses = [ASK], [], [], [], []
said.append(state(H, "completed") if "clean" in words else
            state(H, "completed", True) if "flagged" in words else
            state(H, "running") if "running" in words else
            state(H, "failed") if "failed" in words else state(OLD, "completed"))
if "limit" in words:
    said.append(comment(12, "You have reached your Codex usage limits for code reviews. You can see your limits in the [Codex usage dashboard](https://chatgpt.com/codex/cloud/settings/usage)."))
if "unconnected" in words:
    said.append(comment(12, "To use Codex here, [create a Codex account and connect to github](https://chatgpt.com/codex/cloud/settings/connectors)."))
eyes = [{"user": {"login": CODEX}, "content": "eyes"}] if "eyes" in words else []
if "receipts" in words:  # three rounds: two reviews with findings, one clean receipt
    reviews = [{"user": {"login": CODEX}, "commit_id": OLD}] * 2
    said.append(comment(13, "<!-- codex-review-receipt:v1 -->\n\nCodex Review: Didn't find any major issues. Bravo."))
if "open" in words:
    threads.append(thread(1, outdated=True))
if "human" in words:
    threads.append(thread(2, author={"__typename": "User", "login": "psjg"}))
if "fixed" in words:
    threads.append(thread(3, resolved=True))
if "dropped" in words:  # resolved on the head it was found on, no deferral
    threads.append(thread(4, resolved=True, at=H))
deferral = f"Deferred to {U}/issues/50, the follow-up of this pull request."
if "deferred" in words:
    threads.append(thread(5, resolved=True, at=H, replies=[deferral]))
if "hushed" in words:  # a person's thread, resolved with a deferral
    threads.append(thread(7, resolved=True, author={"__typename": "User", "login": "psjg"}, replies=[deferral]))
issue = {"number": 50, "state": "open", "body": f"- {U}/pull/7#discussion_r105\n\nFollow-up branch: `agent/claude/stack/x.followup`"}
if "unnamed" in words:
    issue["body"] = f"- {U}/pull/7#discussion_r105"
if "unlisted" in words:
    issue["body"] = issue["body"].replace("discussion_r105", "discussion_r999")
if "own" in words:  # the follow-up is the pull request's own branch
    issue["body"] = issue["body"].replace("x.followup", "x")
if "closed" in words:
    issue["state"] = "closed"
if "halfway" in words:  # an earlier --defer answered it and did not resolve it
    threads.append(thread(8, at=H, replies=[deferral]))
if "leaky" in words:
    node = threads[0]["comments"]["nodes"][0]
    node["body"] = node["body"].replace("Finding 1", "Finding quuxfrobnitz")
rabbit = ("pending", "Review in progress") if "rabbit" in words else ("success", "Review skipped")
statuses.append({"context": "CodeRabbit", "state": rabbit[0], "description": rabbit[1]})
runs.append({"name": "claude-review", "status": "in_progress" if "claude" in words else "completed"})
pull = {"number": 7, "state": "open", "draft": "draft" in words, "head": {"sha": H, "ref": "agent/claude/stack/x"}, "node_id": "PR_7",
        "requested_reviewers": [], "requested_teams": []}
routes = {
    "GET /user": {"login": "psjg-claude"},
    f"GET {R}/pulls/7": pull,
    f"GET {R}/pulls/7/reviews": reviews,
    f"GET {R}/issues/7/comments": said,
    f"GET {R}/issues/comments/11/reactions": eyes,
    f"GET {R}/commits/{H}": {"commit": {"message": "feat(x): y\n\nSeries-Id: x-1a2b3c\n"}},
    f"POST {R}/issues": {"number": 51, "html_url": f"{U}/issues/51"},
    f"GET {R}/commits/{H}/check-runs": {"total_count": len(runs), "check_runs": runs},
    f"GET {R}/commits/{H}/status": {"total_count": len(statuses), "statuses": statuses},
    "graphql reviewThreads": {"data": {"repository": {"pullRequest": {"reviewThreads": {
        "pageInfo": {"hasNextPage": False, "endCursor": None}, "nodes": threads}}}}},
}
if "broken" in words:
    routes["graphql reviewThreads"] = {"data": {"repository": None}}
if "moved" in words:  # a push lands while the bots are judged
    routes[f"GET {R}/pulls/7 next"] = dict(pull, head={"sha": "fe" * 20})
if "opened" in words:  # a bot opens a thread while the rest is judged
    routes["graphql reviewThreads next"] = json.loads(json.dumps(routes["graphql reviewThreads"]))
    routes["graphql reviewThreads next"]["data"]["repository"]["pullRequest"]["reviewThreads"]["nodes"].append(thread(6))
for word, answer in (("hollow", {}), ("refused", {"errors": [{"message": "nope"}]})):
    if word in words:  # the forge answers the mutation with nothing, or with an error
        routes["graphql markPullRequestReadyForReview"] = answer
if "unsettled" in words:  # the forge answers the resolution without the thread
    routes["graphql resolveReviewThread"] = {"data": {"resolveReviewThread": {"thread": None}}}
if "deferred" in words and "noissue" not in words:
    routes[f"GET {R}/issues/50"] = issue
if "long" in words:  # thread 5 has more comments than a page: its deferral is on the second
    nodes = threads[-1]["comments"]["nodes"]
    threads[-1]["comments"] = {"pageInfo": {"hasNextPage": True, "endCursor": "c1"}, "nodes": nodes[:1]}
    routes["graphql comments"] = {"data": {"node": {"comments": {
        "pageInfo": {"hasNextPage": False, "endCursor": None}, "nodes": nodes[1:]}}}}
json.dump(routes, open(f"{forge}/routes.json", "w"))
open(f"{forge}/log", "w").close()
PY
scene() { python3 "$tmp/scene.py" "$forge" "$@"; }
scene clean
python3 "$tmp/forge.py" "$forge" &
server=$!
for _ in $(seq 100); do [ -s "$forge/port" ] && break || sleep 0.1; done
[ -s "$forge/port" ] || { echo "pr-quiet-self-test: the forge did not start" >&2; exit 1; }
export FPL_API_URL="http://127.0.0.1:$(cat "$forge/port")"

repo="$tmp/repo"
git init -q -b main "$repo"
cd "$repo"
cp -R "$root/scripts" .
git remote add github https://github.com/pr-test/fpl.git
git config branch.main.remote github
echo 1+psjg-claude@users.noreply.github.com >"$(git rev-parse --git-dir)/agent-identity"
echo 'https://psjg-claude:made-up-token@github.com' >"$(git rev-parse --git-dir)/agent-credentials"
echo quuxfrobnitz >"$(git rev-parse --git-dir)/leak-patterns"
mkdir -p "$tmp/bin"
printf '#!/bin/sh\nexit 1\n' >"$tmp/bin/gh"
chmod +x "$tmp/bin/gh"
export PATH="$tmp/bin:$PATH"

fails=0 total=0
# fail <what> <file>: count a failed check, and say which, with the file that shows why.
fail() { fails=$((fails + 1)) && printf 'FAIL %s\n' "$1" >&2 && sed 's/^/    /' "$2" >&2; }
# run <exit code> <description> <scripts/pr arguments...>: stderr in $tmp/err.
run() {
	local want="$1" what="$2" got=0
	shift 2 && total=$((total + 1))
	scripts/pr "$@" >"$tmp/out" 2>"$tmp/err" || got=$?
	[ "$got" -eq "$want" ] || fail "$what: exit $got, want $want" "$tmp/err"
}
# says <text> <description>: the last run's stderr holds the text.
says() { total=$((total + 1)) && grep -qF -- "$1" "$tmp/err" || fail "$2: stderr lacks $1" "$tmp/err"; }
# logged <pattern> <description>: the forge logged a write that matches.
logged() { total=$((total + 1)) && grep -q -- "$1" "$forge/log" || fail "$2: no write matches $1" "$forge/log"; }
# wrote <count> <description>: the forge logged that many writes since the scene.
wrote() { total=$((total + 1)) && [ "$(wc -l <"$forge/log")" -eq "$1" ] || fail "$2: want $1 writes" "$forge/log"; }

# Quiet: Codex completed and clean at the head, threads resolved, the rest done.
scene clean fixed
run 0 "clean head" --quiet 7
says "every bot is quiet at c0ffeec" "clean head"
wrote 0 "--quiet reads only"
run 0 "clean head, review asked" --reviewer 7 psjg
wrote 1 "the review request is sent"
scene clean draft
run 1 "a draft asks nobody" --reviewer 7 psjg
says "pr/reviewer: #7 is a draft" "draft reviewer"
wrote 0 "a draft's --reviewer writes nothing"
run 0 "clean draft marked ready" --ready 7
logged markPullRequestReadyForReview "clean draft marked"
# Codex reviews no draft (codex-review.yml): --ready leaves pr/codex to --reviewer.
scene draft fixed
run 0 "a draft Codex was never asked about is marked ready" --ready 7
logged markPullRequestReadyForReview "draft without Codex marked"

# The four silences: only the first is quiet.
scene limit
run 1 "usage limit" --quiet 7
says "pr/codex: Codex answered the last ask with its usage limit" "usage limit"
says "re-run the codex-review job of c0ffeec" "usage limit remedy"
scene failed limit
run 1 "failed at the head on a usage limit" --quiet 7
says "usage limit (its review of c0ffeec is failed)" "failed"
scene running
run 1 "running" --quiet 7
says "pr/codex: Codex is reviewing c0ffeec, running since 2026-10-21T02:17:20Z" "running"
scene eyes
run 1 "eyes only" --quiet 7
says "pr/codex: Codex took the last ask (eyes) and has posted no review of c0ffeec" "eyes"
scene unconnected
run 1 "ask from an account without Codex" --quiet 7
says "an ask from an account without Codex" "unconnected"
scene
run 1 "asked, no answer" --quiet 7
says "pr/codex: Codex was asked at 2026-10-21T02:17:01Z and has not reviewed c0ffeec" "asked"

# Refused means nothing is asked or marked.
scene limit
run 1 "reviewer refused" --reviewer 7 psjg
says "pr/codex" "reviewer refused"
says "nobody was asked" "reviewer refused"
wrote 0 "a refused --reviewer writes nothing"
scene clean open draft
run 1 "ready refused at once on an open thread" --ready 7
says "pr/threads: 1 of 1 review threads unresolved" "ready refused"
says "is not quiet, so it stays a draft" "ready refused at once, not after a wait"
wrote 0 "a refused --ready marks nothing"
scene clean rabbit draft
run 1 "ready waits on a running review, then refuses" --ready 7
says "is not quiet after 0s" "ready waits"
wrote 0 "a waiting --ready marks nothing"

# What moves between the judgment and the ask is judged again: a push, a new thread.
scene clean moved
run 1 "pushed while judged" --reviewer 7 psjg
says "changed while it was read (c0ffeec to fefefef)" "moved"
wrote 0 "a moved head asks nobody"
scene clean opened
run 1 "a thread opened while judged" --reviewer 7 psjg
says "pr/threads: 1 of 1" "opened, reviewer"
wrote 0 "a new thread asks nobody"
scene clean draft opened
run 1 "a thread opened while judged, ready" --ready 7
says "pr/threads: 1 of 1" "opened, ready"
wrote 0 "a new thread marks nothing"
# An answer that is not the mutation's is no success.
scene clean draft hollow
run 1 "ready answered with nothing" --ready 7
says "stays a draft: the forge's answer is not the mutation's" "hollow"
scene clean draft refused
run 1 "ready answered with an error" --ready 7
says "stays a draft: nope" "refused"

# Threads: anyone's, outdated included, each named with who opened it.
scene clean open
run 1 "an outdated bot thread" --quiet 7
says "pr/threads: 1 of 1 review threads unresolved, outdated ones included: https://github.com/pr-test/fpl/pull/7#discussion_r101 (by chatgpt-codex-connector)" "open thread"
says "(0 of 3 Codex rounds)" "rounds in the remedy"
scene clean human
run 1 "the maintainer's own open thread" --quiet 7
says "discussion_r102 (by psjg)" "human thread"
scene flagged fixed
run 0 "Codex flagged findings it has since seen resolved" --quiet 7
scene flagged open
run 1 "Codex flagged findings still open" --quiet 7
says "pr/codex: Codex finished c0ffeec with findings unresolved" "flagged open"
scene clean broken
run 1 "threads unreadable: fail closed" --quiet 7
says "pr/threads: the forge's answer is not a page of review threads" "broken threads"

# Deferral: only past the budget, only to an open issue that lists the thread and names its
# follow-up branch; a finding resolved at the head it was found on must be deferred.
scene clean receipts open
run 1 "budget spent" --quiet 7
says "the budget of 3 Codex rounds is spent (3)" "budget spent"
scene clean dropped
run 1 "resolved at its own head, not deferred" --quiet 7
says "pr/deferred: https://github.com/pr-test/fpl/pull/7#discussion_r104 was found at c0ffeec" "dropped"
scene clean receipts deferred
run 0 "deferred past the budget" --quiet 7
scene clean deferred
run 1 "deferred under the budget" --quiet 7
says "pr/budget: https://github.com/pr-test/fpl/pull/7#discussion_r105 is deferred after 0 Codex rounds" "under budget"
scene clean receipts deferred noissue
run 1 "deferred to no issue" --quiet 7
says "pr/deferred: issue #50 does not exist" "no issue"
scene clean receipts deferred unnamed
run 1 "deferred to an issue that names no branch" --quiet 7
says "issue #50 names no follow-up branch" "unnamed"
scene clean receipts deferred unlisted
run 1 "deferred to an issue that does not list the thread" --quiet 7
says "issue #50 does not list https://github.com/pr-test/fpl/pull/7#discussion_r105" "unlisted"
scene clean receipts deferred closed
run 1 "deferred to a closed issue" --quiet 7
says "issue #50 is closed" "closed"
scene clean receipts deferred own
run 1 "deferred to the pull request's own branch" --quiet 7
says "issue #50 names the pull request's own branch" "own branch"
scene clean receipts deferred long
run 0 "a deferral past the first page of a thread's comments" --quiet 7
scene clean receipts deferred hushed
run 1 "a person's thread deferred" --quiet 7
says "pr/deferred: https://github.com/pr-test/fpl/pull/7#discussion_r107 is a person's thread" "hushed"

# Past the budget the open findings move to a follow-up: one issue lists them and names the
# branch, each thread links it and is resolved; then the bots are quiet. Before the budget,
# while Codex is not done, off an agent branch, or with a private term, nothing is written.
export FPL_MODEL="Test Model"
scene clean receipts open
run 0 "deferred to a follow-up" --defer 7 agent/claude/stack/x.followup
logged '^POST /repos/pr-test/fpl/issues .*Follow-up branch: `agent/claude/stack/x.followup`.*Series-Id: x-1a2b3c.*discussion_r101 P2 Finding 1' \
	"the issue names the branch, the Series-Id and the thread"
logged '^POST /repos/pr-test/fpl/pulls/7/comments/101/replies .*Deferred to https://github.com/pr-test/fpl/issues/51, the follow-up' \
	"the thread is answered with the issue"
logged 'resolveReviewThread.*"T1"' "the thread is resolved"
wrote 3 "an issue, a reply, a resolution"
scene clean open
run 1 "defer under the budget" --defer 7 agent/claude/stack/x.followup
says "pr/budget: #7 has spent 0 of its 3 Codex rounds" "defer budget"
wrote 0 "defer under the budget writes nothing"
scene running receipts open
run 1 "defer while Codex runs" --defer 7 agent/claude/stack/x.followup
says "a deferral follows a finished round" "defer running"
wrote 0 "defer while Codex runs writes nothing"
scene clean receipts open
run 1 "defer to main" --defer 7 main
says "pr/defer: 'main' is not an agent branch" "defer main"
run 1 "defer to its own branch" --defer 7 agent/claude/stack/x
says "pr/defer: agent/claude/stack/x is #7's own branch" "defer own"
wrote 0 "a deferral to its own branch writes nothing"
scene clean receipts open human
run 0 "a person's thread stays" --defer 7 agent/claude/stack/x.followup
wrote 3 "only the bot's thread is deferred"
logged 'Follow-up of #7: 1 review findings' "the issue lists the bot's thread alone"
scene clean receipts halfway
run 0 "a retry resolves what was answered" --defer 7 agent/claude/stack/x.followup
logged 'resolveReviewThread.*"T8"' "the answered thread is resolved"
wrote 1 "no second issue, no second reply"
scene clean receipts open halfway
run 0 "a retry with a new finding" --defer 7 agent/claude/stack/x.followup
wrote 4 "an issue and a reply for the new one, two resolutions"
scene clean receipts open unsettled
run 1 "a resolution answered without the thread" --defer 7 agent/claude/stack/x.followup
says "stays open: the forge's answer is not the mutation's" "unsettled"
scene clean receipts open leaky
run 1 "defer with a private term" --defer 7 agent/claude/stack/x.followup
says "nothing was sent" "defer leak"
wrote 0 "a leaking deferral writes nothing"
unset FPL_MODEL
scene clean receipts open
run 1 "defer without a model" --defer 7 agent/claude/stack/x.followup
says "set FPL_MODEL" "defer model"

# The other bots, mid-review.
scene clean rabbit
run 1 "CodeRabbit reviewing" --quiet 7
says "pr/coderabbit: CodeRabbit is reviewing c0ffeec (Review in progress)" "rabbit"
scene clean claude
run 1 "Claude reviewing" --quiet 7
says "pr/claude: claude-review is in_progress on c0ffeec" "claude"

[ "$fails" -eq 0 ] || { echo "pr-quiet-self-test: $fails of $total checks failed ($BASH_VERSION)" >&2 && exit 1; }
echo "pr-quiet-self-test: $total checks passed ($BASH_VERSION)"
if [ -x /bin/bash ] && [ "$(command -v bash)" != /bin/bash ] && [ -z "${PR_QUIET_SECOND:-}" ]; then
	PR_QUIET_SECOND=1 /bin/bash "$root/scripts/pr-quiet-self-test"
fi

td.n{width:1%;min-width:44px;text-align:right;color:var(--mut);user-select:none;cursor:pointer}
td.n:hover{color:var(--acc)}tr.add td.c{background:var(--add)}tr.del td.c{background:var(--del)}
tr.hunk td{color:var(--mut);background:var(--bg)}tr.sel td{background:var(--sel)!important}
.thread{margin:6px 8px 8px 60px;border:1px solid var(--ln);border-radius:6px;background:var(--note);white-space:normal;word-break:normal}
.c1{padding:6px 10px;border-top:1px solid var(--ln)}.c1:first-child{border-top:0}
.c1 .who{font-size:12px;color:var(--mut)}.c1 .body{white-space:pre-wrap;margin-top:2px}
.c1.reply{padding-left:26px}.resolved{opacity:.6}

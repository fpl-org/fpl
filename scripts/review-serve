#!/usr/bin/env python3
"""scripts/review-serve — review Radicle patches in the browser, with the whole file in view.

    scripts/review --serve [--port <n>]     the usual way in
    scripts/review-serve [--port <n>] [--no-open]
    scripts/review-serve --self-test        run against a throwaway Radicle home

Serves a page on 127.0.0.1 that reads the repository's Radicle patches and nothing else,
laid out like a mailbox: the open patches down the left, a patch stacked on another indented
under it, and the chosen one on the right with every changed file whole and the comments at
the lines they are about. j and k move through the list; each move is an ordinary page
load, with no frames, so it works in any browser.

What you write on the page goes into the patch, signed with your Radicle key, as the
Radicle CLI would write it: a line comment or a comment on the whole revision goes into
your review of that revision, a reply goes into the thread it answers, and accept or
reject is the verdict of your review. A comment in a review can be marked resolved.
Comments imported from the forge (scripts/import-review) sit on the revision itself, where
Radicle has no resolve; they can be answered.

A patch that came from a pull request and sits at the bottom of its stack can be landed
from the page: your gh account approves it and rebase-merges it, as scripts/land would, but
only while the forge still has the commit you reviewed and its checks passed. The merge is
then recorded in Radicle, the patches stacked on it are replayed onto the new main and
pushed as the machine account, and the landed branch is deleted. Your checkout's main is
left alone.

The page is for one person on one machine: it binds to 127.0.0.1, and a write needs the
token that is in the address this prints, so another site open in the same browser cannot
post to it, let alone land something.

Needs rad (`scripts/layer on radicle`) and a repository that went through `rad init`, and
gh for landing (`scripts/layer on github`). The
commits of a patch must be in this clone; a patch pushed from here has them, one that
came in from elsewhere needs a `git fetch rad` first.
"""

import html
import http.server
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
import threading
import urllib.parse
import webbrowser

PATCH = "xyz.radicle.patch"
CONTEXT = int(os.environ.get("FPL_REVIEW_CONTEXT", "100000"))


class Refused(Exception):
    pass


def run(*cmd, ok=True):
    try:
        done = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        raise Refused(f"{cmd[0]} not found" + ("; scripts/layer on radicle" if cmd[0] == "rad" else ""))
    if ok and done.returncode != 0:
        raise Refused(f"{' '.join(cmd[:3])}: {(done.stderr or done.stdout).strip()}")
    return done


# Radicle.


class Repo:
    def __init__(self):
        self.rid = run("rad", ".", ok=False).stdout.strip()
        if not self.rid.startswith("rad:"):
            raise Refused("this is not a Radicle repository; run rad init first")
        self.me = run("rad", "self", "--did").stdout.strip().removeprefix("did:key:")

    def patches(self):
        out = run("rad", "cob", "list", "--repo", self.rid, "--type", PATCH).stdout.split()
        return {oid: self.show(oid) for oid in out}

    def show(self, oid):
        return json.loads(
            run("rad", "cob", "show", "--repo", self.rid, "--type", PATCH, "--object", oid).stdout
        )

    def act(self, oid, message, action):
        with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as f:
            f.write(json.dumps(action) + "\n")
        try:
            done = run("rad", "cob", "update", "--repo", self.rid, "--type", PATCH,
                       "--object", oid, "--message", message, f.name)
        finally:
            os.unlink(f.name)
        return done.stdout.strip().splitlines()[-1]

    def my_review(self, oid, revision):
        """My review of that revision, made empty if there is none yet: Radicle keeps one
        per signer, and a line comment has to live in one."""
        patch = self.show(oid)
        mine = patch["revisions"][revision]["reviews"].get(self.me)
        if mine:
            return mine["id"]
        return self.act(oid, "Review", {"type": "review", "revision": revision})


def short(did):
    key = did.removeprefix("did:key:")
    return f"{key[:8]}…{key[-4:]}"


def revisions(patch):
    return sorted(patch["revisions"].values(), key=lambda r: r["description"][0]["timestamp"])


def latest(patch):
    return revisions(patch)[-1]


def text_of(edits):
    return edits[-1]["body"] if edits else ""


def forge_number(patch):
    for r in patch["revisions"].values():
        m = re.search(r"GitHub-PR: \S+#(\d+)", text_of(r["description"]))
        if m:
            return m.group(1)
    return None


def graph(patches):
    """Open patches as a forest: a patch whose base is another open patch's head hangs
    under it."""
    open_ = {oid: p for oid, p in patches.items() if p["state"]["status"] == "open"}
    heads = {latest(p)["oid"]: oid for oid, p in open_.items()}
    parent = {oid: heads.get(latest(p)["base"]) for oid, p in open_.items()}
    children = {}
    for oid, up in parent.items():
        children.setdefault(up if up != oid else None, []).append(oid)
    for kids in children.values():
        kids.sort(key=lambda o: latest(open_[o])["description"][0]["timestamp"])
    return open_, children


# The diff.


def diff(base, head):
    """Files, each a list of rows (kind, old line, new line, text), whole."""
    for commit in (base, head):
        if run("git", "cat-file", "-e", f"{commit}^{{commit}}", ok=False).returncode:
            raise Refused(f"commit {commit[:7]} is not in this clone; git fetch rad, then reload")
    out = run("git", "diff", f"-U{CONTEXT}", "--find-renames", "--no-color", base, head).stdout
    files, rows, header, old, new = [], None, False, 0, 0
    for line in out.split("\n"):
        if line.startswith("diff --git "):
            rows, header = [], True
            files.append({"path": None, "old_path": None, "rows": rows, "binary": False})
        elif rows is None:
            continue
        elif line.startswith("@@"):
            header = False
            m = re.match(r"@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@", line)
            old, new = int(m.group(1)), int(m.group(2))
            rows.append(("hunk", None, None, line))
        elif not header:
            if line.startswith("+"):
                rows.append(("add", None, new, line[1:]))
                new += 1
            elif line.startswith("-"):
                rows.append(("del", old, None, line[1:]))
                old += 1
            elif line.startswith(" "):
                rows.append(("ctx", old, new, line[1:]))
                old += 1
                new += 1
        elif line.startswith("--- "):
            files[-1]["old_path"] = None if line == "--- /dev/null" else line[6:]
        elif line.startswith("+++ "):
            files[-1]["path"] = files[-1]["old_path"] if line == "+++ /dev/null" else line[6:]
        elif line.startswith("rename to "):
            files[-1]["path"] = line[len("rename to "):]
        elif line.startswith("rename from "):
            files[-1]["old_path"] = line[len("rename from "):]
        elif line.startswith("Binary files"):
            files[-1]["binary"] = True
            m = re.search(r" and (?:b/)?(.+) differ$", line)
            files[-1]["path"] = files[-1]["path"] or (m and m.group(1))
    for f in files:
        f["path"] = f["path"] or f["old_path"]
        # With the whole file as context there is one hunk, and its header says nothing.
        if sum(r[0] == "hunk" for r in f["rows"]) == 1:
            f["rows"] = [r for r in f["rows"] if r[0] != "hunk"]
    return files


# Comments.


IMPORTED = re.compile(r"^(\S+) on GitHub, ([^:]+:\d\d:\d\d UTC|[^:]+): (https://\S+)\n?\n?")


def comments_of(revision):
    """Every comment on a revision, from its own discussion and from each review, with
    where it lives, so a reply and a resolve go to the right place."""
    out = {}
    for cid, c in revision["discussion"]["comments"].items():
        out[cid] = dict(c, id=cid, review=None)
    for author, review in revision["reviews"].items():
        for cid, c in review["comments"]["comments"].items():
            out[cid] = dict(c, id=cid, review=review["id"])
    for c in out.values():
        c["parent"] = c.get("replyTo") or c.get("reply_to")
        c["at"] = c["edits"][0]["timestamp"] if c.get("edits") else 0
    return out


def root_of(c, all_):
    seen = set()
    while c.get("parent") in all_ and c["id"] not in seen:
        seen.add(c["id"])
        c = all_[c["parent"]]
    return c


def anchor(c, commit):
    """(path, side, last line) for a comment on this commit's code, else None."""
    loc = c.get("location")
    if not loc or loc.get("commit") != commit:
        return None
    for side in ("new", "old"):
        r = loc.get(side)
        if r and r.get("type") == "lines":
            return loc["path"], side, r["range"]["end"] - 1
        if r and r.get("type") == "chars":
            return loc["path"], side, r["line"]
    return loc["path"], "file", 0


# The page.



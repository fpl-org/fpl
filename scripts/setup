#!/usr/bin/env bash
#
# scripts/setup — make a clone or worktree ready for the FPL commit workflow.
#
# Idempotent. Run it once after `git clone`, and once inside every new worktree
# (`scripts/new-worktree` / `.claude/commands/new-worktree.md` call it for you).
#
# What it does:
#   1. Points git at the tracked hooks in .githooks/ (so commit-msg / pre-commit run).
#   2. Turns on the three settings the stacked-commit workflow in docs/WORKFLOW.md
#      relies on: --update-refs by default, rerere (remember conflict resolutions),
#      and scissors cleanup (so the commit-msg template can carry a help footer).
#   3. Reports whether the agent author identity (.git/agent-identity) is set;
#      see docs/COMMITS.md for why it exists and `scripts/agent-identity` to set it.
#
# It never writes anything outside `git config --local` and never commits.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "==> git config (local)"
git config --local core.hooksPath .githooks
git config --local rebase.updateRefs true
git config --local rerere.enabled true
git config --local rerere.autoUpdate true
git config --local commit.cleanup scissors
echo "    core.hooksPath      = $(git config --local core.hooksPath)"
echo "    rebase.updateRefs   = $(git config --local rebase.updateRefs)"
echo "    rerere.enabled      = $(git config --local rerere.enabled)"
echo "    commit.cleanup      = $(git config --local commit.cleanup)"

echo "==> agent author identity"
if id_email="$("$repo_root/scripts/agent-identity" show 2>/dev/null)"; then
	echo "    set: $id_email"
else
	cat <<-'EOF'
	    NOT SET. Agent commits via scripts/acommit will refuse until you run:

	        scripts/agent-identity set "<id>+psjg-claude@users.noreply.github.com"

	    (the noreply address of the GitHub machine account — see docs/COMMITS.md).
	    Human-only commits are unaffected.
	EOF
fi

echo "==> done"

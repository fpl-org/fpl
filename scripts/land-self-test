reviews "$(review 1 psjg APPROVED "$H"), $(review 2 psjg DISMISSED "$H")" read3
landing 1 "the approval is dismissed while the push goes" 7
says "LOUD: no code owner's approval of ${H:0:12} stands any more" "it says so loudly"
main_is "$H" "main moved all the same: this detects, it cannot undo"


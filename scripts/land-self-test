# The rules on the range, in both modes. ---------------------------------------------------
# range_case <head> <main> <exit> <text> <description>: a dry run of that head on that main.
range_case() {
	at="$1" HEAD_SHA="$1"
	forge
	git --git-dir="$REMOTE" update-ref refs/heads/main "$2"
	expect "$3" "$5" --dry-run 7
	says "$4" "$5: it says so"
	at="$H" HEAD_SHA="$H"
}
forge
expect 0 "the range rules on an ordinary head" --dry-run 7
says "ok  land/series             skipped: main has no scripts/series" "no series yet: a notice"
says "ok  land/card" "the card is there"
range_case "$HS" "$MS" 0 "every commit carries Series-Id s-1" "one Series-Id on a main with scripts/series"
range_case "$HN" "$MS" 1 "NO  land/series" "a commit without a Series-Id"
says "remedy: the presenter stamps one during the relocation or a re-presentation: scripts/series stamp ${MS:0:12}..HEAD on the branch, which mints the id; the stamp rewrites every commit, so the owner asks for it with changes requested and approves the new head again" \
	"it names the stamp, on the range's own base, and the owner's new approval"
range_case "$HS" "$MF" 1 "NO  land/series-fresh" "a Series-Id that is on main already"
range_case "$HP" "$MP" 1 "NO  land/patch-fresh" "a patch that is on main already"
range_case "$HW" "$M0" 1 "NO  land/workflows" "a commit that touches .github/workflows"
range_case "$HB" "$M0" 1 "11 commits, 0 lines: over 10" "eleven commits"
range_case "$HL" "$M0" 1 "1 commits, 601 lines: over" "601 lines"
range_case "$HO" "$ML" 1 "1 commits, 5 lines" "a head main moved two commits past its merge-base"
says "ok  land/size" "it counts the head's own lines, not main's 600 undone"
lacks "605 lines" "main's lines are not counted"
range_case "$HG" "$M0" 1 "NO  land/gpt" "a commit a GPT model assisted, no gpt-ok"
at="$HG" HEAD_SHA="$HG"
forge
reviews "$(review 1 psjg APPROVED "$HG" "read it. gpt-ok: ${HG:0:7}")"
expect 0 "a commit a GPT model assisted, with the owner's gpt-ok" --dry-run 7
at="$HGO" HEAD_SHA="$HGO"
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$MO"
reviews "$(review 1 psjg-claude APPROVED "$HGO" "gpt-ok: ${HGO:0:7}"), $(review 2 psjg APPROVED "$HGO" "fine")"
GH_TOKEN=t expect 1 "--ci, the author's gpt-ok is no owner's attestation" --ci --dry-run 7
says "NO  land/gpt" "it names the rule"
# After the push, --ci counts the approvals as land/author did before it: the author's alone
# is none. Both owners approve; the other's is dismissed while the push goes, the author's
# stands. In --ci the reviews are read once before the push, so the second read is after it.
both="$(review 1 psjg-claude APPROVED "$HGO"), $(review 2 psjg APPROVED "$HGO" "gpt-ok: ${HGO:0:7}")"
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$MO"
reviews "$both"
reviews "$(review 1 psjg-claude APPROVED "$HGO"), $(review 2 psjg DISMISSED "$HGO")" read2
GH_TOKEN=t expect 1 "--ci, the other owner's approval is dismissed while the push goes" --ci 7
says "LOUD: no code owner's approval of ${HGO:0:12} stands any more (the author @psjg-claude's does not count)" \
	"the author's approval left standing does not hide it"
main_is "$HGO" "main moved all the same: this detects, it cannot undo"
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$MO"
reviews "$both"
GH_TOKEN=t expect 0 "--ci, both owners' approvals stand after the push" --ci 7
lacks "LOUD" "the other owner's approval counts after the push as before it"
# Two commits a GPT model assisted whose SHAs share their first 7 digits, siblings on M0, and
# HV, a merge of both. Python hashes commit objects of fixed text, a counter in the message,
# until two prefixes meet (about 20 000 tries by the birthday bound, well under a second);
# git then writes those two texts, so the SHAs are the ones hashed.
python3 - "$(git -C "$repo" rev-parse "$M0^{tree}")" "$M0" "$tmp/v" <<'PY'
import hashlib
import sys

tree, parent, out = sys.argv[1:]
seen, i = {}, 0
while True:
    text = (f"tree {tree}\nparent {parent}\nauthor t <t@example.invalid> 0 +0000\n"
            f"committer t <t@example.invalid> 0 +0000\n\nassisted {i}\n\n"
            "Assisted-By: gpt-6.1-sol\n").encode()
    sha = hashlib.sha1(b"commit %d\0" % len(text) + text).hexdigest()
    if sha[:7] in seen:
        break
    seen[sha[:7]] = text
    i += 1
open(out + "1", "wb").write(seen[sha[:7]])
open(out + "2", "wb").write(text)
PY
V1="$(git -C "$repo" hash-object -t commit -w "$tmp/v1")"
V2="$(git -C "$repo" hash-object -t commit -w "$tmp/v2")"
HV="$(git -C "$repo" commit-tree "$M0^{tree}" -p "$V1" -p "$V2" -m "both")"
git -C "$repo" push -q "$REMOTE" "$HV:refs/heads/hv"
total=$((total + 1))
if [ "${V1:0:7}" != "${V2:0:7}" ] || [ "$V1" = "$V2" ]; then
	fails=$((fails + 1))
	echo "self-test: the two commits do not share a prefix: $V1 $V2" >&2
fi
at="$HV" HEAD_SHA="$HV"
forge
reviews "$(review 1 psjg APPROVED "$HV" "gpt-ok: ${V1:0:7}")"
expect 1 "one gpt-ok whose prefix two assisted commits share" --dry-run 7
says "NO  land/gpt" "it attests neither"
says "gpt-ok ${V1:0:7} matches more than one commit" "it names the prefix"
forge
reviews "$(review 1 psjg APPROVED "$HV" "gpt-ok: $V1 gpt-ok: $V2")"
expect 1 "a gpt-ok for each, in full (the merge between them is refused)" --dry-run 7
says "ok  land/gpt" "each names one commit"
at="$H" HEAD_SHA="$H"
forge
pull open false main @MERGED@ '## What\n## What changes\n## How checked\n## Limits'
expect 1 "a body without the card's Verdict" --dry-run 7
says "the body has no heading Verdict" "it names the heading"

# The by-hand route: a dry run is the rule table and the lines a person types. ----------------
# The rules the header names are the rules the table holds, each with a line of its own
# whether it was judged or not, and the count says how many of each.
rules_of_header="$(grep -oE '^#   land/[a-z-]+' "$land" | sed 's/^#   //' | sort -u)"
nrules="$(printf '%s\n' "$rules_of_header" | wc -l | tr -d ' ')"
# table <description>: the last output holds a verdict line for each rule of the header, and
# for no other.
table() {
	local rule
	for rule in $rules_of_header; do
		total=$((total + 1))
		grep -qE "^ +(ok|NO|--) +$rule " "$tmp/out" && continue
		fails=$((fails + 1))
		echo "self-test: $1: the table has no line for $rule" >&2
	done
	total=$((total + 1))
	grep -oE '^ +(ok|NO|--) +land/[a-z-]+' "$tmp/out" | awk '{print $2}' | sort -u >"$tmp/named"
	printf '%s\n' "$rules_of_header" | cmp -s - "$tmp/named" && return
	fails=$((fails + 1))
	echo "self-test: $1: the table names rules the header does not, or the other way round" >&2
}
forge
expect 0 "the whole table, without a terminal" --dry-run 7
table "a clean dry run"
says "land: $nrules rules: $nrules ok, 0 NO, 0 not judged" "the count"
lacks "needs a terminal" "a dry run asks for no terminal"
lacks "github-fpl-deploy" "the owner's route is for a workflow alone"
says "would run: git push https://github.com/land-test/fpl.git $H:refs/heads/main" \
	"the push it would make"
says "then check that main is the head: git ls-remote https://github.com/land-test/fpl.git refs/heads/main" \
	"and how to see that it landed"

forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$MC"

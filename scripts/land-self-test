statuses "[$(status 2 ci success), $(status 1 ci failure)]"
expect 0 "the newest status of a context succeeded, an older one failed" --dry-run 7
statuses "[$(status 3 other success)], [$(status 2 ci failure)]"
expect 1 "the failing status is on the second page" --dry-run 7
says "concluded failure" "every page of statuses is read"


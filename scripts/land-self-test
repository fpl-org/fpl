# Whatever comes out LOUD after the push, the head is on main: what is stacked on it is
# listed for its new base first.
# first <text> <then> <description>: the last output holds both, the first before the other.
first() {
	total=$((total + 1))
	awk -v a="$1" -v b="$2" 'index($0, a) && !x { x = NR } index($0, b) && !y { y = NR }
		END { exit !(x && y && x < y) }' "$tmp/out" && return
	fails=$((fails + 1))
	echo "self-test: $3: the output lacks '$1' before '$2'" >&2
	sed 's/^/    /' "$tmp/out" >&2
}
forge
reviews "$(review 1 psjg APPROVED "$H"), $(review 2 psjg DISMISSED "$H")" read3
children '{"number": 8}'
landing 1 "the approval is dismissed while the push goes, with a pull request stacked on it" 7
says "LOUD: no code owner's approval" "it says so loudly"
first "pulls/8 -f base=main" "LOUD" "the retarget comes before the LOUD lines"
forge
pull open false main false
children '{"number": 8}'
landing 1 "GitHub does not show the merge, with a pull request stacked on it" 7
first "pulls/8 -f base=main" "LOUD: main is $H, but GitHub does not show #7 as merged" \
	"the retarget comes before the LOUD exit"
forge
mkdir -p "$tmp/elsewhere"
printf '#!/bin/sh
[ "$1" != ls-remote ] || { echo "%s	refs/heads/main"; exit 0; }
exec %s "$@"
' \
	"$M1" "$(command -v git)" >"$tmp/elsewhere/git"
chmod +x "$tmp/elsewhere/git"
children '{"number": 8}'
PATH="$tmp/elsewhere:$PATH" landing 1 "main is not the head right after the push, with a pull request stacked on it" 7
first "pulls/8 -f base=main" "LOUD: main on the forge is $M1" "the retarget comes before the LOUD exit"


# land/remote: the push goes where the fetch comes from, the repository read on the forge.
# Each case sets one thing in the clone's config and takes it away again.
remote_case() { # remote_case <description> <git config arguments...>
	local what="$1"
	shift
	forge
	git config "$@"
	expect 1 "$what" --dry-run 7
	says "land/remote" "it names the rule"
	says "remedy:" "it says what to do"
	lacks "would run: git push" "nothing is judged against a remote that pushes elsewhere"
}
remote_case "a pushurl to another repository" remote.github.pushurl https://github.com/other/fpl.git
git config --unset-all remote.github.pushurl
says "pushes to $OTHER" "it names where the push would go"
forge
git config remote.github.pushurl https://github.com/land-test/fpl.git
expect 0 "a pushurl to the same repository" --dry-run 7
remote_case "a second push URL" --add remote.github.pushurl https://github.com/other/fpl.git
says "more than one URL" "it says why"
git config --unset-all remote.github.pushurl
remote_case "a pushInsteadOf that rewrites the push" \
	url.https://github.com/other/.pushInsteadOf https://github.com/land-test/
git config --unset-all url.https://github.com/other/.pushInsteadOf
# ssh to a host that is not there: nothing reaches the network, even before the fix.
remote_case "an insteadOf that sends fetch and push to another GitHub repository" \
	url.git@github.com-nowhere:other/fpl.git.insteadOf https://github.com/land-test/fpl.git
says "git goes to other/fpl" "it names the repository git goes to"
git config --unset-all url.git@github.com-nowhere:other/fpl.git.insteadOf
remote_case "a remote named by the URL itself, which git uses for that URL" \
	remote.https://github.com/land-test/fpl.git.pushurl https://github.com/other/fpl.git
says "configures a remote named by that URL" "it names the section"
git config --remove-section remote.https://github.com/land-test/fpl.git
# The push names the URL checked; git rewrites that URL too, by the insteadOf that matches
# it rather than the remote's: here git@github.com:land-test/fpl.git, the URL git goes to.
forge
git config url.git@github.com:land-test/.insteadOf https://github.com/land-test/
expect 0 "an insteadOf to the same repository over ssh" --dry-run 7
says "would run: git push git@github.com:land-test/fpl.git $H:refs/heads/main" \
	"it pushes to the URL git goes to"
git config url."$OTHER".insteadOf git@github.com:land-test/fpl.git
expect 1 "an insteadOf that rewrites the URL checked, not the remote's" --dry-run 7
says "land/remote" "it names the rule"
says "rewrites it" "it says why"
lacks "would run: git push" "nothing is judged"
git config --unset-all url."$OTHER".insteadOf
git config --unset-all url.git@github.com:land-test/.insteadOf
# A rewrite off GitHub is refused, not taken for a mirror that the check after the push
# would catch: by then main there has moved, under rules nobody read.
forge
mirror
git config url."$MIRROR".insteadOf https://github.com/land-test/fpl.git
expect 1 "an insteadOf that sends fetch and push off GitHub" --dry-run 7
says "land/remote" "it names the rule"
says "git goes to $MIRROR, not GitHub" "it says where git goes"
lacks "would run: git push" "nothing is judged against a repository off GitHub"
landing 1 "a landing whose remote git sends off GitHub" 7
git config --unset-all url."$MIRROR".insteadOf
untouched "$MIRROR" "nothing was pushed off GitHub"
main_is "$M0" "nothing landed"
# A GitHub repository's URL is one of GitHub's three spellings; over ssh, and only there,
# the host may be an alias, github.com-<alias>, which the ssh config resolves.
for url in ssh://git@github.com/land-test/fpl.git git@github.com:land-test/fpl \
	git@github.com-work:land-test/fpl.git ssh://git@github.com-work/land-test/fpl.git \
	git@github.com-work_2-b:land-test/fpl.git ssh://git@github.com-0/land-test/fpl.git \
	https://github.com/land-test/fpl; do
	forge
	git config remote.github.url "$url"
	expect 0 "the remote is $url" --dry-run 7
	says "would run: git push $url $H:refs/heads/main" "it pushes to $url"
done
for url in https://github.com-evil.example/land-test/fpl.git file://github.com/land-test/fpl.git \
	github.com/land-test/fpl.git ./github.com/land-test/fpl.git http://github.com/land-test/fpl.git \
	git://github.com/land-test/fpl.git https://www.github.com/land-test/fpl.git \
	https://someone@github.com/land-test/fpl.git ssh://someone@github.com/land-test/fpl.git \
	ssh://git@github.com:22/land-test/fpl.git github.com:land-test/fpl.git \
	https://github.com/land-test/fpl.git/extra https://github.com/land-test/.. \
	ssh://git@github.com-evil.example/land-test/fpl.git git@github.com-evil.example:land-test/fpl.git \
	ssh://git@github.com./land-test/fpl.git git@github.com.:land-test/fpl.git \
	ssh://git@github.com-a.b/land-test/fpl.git git@github.com-:land-test/fpl.git; do
	forge
	git config remote.github.url "$url"
	expect 1 "the remote is $url" --dry-run 7
	says "land/remote: remote 'github' is $url, not a GitHub repository's URL" "it names the rule"
	lacks "would run: git push" "nothing is judged"
	called
	lacks "gh api" "the forge is not read for $url"
done
git config remote.github.url https://github.com/land-test/fpl.git
# The review's case: an insteadOf to a host that merely begins with github.com.
remote_case "an insteadOf to a host named github.com-<something>, over https" \
	url.https://github.com-evil.example/.insteadOf https://github.com/
says "git goes to https://github.com-evil.example/land-test/fpl.git, not GitHub" "it says where git goes"
git config --unset-all url.https://github.com-evil.example/.insteadOf
# The same over ssh, the second review's case: an alias with a dot is a DNS name, and git
# goes there when an insteadOf says so, though slug() once took it for an ssh config Host.
git config remote.github.url git@github.com:land-test/fpl.git
remote_case "an insteadOf to a host named github.com-<something>.<tld>, scp-style" \
	url.git@github.com-evil.example:.insteadOf git@github.com:
says "git goes to git@github.com-evil.example:land-test/fpl.git, not GitHub" "it says where git goes"
git config --unset-all url.git@github.com-evil.example:.insteadOf
git config remote.github.url ssh://git@github.com/land-test/fpl.git
remote_case "an insteadOf to a host named github.com-<something>.<tld>, over ssh://" \
	url.ssh://git@github.com-evil.example/.insteadOf ssh://git@github.com/
says "git goes to ssh://git@github.com-evil.example/land-test/fpl.git, not GitHub" "it says where git goes"
git config --unset-all url.ssh://git@github.com-evil.example/.insteadOf
git config remote.github.url https://github.com/land-test/fpl.git
forge
expect 0 "the remote as it should be, after each case" --dry-run 7

forge
git config remote.github.pushurl https://github.com/other/fpl.git
landing 1 "a landing whose remote pushes to another repository" 7
git config --unset-all remote.github.pushurl
total=$((total + 1))
if git --git-dir="$OTHER" rev-parse -q --verify refs/heads/main >/dev/null; then
	fails=$((fails + 1))
	echo "self-test: a landing whose remote pushes elsewhere: it pushed there" >&2
fi
main_is "$M0" "nothing landed"

# Where git goes is checked again right before the push, and the push names the URL it
# checked: a remote changed while the diff is open does not take the push elsewhere.
rewire_case() { # rewire_case <description> <git config arguments...>
	local what="$1"
	shift
	forge
	mirror
	mkdir -p "$tmp/rewire"
	printf '#!/bin/sh\ngit config'" %s"'\n' "$*" >"$tmp/rewire/open"
	chmod +x "$tmp/rewire/open"
	PATH="$tmp/rewire:$PATH" landing 1 "$what" 7
	says "land/remote" "it names the rule"
	untouched "$OTHER" "nothing was pushed to another repository"
	untouched "$MIRROR" "nothing was pushed off GitHub"
	main_is "$M0" "nothing landed"
}
rewire_case "a pushurl to another repository, set while the diff is open" \
	remote.github.pushurl https://github.com/other/fpl.git
git config --unset-all remote.github.pushurl
rewire_case "an insteadOf off GitHub, set while the diff is open" \
	url."$MIRROR".insteadOf https://github.com/land-test/fpl.git
git config --unset-all url."$MIRROR".insteadOf
# A pushurl set after that last check, as git starts: the push names the URL, not the remote.
forge
mkdir -p "$tmp/late"
printf '#!/bin/sh\n[ "$1" != push ] || %s config remote.github.pushurl https://github.com/other/fpl.git\nexec %s "$@"\n' \
	"$(command -v git)" "$(command -v git)" >"$tmp/late/git"
chmod +x "$tmp/late/git"
PATH="$tmp/late:$PATH" landing 0 "a pushurl set as the push starts" 7
git config --unset-all remote.github.pushurl
untouched "$OTHER" "the push did not go through the remote's name"
main_is "$H" "it went to the URL checked"


# A parameter of a judged rule that asks what scripts/land does not make is refused.
lint='{"context": "commit-lint", "integration_id": 15368}'
param_case() { # param_case <description> <exit code> <text> <rules arguments after the first...>
	local what="$1" want="$2" text="$3"
	shift 3
	forge
	rules "$lint" "$@"
	expect "$want" "$what" --dry-run 7
	if [ "$want" -eq 1 ]; then
		says "NO  land/rules" "it names the rule"
		says "$text" "it names the parameter"
	else
		says "ok  land/rules" "$text"
	fi
}
param_case "the last push approved by someone else" 1 "require_last_push_approval: true" \
	1 "" '"require_last_push_approval": true'
param_case "a team required for some paths" 1 "pull_request required_reviewers" \
	1 "" '"required_reviewers": [{"file_patterns": ["*"], "minimum_approvals": 1, "reviewer": {"id": 1, "type": "Team"}}]'
param_case "a parameter not known here, enabled" 1 "pull_request require_x: true" \
	1 "" '"require_x": true'
param_case "a parameter not known here, false" 0 "a parameter that is false asks nothing" \
	1 "" '"require_x": false'

# require_extra_approval_for_unattributed_changes: one approval more of a pull request no
# user account opened (GitHub's docs: Copilot under its own App identity). The live ruleset
# on main sets it, so a user account's pull request must land, and an App's must not.
unattributed='"require_extra_approval_for_unattributed_changes": true'
param_case "the extra approval for unattributed changes, a user account opened it" 0 \
	"land/rules" 1 "" "$unattributed"
says "ok  land/attributed" "it judges who opened it"
for kind in Bot ""; do
	OPENER=Copilot OPENER_TYPE="$kind" forge
	rules "$lint" 1 "" "$unattributed"
	expect 1 "the extra approval for unattributed changes, opened by type '$kind'" --dry-run 7
	says "NO  land/attributed" "it names the rule"
	says "GitHub wants 2 approvals of it, scripts/land counts 1" "it says why one is not enough"
	says "ok  land/rules" "the parameter itself is judged"
done
OPENER=Copilot OPENER_TYPE=Bot param_case \
	"the extra approval for unattributed changes, at zero approvals" 0 "land/rules" \
	0 "" "$unattributed"
says "ok  land/attributed" "a rule that asks no approval asks none more"
OPENER=Copilot OPENER_TYPE=Bot param_case "no rule asks the extra approval, an App opened it" \
	0 "land/rules" 1 "" '"require_extra_approval_for_unattributed_changes": false'
param_case "the extra approval for unattributed changes, not a bool" 1 \
	"require_extra_approval_for_unattributed_changes: \"yes\"" \
	1 "" '"require_extra_approval_for_unattributed_changes": "yes"'
param_case "a parameter on a rule that has none" 1 "deletion x: 1" \
	1 '{"type": "deletion", "ruleset_id": 2, "parameters": {"x": 1}}'
param_case "the branch up to date before merging" 0 "land/ancestor makes it" \
	1 '{"type": "required_status_checks", "ruleset_id": 2, "parameters": {"required_status_checks": [], "strict_required_status_checks_policy": true}}'
param_case "zero approvals, no code owner review, no thread resolution" 0 "the script is stricter" \
	0 "" '"require_code_owner_review": false, "required_review_thread_resolution": false'

# An answer that says nothing is not "nothing required": it fails closed, by name.
for empty in '[[]]' '{}' '[]' '[[{}]]' '[["x"]]'; do

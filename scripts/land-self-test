GH_TOKEN=t expect 0 "--ci, the branch moved past the head that landed" --ci 7
main_is "$H" "it lands all the same"
says "kept $BR" "it keeps the branch and says so"
lacks "deleted $BR" "it deletes nothing"
at="$HS" HEAD_SHA="$HS"
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$MS"
GH_TOKEN=t expect 0 "--ci lands a series" --ci 7
called
says "-f name=fpl/series -f head_sha=$HS" "it writes the receipt on the head"
says "series d1g3st" "with the digest scripts/series gives"
at="$H" HEAD_SHA="$H"

# Relocation. Siblings on M0: SA adds a, SB adds b, SC sits on SB and adds c, SX adds an a
# of its own. SA lands first, so main is SA and SB is no longer above it.
git switch -q -c sibs "$M0"
echo a >a && git add a && git commit -q -m "add a"
SA="$(git rev-parse HEAD)"
git reset -q --hard "$M0"
echo b >b && git add b && git commit -q -m "add b"
SB="$(git rev-parse HEAD)"
echo c >c && git add c && git commit -q -m "add c"
SC="$(git rev-parse HEAD)"
git reset -q --hard "$M0"
echo x >a && git add a && git commit -q -m "add a, otherwise"
SX="$(git rev-parse HEAD)"
git switch -q main
git branch -q -D sibs
# DM adds f, seven lines; DA changes its first line, DB its fourth: they merge cleanly, but
# DB's diff has DA's line as context, so its relocation has another patch id.
git switch -q -c sibs "$M0"
seq 7 >f && git add f && git commit -q -m "add f"
DM="$(git rev-parse HEAD)"
sed 's/^1$/one/' f >f.new && mv f.new f && git commit -q -am "f: one"
DA="$(git rev-parse HEAD)"
git reset -q --hard "$DM"
sed 's/^4$/four/' f >f.new && mv f.new f && git commit -q -am "f: four"
DB="$(git rev-parse HEAD)"
git switch -q main
git branch -q -D sibs
git push -q "$REMOTE" "$SA:refs/heads/sa" "$SB:refs/heads/sb" "$SX:refs/heads/sx" \
	"$DA:refs/heads/da" "$DB:refs/heads/db" "$SC:refs/heads/sc"
line() { # line <text> <description>: a line of the last output is exactly the text
	total=$((total + 1))
	grep -qxF -- "$1" "$tmp/out" && return
	fails=$((fails + 1))
	echo "self-test: $2: no line '$1'" >&2
	sed 's/^/    /' "$tmp/out" >&2
}
FPL_LAND_QUICK='test -f a && test -f b' expect 0 "--verify relocates SB onto SA" --verify "$SA" "$SB"
SY="$(sed -n 's/^y=//p' "$tmp/out")"
says "pick $SB $SY" "it maps the old commit to the new"
total=$((total + 1))
if [ "$(git rev-parse "$SY^")" != "$SA" ] || ! git cat-file -e "$SY:b" ||
	[ "$(git log -1 --format='%an %ae %ad %cn %ce %cd %B' "$SY")" != \
		"$(git log -1 --format='%an %ae %ad %cn %ce %cd %B' "$SB")" ]; then
	fails=$((fails + 1))
	echo "self-test: SB's pick $SY is not SB's change, author, committer and message on SA" >&2
fi
FPL_LAND_QUICK=true expect 0 "--verify again" --verify "$SA" "$SB"
line "y=$SY" "the same main and head derive the same commits"
FPL_LAND_QUICK=false expect 1 "--verify, the check fails on a pick" --verify "$SA" "$SB"
says "'false' fails on $SY, the pick of $SB" "it names the pick and the commit it relocates"
FPL_LAND_QUICK=true expect 0 "--verify, a pick that conflicts" --verify "$SA" "$SX"
line "conflict $SX a" "it names the commit and the file"
line "y=" "and derives nothing"
FPL_LAND_QUICK=true expect 0 "--verify, a child of the relocated SB" --verify "$SY" "$SC"
line "drop $SB" "main holds SB's pair: the child's range starts above it"
says "pick $SC " "the child's own commit is picked"
# RP and RQ make the same change, x to y, at two places of r with the same context: one pair.
# Main holds RP's pick once (on RZ); RQ is no commit of main's and must not be dropped.
git switch -q -c twins "$M0"
{ seq 3 | sed 's/.*/k/'; echo x; seq 7 | sed 's/.*/k/'; echo x; seq 3 | sed 's/.*/k/'; } >r
git add r && git commit -q -m "add r" && RB="$(git rev-parse HEAD)"
sed '4s/x/y/' r >r.new && mv r.new r && git commit -q -am "x to y" && RP="$(git rev-parse HEAD)"
sed '12s/x/y/' r >r.new && mv r.new r && git commit -q -am "x to y" && RQ="$(git rev-parse HEAD)"
git reset -q --hard "$RB" && echo z >z && git add z && git commit -q -m "add z" && git cherry-pick "$RP" >/dev/null
RM="$(git rev-parse HEAD)"
git switch -q main && git branch -q -D twins
FPL_LAND_QUICK=true expect 0 "--verify, two commits with one pair, main holding one" --verify "$RM" "$RQ"
line "drop $RP" "the one main holds is dropped"
says "pick $RQ " "the other is picked: a commit on main answers for one commit, once"

# Two siblings as pull request #7, one after the other: SA lands; then SB, approved on SB,
# is relocated onto SA and lands as SY without a new approval.
at="$SA" HEAD_SHA="$SA"
forge
git --git-dir="$REMOTE" update-ref "refs/heads/$BR" "$SA"
GH_TOKEN=t expect 0 "--ci, sibling SA lands" --ci 7
main_is "$SA" "SA fast-forwards main"
at="$SB" HEAD_SHA="$SB"
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$SA"
git --git-dir="$REMOTE" update-ref "refs/heads/$BR" "$SB"
GH_TOKEN=t expect 1 "--ci, sibling SB without --relocate" --ci --dry-run 7
says "NO  land/ancestor" "a stale head is refused as before"
GH_TOKEN=t expect 1 "--ci, SB with a Y --verify did not derive" --ci --dry-run --relocate "$SA" 7
says "NO  relocate/trees" "it names the rule"
expect 1 "--relocate without --ci" --dry-run --relocate "$SY" 7
HEAD_SHA="$SY" GH_TOKEN=t expect 0 "--ci, SB relocates onto SA and lands on the approval of SB" \
	--ci --relocate "$SY" 7
for rule in relocate/clean relocate/trees relocate/ids land/ancestor land/approved; do
	says "ok  $rule" "relocated: $rule holds"
done
says "land: $((nrules + 4)) rules: $((nrules + 4)) ok, 0 NO, 0 not judged" \
	"its table holds the relocate/ rules judge() reaches as well"
says "- $SB -> $SY" "it prints the old-to-new map"
main_is "$SY" "main is the relocation"
total=$((total + 1))
[ "$(git --git-dir="$REMOTE" rev-parse -q --verify "refs/heads/$BR")" = "" ] ||
	{ fails=$((fails + 1)); echo "self-test: the relocated branch was not deleted" >&2; }
called
first "-X POST repos/land-test/fpl/issues/7/comments" "--force-with-lease=refs/heads/$BR:$SY :refs/heads/$BR" \
	"the map is posted before the branch goes"
first "--force-with-lease=refs/heads/$BR:$SB $SY:refs/heads/$BR" "-X POST repos/land-test/fpl/issues/7/comments" \
	"the reviewed head becomes the relocation under a lease, after main"
lacks "pulls/7/reviews -f" "nobody approved anything again"
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$SA"
git --git-dir="$REMOTE" update-ref "refs/heads/$BR" "$SB"
reviews "$(review 1 psjg APPROVED "$SB")"
reviews "$(review 1 psjg DISMISSED "$SB")" read2
HEAD_SHA="$SY" GH_TOKEN=t expect 1 "--ci, the approval is dismissed while main moves" --ci --relocate "$SY" 7
says "LOUD: main is $SY, but what it was landed on changed; $BR stays $SB" "it leaves the head"
total=$((total + 1))
[ "$(git --git-dir="$REMOTE" rev-parse "refs/heads/$BR")" = "$SB" ] ||
	{ fails=$((fails + 1)); echo "self-test: the head moved without a standing approval" >&2; }
# A relocation the owner has not read goes to him, never over the reviewed head.
FPL_LAND_QUICK=true "$land" --verify "$DA" "$DB" >"$tmp/out" 2>&1
DY="$(sed -n 's/^y=//p' "$tmp/out")"
at="$DB" HEAD_SHA="$DB"
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$DA"
git --git-dir="$REMOTE" update-ref "refs/heads/$BR" "$DB"
GH_TOKEN=t expect 1 "--ci, DB's relocation changes its patch id" --ci --relocate "$DY" 7
says "NO  relocate/ids" "it names the rule"
says "is $BR-relocated ($DY)" "it names the candidate"
says "f: four" "the range-diff of the changed commit is in the comment"
main_is "$DA" "main stays"
total=$((total + 1))
[ "$(git --git-dir="$REMOTE" rev-parse "refs/heads/$BR")" = "$DB" ] &&
	[ "$(git --git-dir="$REMOTE" rev-parse "refs/heads/$BR-relocated")" = "$DY" ] ||
	{ fails=$((fails + 1)); echo "self-test: the head moved, or the candidate is not $DY" >&2; }
called
first "-X POST repos/land-test/fpl/issues/7/comments" "-X POST repos/land-test/fpl/pulls/7/requested_reviewers" \
	"the owner is asked once the comment is up"
BR=agent/x/stack/twin/tip
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$DA"
git --git-dir="$REMOTE" update-ref "refs/heads/$BR" "$DB"
GH_TOKEN=t expect 1 "--ci, the same from a stack's tip" --ci --relocate "$DY" 7
says "is agent/x/stack/twin-relocated/tip ($DY)" "the candidate's name keeps the part last, as branch-lint wants"
BR=agent/x/stack/feat
at="$SX" HEAD_SHA="$SX"
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$SA"
GH_TOKEN=t expect 1 "--ci, a relocation that conflicts" --ci --relocate "" 7
says "NO  relocate/clean" "it names the rule"
says "--  relocate/trees          not judged: an earlier rule stopped the judgement" \
	"what a conflict leaves unjudged has a line too"
says "conflicts: $SX a." "it names the commit and the file"
called
says "pulls/7/requested_reviewers" "the owner is asked to review again"
lacks "-relocated" "a conflict publishes no candidate"
forge
git --git-dir="$REMOTE" update-ref refs/heads/main "$SA"
reviews "$(review 1 psjg COMMENTED "$SX")"
GH_TOKEN=t expect 1 "--ci, a conflict and no approval" --ci --relocate "" 7
called
lacks "issues/7/comments" "with another refusal, nothing is put to the owner"
at="$H" HEAD_SHA="$H"
# Main is SY, SB relocated onto SA (it landed above). SC, the child of SB, holds SB and its
# own commit: the range judged starts above SB, whose pair main holds, as the relocation
# does. SB alone holds nothing main lacks.
range_case "$SC" "$SY" 1 "ok  land/patch-fresh" "a child of a relocated parent, on its own commit"
says "1 commits, 1 lines" "land/size counts the child's own commit alone"
range_case "$SB" "$SY" 1 "NO  land/patch-fresh" "a head whose every pair main holds"
says "main holds every commit of the head, or its pair, already" "it says so"

# The install line in harness/workflows/README.md makes a commit the owner's hooks accept: its
# message, the -m arguments of its git commit joined as git joins them, passes
# .githooks/commit-msg in a checkout of the harness on a detached HEAD, where the owner makes
# it. The same message without its Human-Only line is refused, so the check can fail. The
# checkout is a new repository under $tmp: GIT_DIR and its kin were unset at the top, so git
# init makes it there and nowhere else.
install_msg() { # install_msg [a paragraph to leave out]
	python3 - "$root/harness/workflows/README.md" "${1:-}" <<'PY'
import shlex
import sys

line = next(x for x in open(sys.argv[1]) if x.startswith("    git checkout --detach"))
words = shlex.split(line)
i, paragraphs = words.index("commit"), []
while i < len(words) and words[i] != "&&":
    if words[i] == "-m":
        paragraphs.append(words[i + 1])
    i += 1
print("\n\n".join(p for p in paragraphs if p != sys.argv[2]))
PY
}
hooked="$tmp/hooked"
git init -q -b main "$hooked"
cp -R "$root/.githooks" "$root/scripts" "$hooked/"
(cd "$hooked" && git commit -q --allow-empty --no-verify -m base && git checkout -q --detach)
install_msg >"$tmp/install-msg"
rc=0
(cd "$hooked" && .githooks/commit-msg "$tmp/install-msg") >"$tmp/out" 2>&1 || rc=$?
total=$((total + 1))
verdict 0 "$rc" "the README's install commit passes commit-msg on a detached HEAD"
install_msg "Human-Only: true" >"$tmp/install-msg"
rc=0
(cd "$hooked" && .githooks/commit-msg "$tmp/install-msg") >"$tmp/out" 2>&1 || rc=$?
total=$((total + 1))
verdict 1 "$rc" "the install commit without Human-Only: true is refused"
says "commit-msg [provenance-assisted]" "it names the gate"

# The header's land/rules entry says two things, which it keeps in sentences of their own: the
# requirements scripts/land does not make (which the bypass would leave unenforced), and the
# schema the forge's answer must have. The entry must say both, and no sentence may hold both.
total=$((total + 1))
if ! python3 - "$land" <<'PY'
import re
import sys

header = []
for line in open(sys.argv[1]).read().splitlines()[1:]:
    if not line.startswith("#"):
        break
    header.append(line[1:].strip())
text = " ".join(header)
entry = re.search(r"land/rules (.*?) land/bypass ", text).group(1)
sentences = re.split(r"\.\s+", entry)
for word in ("unenforced", "schema"):
    if not any(word in s for s in sentences):
        print("the entry never says " + word, file=sys.stderr)
        sys.exit(1)
bad = [s for s in sentences if "unenforced" in s and "schema" in s]
if bad:
    print("one sentence holds both: " + bad[0], file=sys.stderr)
    sys.exit(1)
PY
then
	fails=$((fails + 1))
	echo "self-test: the header's land/rules entry runs two conditions into one sentence" >&2
fi

# Every gh command scripts/land printed in any case above, the remedies a person runs
# included, names exactly github.com: whoever runs one may have a GH_HOST of another host. A
# line passes when every --hostname value is github.com, every --repo (or -R) value is
# github.com/<owner>/<name>, and it names the host at least once per gh command it holds; a
# look-alike such as github.com.evil is neither. The program is plain awk, which the BSD awk
# and bash 3.2 of macOS read as well as bash 5 does.
sweep='
function bare(v) { sub(/[).,;:"`\047]+$/, "", v); return v }
{
	g = gsub(/gh (api|pr|run|auth) /, "&"); ok = 0; bad = 0
	for (i = 1; i <= NF; i++) {
		if ($i == "--hostname") v = bare($(i + 1))
		else if (substr($i, 1, 11) == "--hostname=") v = bare(substr($i, 12))
		else v = ""
		if ($i == "--hostname" || v != "") { if (v == "github.com") ok++; else bad++ }
		if ($i == "--repo" || $i == "-R") r = bare($(i + 1))
		else if (substr($i, 1, 7) == "--repo=") r = bare(substr($i, 8))
		else r = ""
		if ($i == "--repo" || $i == "-R" || r != "") {
			if (r ~ /^github\.com\/[^\/]+\/[^\/]+$/) ok++; else bad++
		}
	}
	if (g > ok || (g > 0 && bad > 0)) print
}'
total=$((total + 1))
if awk "$sweep" "$tmp/outputs" | grep -q .; then
	fails=$((fails + 1))
	echo "self-test: a gh command it printed does not name exactly github.com:" >&2
	awk "$sweep" "$tmp/outputs" | sort -u | sed 's/^/    /' >&2
fi

# The sweep itself: a look-alike host planted in a copy of the outputs, in either flag, is
# caught, and so is a command naming no host; the real outputs pass, as the check above says.
total=$((total + 1))
planted="$tmp/planted"
for line in 'gh api --hostname github.com.evil repos/o/r' \
	'gh pr ready 7 --repo github.com.evil/o/r' \
	'gh pr ready 7 --repo github.com/o' \
	'gh api --hostname github.com --repo=other/r repos/o/r' \
	'gh pr ready 7'; do
	{ cat "$tmp/outputs"; echo "$line"; } >"$planted"
	if ! awk "$sweep" "$planted" | grep -qxF "$line"; then
		fails=$((fails + 1))
		echo "self-test: the gh sweep lets this line pass: $line" >&2
	fi
done
{ cat "$tmp/outputs"; echo 'gh api --hostname github.com repos/o/r (gh pr ready 7 --repo github.com/o/r)'; } >"$planted"
if awk "$sweep" "$planted" | grep -q 'gh api --hostname github.com repos'; then
	fails=$((fails + 1))
	echo "self-test: the gh sweep refuses a command that names github.com exactly" >&2
fi

echo "land self-test: $fails of $total checks failed (bash $BASH_VERSION)"
if [ -z "${LAND_SELF_TEST_SHIM:-}" ] && [ -x /bin/bash ] && ! [ /bin/bash -ef "$BASH" ]; then
	mkdir -p "$tmp/shim"
	ln -s /bin/bash "$tmp/shim/bash"
	PATH="$tmp/shim:$PATH" LAND_SELF_TEST_SHIM=1 /bin/bash "$root/scripts/land-self-test" ||
		fails=$((fails + 1))
fi
[ "$fails" -eq 0 ]

says "--  land/approved           not judged: main's CODEOWNERS does not say whose approval" \
	"a rule that cannot be judged says why"
says "land: $nrules rules: " "the count"
lacks "then check that main is the head" "no check of a landing that would not go"

forge
echo '[[]]' | fixture "repos/land-test/fpl/rules/branches/main?per_page=100"

if grep '^gh ' "$tmp/out" | grep -v -e '^gh api --hostname github.com ' \
	-e '^gh pr view [0-9]* --repo github.com/' | grep -q .; then
	fails=$((fails + 1))
	echo "self-test: a gh call that does not name github.com:" >&2
	grep '^gh ' "$tmp/out" | grep -v -e '^gh api --hostname github.com ' \
		-e '^gh pr view [0-9]* --repo github.com/' | sed 's/^/    /' >&2
fi

# The window between the last read and the push cannot be closed from here: the approvals
# and then the rules are the last reads before the push, and are read again after it.
forge
printf '#!/bin/sh\necho "git push" >>"$FORGE/calls"\n' >"$REMOTE/hooks/pre-receive"
chmod +x "$REMOTE/hooks/pre-receive"
landing 0 "the approvals and the rules are read last before the push" 7
rm -f "$REMOTE/hooks/pre-receive"
total=$((total + 1))
# What is read after the last read of the reviews and before the push: the rules alone.
after="$(awk '/^git push$/ { exit } /pulls\/7\/reviews/ { a = ""; next } { a = a $0 "\n" }
	END { printf "%s", a }' "$FORGE/calls")"
case "$after" in *rules/branches/main*) ;; *) after="$after(no read of the rules)" ;; esac
if printf '%s\n' "$after" | grep -v 'rules/branches/main\|rulesets/' | grep -q .; then
	fails=$((fails + 1))
	echo "self-test: read after the reviews, before the push, besides the rules:" >&2
	printf '%s\n' "$after" | sed 's/^/    /' >&2
fi


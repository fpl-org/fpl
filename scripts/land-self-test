	expect 1 "main's rules answered as $empty" --dry-run 7
	says "NO  land/rules" "an empty or malformed rules answer is refused by name"
	says "remedy:" "it says what to do"
	lacks "ok  land/checks" "no check is judged against rules that are not there"
done


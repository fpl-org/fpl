lacks "ok  land/rules" "it is not judged as fine"

# A rule that is not GitHub's schema for it is a forge failure too, never fewer rules.
for bad in '{"type": "required_status_checks", "ruleset_id": 1}' \
	'{"type": "required_status_checks", "ruleset_id": 1, "parameters": {"required_status_checks": "ci", "strict_required_status_checks_policy": false}}' \
	'{"type": "required_status_checks", "ruleset_id": 1, "parameters": {"required_status_checks": [{"context": "ci", "integration_id": "15368"}], "strict_required_status_checks_policy": false}}' \
	'{"type": "required_status_checks", "ruleset_id": 1, "parameters": {"required_status_checks": [{"integration_id": 15368}], "strict_required_status_checks_policy": false}}' \
	'{"type": "required_status_checks", "ruleset_id": 1, "parameters": {"required_status_checks": [{"context": "ci"}]}}' \
	'{"type": "pull_request", "ruleset_id": 1}' \
	'{"type": "pull_request", "ruleset_id": 1, "parameters": {"required_approving_review_count": "2", "dismiss_stale_reviews_on_push": true, "require_code_owner_review": true, "require_last_push_approval": false, "required_review_thread_resolution": true}}' \
	'{"type": "pull_request", "ruleset_id": 1, "parameters": {"required_approving_review_count": true, "dismiss_stale_reviews_on_push": true, "require_code_owner_review": true, "require_last_push_approval": false, "required_review_thread_resolution": true}}' \
	'{"type": "pull_request", "ruleset_id": 1, "parameters": {"required_approving_review_count": 1, "dismiss_stale_reviews_on_push": true, "require_code_owner_review": true, "require_last_push_approval": "yes", "required_review_thread_resolution": true}}' \
	'{"type": "deletion", "ruleset_id": "2"}' \
	'{"type": "deletion", "ruleset_id": true}' \
	'{"type": 5, "ruleset_id": 2}'; do
	forge
	rules '{"context": "commit-lint", "integration_id": 15368}' 1 "$bad"
	expect 1 "a rule not as GitHub's schema gives it: $bad" --dry-run 7
	says "NO  land/rules" "a malformed rule is refused by name"
	lacks "ok  land/checks" "no check is judged against rules that are not read"
done
forge
rules '{"context": "commit-lint"}'
expect 0 "a required check that names no app means any app" --dry-run 7
says "ok  land/rules" "a check without integration_id is the schema's"
lacks "NO  land/rules" "it is not read as malformed"


release {ORPHAN}
└─ #7 late <{LAB}7>"""
HOSTILE = [
    pr(1, "\x1b[31mred", "a", "main", commits=("x\ny",)),
    pr(2, "a\nb \u202eevil", "b", "main"),
    pr(3, 'q"uote <b>x</b> & ]]', "c", "main", draft=True),
    pr(4, "`tick` %%;|", "d", "main"),
]
HOSTILE_TEXT = """main
├─ #1 ?[31mred
│     001abcd x?y
├─ #2 a?b ?evil
├─ #3 (draft) q"uote <b>x</b> & ]]
└─ #4 `tick` %%;|"""
HOSTILE_MERMAID = """```mermaid
graph LR
  classDef draft stroke-dasharray: 5 5
  b1["main"]
  p1["#1 ?[31mred"]
  p2["#2 a?b ?evil"]
  p3["#3 q#quot;uote #lt;b#gt;x#lt;/b#gt; #amp; ]]"]
  p4["#4 #96;tick#96; %%;|"]
  b1 --> p1
  b1 --> p2
  b1 --> p3
  b1 --> p4
  class p3 draft
```"""
NO_COMMITS = [{k: v for k, v in p.items() if k != "commits"} for p in STACK]
CYCLE = [pr(1, "a", "a", "b"), pr(2, "b", "b", "a"), pr(3, "c", "c", "main")]
CYCLE_ABOVE = [*CYCLE[:2], pr(4, "d", "d", "a")]
FORWARD = [pr(1, "forward", "main", "release"), pr(2, "x", "x", "main")]
FORWARD_TEXT = f"""main
└─ #2 x

release {ORPHAN}
└─ #1 forward"""
AMBIGUOUS = [pr(1, "a", "x", "main"), pr(2, "b", "x", "main"), pr(3, "c", "x", "main")]
HOSTILE_HEAD = [pr(n, "t", "x\ny\\nz\x1b", "main") for n in (1, 2)]
TWO_CYCLES = [
    pr(1, "a", "a", "b"),
    pr(2, "b", "b", "a"),
    pr(3, "c", "c", "d"),
    pr(4, "d", "d", "e"),
]
TWO_CYCLES += [pr(5, "e", "e", "c"), pr(6, "f", "f", "main"), pr(7, "g", "g", "g")]
# what fuzz() builds titles and branch names of: Mermaid's syntax, entities, markup, and text
# that is wide, astral, right-to-left, combining or invisible
PIECES = (*"\"#;%|()[]{}<>&`\\:-~*_=!?'/@$^ \t", "\n%% x", "\\n", "e\u0301", "\u200d", "\U0001f333")
PIECES += ("end", "graph LR", "click p1 href", "-->", "|x|", "#9829;", "&amp;", "<script>", "]]")
PIECES += ('"]', "語", "שלום", ":::draft", "style p1 fill:red", "%%{init: {}}%%")
# what Mermaid parses inside the fence: one of these, line by line
MERMAID_LINE = re.compile(
    r'graph LR|  (?:classDef draft stroke-dasharray: 5 5|[pb]\d+\["[^"]*"\]|[pb]\d+ --> p\d+'
    r'|class p\d+(?:,p\d+)* draft|click p\d+ href "https?://[\w.:/-]+")'
)


def fuzz(seed: int, n: int = 40) -> list[dict]:
    """n pull requests with titles and orphan bases drawn from PIECES, stacked at random."""
    rnd = random.Random(seed)

    def text() -> str:
        return "".join(rnd.choice(PIECES) for _ in range(rnd.randint(1, 60)))[:256]

    bases = [rnd.choice(["main", text(), *(f"h{j}" for j in range(i))]) for i in range(n)]
    return [pr(i + 1, text(), f"h{i}", b, draft=rnd.random() < 0.3) for i, b in enumerate(bases)]


# 299 pull requests in one chain, each title 256 quotes: 1536 characters once escaped
BIG = [pr(i, '"' * 256, f"h{i}", f"h{i - 1}" if i else "main") for i in range(LIMIT - 1)]

# (name, flags, input, exit, stdout, words the stderr must hold)
CASES = [
    ("tree", [], STACK, 0, STACK_TEXT, ()),
    ("commits", ["--commits"], STACK, 0, STACK_COMMITS, ()),
    ("mermaid", ["--mermaid"], STACK, 0, STACK_MERMAID, ()),

    ),
    (
        "--urls",
        ["--urls", "--forge", "ssh://git@gitlab.example.org:22/g/s/r"],
        ORPHANED,
        0,
        ORPHANED_URLS,
        (),
    ),
    ("cross-repo head is no parent", [], FORK, 0, FORK_TEXT, ()),
    ("root off main is annotated", [], ORPHANED, 0, ORPHANED_TEXT, ()),
    ("hostile titles, text", ["--commits"], HOSTILE, 0, HOSTILE_TEXT, ()),
    ("hostile titles, mermaid", ["--mermaid"], HOSTILE, 0, HOSTILE_MERMAID, ()),
    ("cycle", [], CYCLE, 2, "", ("stack-tree/cycle", "#1 and #2", "remedy")),
    (
        "each cycle is named, one retarget per cycle",
        [],
        TWO_CYCLES,
        2,
        "",
        ("#1 and #2 are each other's", "#3, #4 and #5 are", "#7 is based on itself", "each cycle"),
    ),
    (
        "cycle names the ring, then what hangs above",
        [],
        CYCLE_ABOVE,
        2,
        "",
        ("#1 and #2 are", "also hidden: #4"),
    ),
    ("a head named main is no parent of main's pull requests", [], FORWARD, 0, FORWARD_TEXT, ()),
    ("ambiguous head", [], AMBIGUOUS, 2, "", ("stack-tree/ambiguous", "#1, #2 and #3", "remedy")),
    ("--mermaid ignores --commits", ["--mermaid", "--commits"], NO_COMMITS, 0, STACK_MERMAID, ()),
    ("empty", [], [], 0, "no open pull requests", ()),
    ("not a list", [], {}, 2, "", ("stack-tree/input", "remedy")),
    ("missing field", [], [{"number": 1}], 2, "", ("stack-tree/input", "title")),
    (
        "commits asked, none given",
        ["--commits"],
        NO_COMMITS,
        2,
        "",
        ("stack-tree/input", "commits"),
    ),
]


def go(
    *args: str, stdin: str | None = None, env: dict[str, str] | None = None, cwd: Path | None = None
) -> subprocess.CompletedProcess[str]:
    """The script as a process; outside a git repository unless `env` says otherwise, so no
    remote of the checkout it runs from adds links."""
    return subprocess.run(
        [sys.executable, str(Path(__file__).resolve()), *args],
        input=stdin,
        capture_output=True,
        text=True,
        check=False,
        env=env or {**os.environ, "GIT_DIR": os.devnull},
        cwd=cwd,
    )


def tty(*args: str) -> str:
    """What the script writes to a terminal. The terminal stays open here until it is read to
    its end: macOS drops what is unread once the last writer closes it."""
    lead, follow = os.openpty()
    proc, out = subprocess.Popen([sys.executable, __file__, *args], stdout=follow), b""
    while select.select([lead], [], [], 0.1)[0] or proc.poll() is None:
        out += os.read(lead, 65536) if select.select([lead], [], [], 0)[0] else b""
    os.close(follow)
    os.close(lead)
    return out.decode()


def live(tmp: Path, listed: str, view: str, *flags: str) -> subprocess.CompletedProcess[str]:
    """The live path against a stand-in gh, which prints `listed` for `pr list` and `view` for
    `pr view`."""
    gh = tmp / "bin" / "gh"
    gh.parent.mkdir(exist_ok=True)
    gh.write_text(
        '#!/bin/sh\ncase "$2" in token) echo t;; list) echo "$L";; view) echo "$V";; esac\n'
    )
    gh.chmod(0o755)
    env = {**os.environ, "PATH": f"{gh.parent}:{os.environ['PATH']}", "L": listed, "V": view}
    env["GIT_DIR"] = os.devnull
    return go("--repo", "o/r", *flags, env=env)


def mermaid_ok(lines: list[str]) -> bool:
    """The block is fenced, every line is one Mermaid parses, and it fits MERMAID_MAX."""
    inner = lines[1:-1]
    return (
        lines[0] == "```mermaid"
        and lines[-1] == "```"
        and all(MERMAID_LINE.fullmatch(line) for line in inner)
        and js_len("\n".join(inner)) <= MERMAID_MAX
    )


def mmdc(tmp: Path, blocks: list[str]) -> list[str]:
    """Render every block with mermaid-cli, the parser GitHub's renderer runs: the names of
    what failed. Without mmdc, or a browser for it, it says so on stderr and checks nothing; a
    broken diagram it renders would make it a check that cannot fail, so that is a failure."""
    tool = shutil.which("mmdc")
    (tmp / "mmdc.json").write_text('{"securityLevel": "antiscript"}')
    (tmp / "broken.md").write_text('```mermaid\ngraph LR\n  a["x"y"]\n```\n')
    (tmp / "all.md").write_text("\n\n".join(blocks) + "\n")

    def render(name: str) -> subprocess.CompletedProcess[str]:
        args = [
            "-q",
            "-c",
            str(tmp / "mmdc.json"),
            "-i",
            str(tmp / name),
            "-o",
            str(tmp / "out.md"),
        ]
        return subprocess.run([str(tool), *args], capture_output=True, text=True, check=False)

    if tool is None or "Parse error" not in (probe := render("broken.md")).stderr:
        why = "not on PATH" if tool is None else "cannot render (no browser?)"
        print(
            f"stack-tree self-test: SKIP Mermaid parse: mmdc {why}; remedy: nix shell"
            " nixpkgs#mermaid-cli, with PUPPETEER_EXECUTABLE_PATH naming a Chrome",
            file=sys.stderr,
        )
        return [] if tool is None or probe.returncode else ["mmdc renders a broken diagram"]
    got = render("all.md")
    svgs = "".join(f.read_text() for f in tmp.glob("out-*.svg"))
    if got.returncode or "Maximum text size" in svgs:
        print(f"FAIL mmdc: {got.stderr[:2000]}", file=sys.stderr)
        return ["mmdc parses every block"]
    print(f"stack-tree self-test: mmdc rendered {len(blocks)} blocks", file=sys.stderr)
    return []


def refused(got: subprocess.CompletedProcess[str], name: str) -> bool:
    return got.returncode == 2 and "stack-tree/input" in got.stderr and name in got.stderr


def extra_cases(tmp: Path) -> list[str]:
    """What the fixtures table cannot say: an unreadable input, the cap on the commits gh lists,
    a refusal built from hostile text, a closed pipe, the remote's spellings. Returns the names
    that failed."""
    (tmp / "latin1.json").write_bytes(b"[\xe9]")
    (tmp / "many.json").write_text(
        json.dumps([pr(1, "t", "t", "main", commits=("c",) * GH_COMMITS)])
    )
    (tmp / "head.json").write_text(json.dumps(HOSTILE_HEAD))
    (tmp / "deep.json").write_text("[" * 10000 + "]" * 10000)
    (tmp / "full.json").write_text(json.dumps([pr(n, "t", f"b{n}", "main") for n in range(LIMIT)]))
    bad_oid = pr(1, "t", "t", "main", commits=("c",))
    bad_oid["commits"][0]["oid"] = "\x1b[31mX"
    (tmp / "oid.json").write_text(json.dumps([bad_oid]))
    (tmp / "entity.json").write_text(json.dumps([pr(1, "#9829;", "a", "main")]))
    one = json.dumps([{k: v for k, v in pr(1, "t", "t", "main").items() if k != "commits"}])
    commit = '{"commits":[{"oid":"abcdef0123","messageHeadline":"h"}]}'
    nojson = live(tmp, "NOT JSON", "")
    gone, bad, many, head, deep, full, oid, entity, usage = (
        go("--json", str(tmp / "gone.json")),
        go("--json", str(tmp / "latin1.json")),
        go("--json", str(tmp / "many.json"), "--commits"),
        go("--json", str(tmp / "head.json")),
        go("--json", str(tmp / "deep.json")),
        go("--json", str(tmp / "full.json")),
        go("--json", str(tmp / "oid.json"), "--commits"),
        go("--json", str(tmp / "entity.json"), "--mermaid"),
        go("--bad\x1b[31m"),
    )
    (tmp / "empty.json").write_text("[]")
    closed = subprocess.Popen(
        [sys.executable, __file__, "--json", str(tmp / "empty.json")],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if closed.stdout is not None:
        closed.stdout.close()  # the reader is gone before the first byte is written
    _, closed_err = closed.communicate()
    urls = {
        "git@github.com-bot:o/r.git": "o/r",
        "https://github.com/o/r": "o/r",
        "git@github.com:o/r.git": "o/r",
        "ssh://git@github.com-bot/o/r": "o/r",
        "git@github.com-a.b:o/r": None,
        "https://notgithub.com/o/r": None,
        "https://github.com-bot/o/r": None,
        "https://github.com.evil.net/o/r": None,
        "git@gitlab.com:o/r": None,
    }
    blocks = []
    for name, data in [
        ("hostile", HOSTILE),
        ("big", BIG),
        *((f"fuzz{k}", fuzz(k)) for k in range(8)),
    ]:
        (tmp / f"{name}.json").write_text(json.dumps(data))
        got = go(
            "--json", str(tmp / f"{name}.json"), "--mermaid", "--forge", "https://github.com/o/r"
        )
        blocks.append(got.stdout.rstrip("\n"))
    repo = tmp / "repo"
    subprocess.run(["git", "init", "-q", str(repo)], check=True)
    subprocess.run(["git", "-C", str(repo), "remote", "add", "github", LAB[:-18]], check=True)
    (tmp / "orphaned.json").write_text(json.dumps(ORPHANED))
    (tmp / "stack.json").write_text(json.dumps(STACK))
    remote = go("--json", str(tmp / "orphaned.json"), "--urls", env=dict(os.environ), cwd=repo)
    remotes = {
        "https://github.com/o/r.git": GH,
        "git@github.com-bot:o/r": GH,
        "http://forgejo.lan:3000/o/r/": "http://forgejo.lan:3000/o/r/pulls/",
        "git@codeberg.org:o/r.git": "https://codeberg.org/o/r/pulls/",
        "ssh://git@gitlab.example.org:2222/g/s/r.git": LAB,
        "https://gitea.example.net/o/r": "https://gitea.example.net/o/r/pulls/",
        "https://git.example.org/o/r": None,
        "github.com:o/r.git": GH,
        "https://GitHub.com/o/r": "https://GitHub.com/o/r/pull/",
        "git@GitHub.com-bot:o/r": "https://GitHub.com/o/r/pull/",
        "ssh://git@gitlab.example-host/g/r.git": None,
        "git@gitlab.example.org-bot:g/r": None,
        "srv/git/r.git": None,
        "git@gitlab:o/r.git": None,
        "rad://zKCzLFSuTB5BCmisbSBu6SsSokJc": None,
        "/srv/git/r.git": None,
        'https://github.com/o/r"x': None,
    }
    checks = {
        "remotes to links": [forge_link(u) for u in remotes] == list(remotes.values()),
        "links on a terminal": f"\x1b]8;;{GH}179\x1b\\#179\x1b]8;;\x1b\\"
        in tty("--json", str(tmp / "stack.json"), "--forge", "https://github.com/o/r"),
        "links from the github remote": remote.stdout.rstrip("\n") == ORPHANED_URLS,
        "fuzz: every block is lines Mermaid parses, within MERMAID_MAX": all(
            mermaid_ok(b.splitlines()) for b in blocks
        ),
        "big: titles cut to fit": "…" in blocks[1]
        and max(map(len, blocks[1].splitlines())) < 6 * 256,  # an uncut title escapes to that
        "stdin, with no git on PATH": go(
            "--json", "-", stdin="[]", env={**os.environ, "GIT_DIR": os.devnull, "PATH": ""}
        ).stdout
        == "no open pull requests\n",
        "missing file": refused(gone, "gone.json"),
        "non-UTF-8 file": refused(bad, "latin1.json"),
        "100 commits": many.returncode == 2 and "stack-tree/limit" in many.stderr,
        "300 pull requests in a file": full.returncode == 2 and "stack-tree/limit" in full.stderr,
        "JSON nested too deep": refused(deep, "remedy") and "Traceback" not in deep.stderr,
        "oid with an escape": refused(oid, "hex oid")
        and "gh pr view" in oid.stderr
        and "\x1b" not in oid.stderr + oid.stdout,
        "# in a Mermaid title": 'p1["#1 #35;9829;"]' in entity.stdout,
        "bad option": usage.returncode == 2
        and "stack-tree/usage" in usage.stderr
        and "\x1b" not in usage.stderr,
        "live: gh lists no JSON": nojson.returncode == 2 and "stack-tree/forge" in nojson.stderr,
        "live: gh views no commits": "stack-tree/forge" in live(tmp, one, "{}", "--commits").stderr,
        "live: drawn": "abcdef0 h" in live(tmp, one, commit, "--commits").stdout,
        "hostile text in a refusal": len(head.stderr.splitlines()) == 2
        and "'x?y\\nz?'" in head.stderr
        and "\x1b" not in head.stderr,
        "closed pipe": closed.returncode == -signal.SIGPIPE and closed_err == "",
        "remote urls": [repo_of(u) for u in urls] == list(urls.values()),
    }
    return [name for name, ok in checks.items() if not ok] + mmdc(tmp, blocks)


def self_test() -> int:
    """Run the script itself on each fixture, as a process: no network, no gh."""
    with tempfile.TemporaryDirectory() as tmp:
        failed = []
        for name, flags, data, code, out, words in CASES:
            (Path(tmp) / "prs.json").write_text(json.dumps(data))
            got = go(*flags, "--json", str(Path(tmp) / "prs.json"))
            if not (
                got.returncode == code
                and got.stdout.rstrip("\n") == out.rstrip("\n")
                and (all(w in got.stderr for w in words) if code else got.stderr == "")
            ):
                failed.append(name)
                print(
                    f"FAIL {name}: exit {got.returncode}\n{got.stdout}{got.stderr}", file=sys.stderr
                )
        failed += extra_cases(Path(tmp))
    verdict = "FAILED: " + ", ".join(failed) if failed else "all cases ok"
    print(f"stack-tree self-test: {verdict}")
    return 1 if failed else 0


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # a closed pipe ends us quietly, as it ends cat
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
# gates: $BIN/python $S/stack-tree --self-test
"""scripts/stack-tree — the open pull requests as the tree their bases make, never committed.

    scripts/stack-tree [--commits] [--mermaid] [--urls] [--json FILE] [--repo OWNER/NAME]
                       [--forge URL]
    scripts/stack-tree --self-test

The maintainer stacks pull requests: one is based on the head branch of another. GitHub's list
is flat, so the shape is invisible. This draws it, as a view like scripts/diagrams: computed on
demand from the forge, never written into the repository. Native stacked pull requests are not
used: they are a linear chain, and they land through merge methods that rewrite SHAs, which
scripts/land (a fast-forward) refuses to depend on. The tree is computed here instead.

The input is the JSON `gh pr list --state open --limit 300 --json number,title,headRefName,
baseRefName,isDraft,isCrossRepository` prints, with a `commits` list of oid and messageHeadline
per pull request when --commits asks for them. --json FILE (or `-` for stdin) reads it from
there; without it the script asks the forge, read-only, like scripts/sweep: gh with the machine
account's token (STACK_TREE_GH_USER, default psjg-claude) for STACK_TREE_REPO or --repo (default:
the `github` remote). The commits come one `gh pr view` each, since one list with them exceeds
GitHub's GraphQL node limit. Drawing needs python3 alone; gh is only the transport, and without
it the remedy is `scripts/layer on github`. A token is never printed.

The rule: a pull request hangs under the open pull request whose head branch is its base, and
only a same-repository pull request can be a parent: a fork's branch may be named anything,
`main` included; `main` itself is never a parent. One whose base has no open parent is a root
under that base branch. The roots based on `main` are what scripts/land takes; any other root is
annotated, because it needs a retarget (or its base landed) first.

--commits lists each pull request's own commits under it; --mermaid, which draws none, ignores
it. --mermaid prints a fenced Mermaid block (`graph LR`: the trunk on the left, an arrow from a
branch to each pull request based on it, so a stack reads in the order it lands; drafts dashed)
to paste into a comment or a run's $GITHUB_STEP_SUMMARY, where GitHub draws it. Left to right,
not top down, as a pull request's title is wider than tall: the open ones of 2026-10-21 drew
811 px wide that way and 1906 px top down, which GitHub shrinks to its column. Node ids are
p<number> and b<k>, never taken from a title; in a label `#`, `"`, `<`, `>`, `&` and a backtick
are written as entities, as Mermaid reads them as an entity, the label's end, markup or a
Markdown label. Mermaid draws an error past MERMAID_MAX characters, so titles are cut, longest
first, until the block fits. Titles,
headlines and branch names are untrusted forge text: every character of Unicode category C
(control, format such as a bidi override, surrogate, private use, and so newlines) is shown as
`?`, in both outputs and in every refusal. A line is never cut to the terminal's width. A reader
that closes the pipe early ends the script quietly, as for any filter.

Refused, naming the rule and the remedy (exit 2): stack-tree/input
(not the JSON above, nested too deep to read, a commit oid that is not hex, or a file that
cannot be read),
stack-tree/ambiguous (two or more open same-repository pull requests share a head branch),
stack-tree/cycle (pull requests that are each other's ancestors, which a walk from the roots
would silently drop; each cycle is named, and what hangs above it),
stack-tree/limit (300 pull requests, or 100 commits of one, which is all gh lists: some may be
missing; so for a file as for the forge), stack-tree/gh and stack-tree/forge (the forge could
not be read, or printed what is not the JSON above),
stack-tree/usage (the command line, or no github remote).

Each pull request links to its page on the forge: on a terminal its number is an OSC 8
hyperlink, with --urls its address follows the title (for a pipe, which gets no escapes), and in
--mermaid a click on its node opens it. The address comes from a
remote's url, any spelling git takes: --forge URL, else https://github.com/OWNER/NAME when the
repository is named (gh reads it there), else the `github` remote. The host names the forge's
kind, which names the path to a request (PR_PATHS): /pull/N on GitHub, /-/merge_requests/N on
GitLab, /pulls/N on Gitea, Forgejo and Codeberg; github.com, gitlab.com and codeberg.org, or a
host whose first label is the kind, as gitlab.example.org, in any case. An ssh alias such as
github.com-bot names one of those three; past them an alias cannot be told from a host, so a
host without a dot over ssh, or whose last label is not shaped as a top-level domain's, gets no
links, as does any other host.

Exit 0: drawn (no open pull requests draws that), or the self-test passed; 1: the self-test
failed; 2: refused.
"""

import argparse
import json
import os
import random
import re
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import unicodedata
from dataclasses import dataclass
from pathlib import Path
from typing import NoReturn

MAIN = "main"
GH_HOST = "github.com"  # where gh reads from; links follow the remote, any forge
PR_PATHS = {"github": "/pull/", "gitlab": "/-/merge_requests/", "gitea": "/pulls/"}
PR_PATHS |= {"forgejo": "/pulls/", "codeberg": "/pulls/"}  # the path to a request, by kind
ORPHAN = "(no open pull request on this branch: retarget or land first)"
LIMIT = 300
GH_COMMITS = 100  # what `gh pr view --json commits` lists at most
FIELDS = {
    "number": int,
    "title": str,
    "headRefName": str,
    "baseRefName": str,
    "isDraft": bool,
    "isCrossRepository": bool,
}
MERMAID_ESCAPES = str.maketrans(
    {"#": "#35;", '"': "#quot;", "<": "#lt;", ">": "#gt;", "&": "#amp;", "`": "#96;"}
)
MERMAID_MAX = 50_000  # Mermaid's maxTextSize, which GitHub's renderer keeps from diagrams
CUTS = (None, 120, 80, 50, 30, 15, 0)  # the title lengths --mermaid tries, longest first
INPUT_REMEDY = f"feed it `gh pr list --state open --limit {LIMIT} --json {','.join(FIELDS)}`"
FORGE_REMEDY = "check the gh version and the repository"
COMMITS_REMEDY = INPUT_REMEDY[:-1] + ",commits`, per pull request as `gh pr view` has it"


class RefusalError(Exception):
    """A refusal with its rule and remedy, ready to print."""


def clean(text: str) -> str:
    """Show every character of Unicode category C as `?`: forge text is not trusted."""
    return "".join("?" if unicodedata.category(c).startswith("C") else c for c in text)


def refuse(rule: str, what: str, remedy: str) -> RefusalError:
    """The refusal, ready to print: its parts are cleaned, then joined by the one newline that
    is its own."""
    return RefusalError(f"{rule}: {clean(what)}\n    remedy: {clean(remedy)}")


@dataclass(frozen=True)
class Pr:
    number: int
    title: str
    head: str
    base: str
    draft: bool
    cross: bool
    commits: tuple[tuple[str, str], ...]  # (7-char oid, headline), as the forge lists them


@dataclass(frozen=True)
class Forest:
    roots: dict[str, list[int]]  # base branch -> its pull requests, by number
    kids: dict[int, list[int]]  # number -> the pull requests based on its head, by number


# --- the readers: data in, Pr out, nothing guessed -------------------------------------------


def read_commit(raw: object, at: int) -> tuple[str, str]:
    if not (
        isinstance(raw, dict)
        and type(raw.get("oid")) is str
        and re.fullmatch(r"[0-9a-f]{7,64}", raw["oid"])
        and type(raw.get("messageHeadline")) is str
    ):
        raise refuse(
            "stack-tree/input",
            f"entry {at}: a commit lacks a hex oid or a messageHeadline",
            COMMITS_REMEDY,
        )
    return raw["oid"][:7], raw["messageHeadline"]


def read_pr(raw: object, at: int, with_commits: bool) -> Pr:
    if not isinstance(raw, dict):
        raise refuse("stack-tree/input", f"entry {at} is not an object", INPUT_REMEDY)
    for key, kind in FIELDS.items():
        if type(raw.get(key)) is not kind:
            raise refuse(
                "stack-tree/input", f"entry {at}: {key} is not a {kind.__name__}", INPUT_REMEDY
            )
    listed = raw.get("commits") if with_commits else ()
    if type(listed) not in (list, tuple):
        raise refuse("stack-tree/input", f"entry {at}: commits is not a list", COMMITS_REMEDY)
    if len(listed) >= GH_COMMITS:
        raise refuse(
            "stack-tree/limit",
            f"#{raw['number']} has {len(listed)} commits, as many as gh lists; some may be missing",
            "run without --commits, or read that pull request's commits on the forge",
        )
    commits = tuple(read_commit(c, at) for c in listed)
    return Pr(
        raw["number"],
        raw["title"],
        raw["headRefName"],
        raw["baseRefName"],
        raw["isDraft"],
        raw["isCrossRepository"],
        commits,
    )


def load(text: str, rule: str = "stack-tree/input", remedy: str = INPUT_REMEDY) -> list:
    """The JSON list of pull requests in `text`, a refusal under `rule` if it is none: gh lists
    at most LIMIT, so a list that long may have been cut short, from the forge or from a file."""
    try:
        raw = json.loads(text)
    except (ValueError, RecursionError) as e:  # RecursionError: JSON nested thousands deep
        raise refuse(rule, f"not JSON ({e})", remedy) from e
    if not isinstance(raw, list):
        raise refuse(rule, "the top level is not a list", remedy)
    if len(raw) >= LIMIT:
        raise refuse(
            "stack-tree/limit",
            f"{len(raw)} pull requests, as many as the {LIMIT} gh lists; some may be missing",
            "close or land some, or raise LIMIT in scripts/stack-tree",
        )
    return raw


def read_prs(text: str, with_commits: bool = False) -> list[Pr]:
    raw = load(text)
    prs = [read_pr(r, i, with_commits) for i, r in enumerate(raw)]
    numbers = [p.number for p in prs]
    if len(set(numbers)) != len(numbers):
        raise refuse("stack-tree/input", "a pull request number appears twice", INPUT_REMEDY)
    return sorted(prs, key=lambda p: p.number)


# --- the core: the tree, and its two drawings ------------------------------------------------


def numbers(ns: list[int]) -> str:
    """#1, #2 and #3"""
    return ", ".join(f"#{n}" for n in ns[:-1]) + (" and " if len(ns) > 1 else "") + f"#{ns[-1]}"


def forest(prs: list[Pr]) -> Forest:
    """Hang each pull request under the same-repository one its base names; refuse what a walk
    from the roots would hide: two pull requests for one head, or a cycle."""
    shared: dict[str, list[Pr]] = {}
    for p in (p for p in prs if not p.cross):
        shared.setdefault(p.head, []).append(p)
    if dups := {h: ps for h, ps in shared.items() if len(ps) > 1}:
        groups = "; ".join(
            f"{numbers([p.number for p in ps])} from branch '{h}'" for h, ps in dups.items()
        )
        raise refuse(
            "stack-tree/ambiguous",
            f"these are open together: {groups}",
            "close or retarget all but one of each group, so each head branch has one pull request",
        )
    heads = {h: ps[0] for h, ps in shared.items()}
    roots: dict[str, list[int]] = {}
    kids: dict[int, list[int]] = {}
    above: dict[int, int] = {}
    for p in prs:
        parent = None if p.base == MAIN else heads.get(p.base)  # main is a root, never a parent
        if parent is None:
            roots.setdefault(p.base, []).append(p.number)
        else:
            kids.setdefault(parent.number, []).append(p.number)
            above[p.number] = parent.number
    seen: set[int] = set()
    todo = [n for ns in roots.values() for n in ns]
    while todo:
        n = todo.pop()
        if n not in seen:
            seen.add(n)
            todo += kids.get(n, [])
    lost = [p.number for p in prs if p.number not in seen]
    if lost:
        raise cycle_refusal(above, lost)
    return Forest(roots, kids)


def cycles(above: dict[int, int], lost: list[int]) -> list[list[int]]:
    """The cycles among the lost pull requests, each as its sorted members. Every pull request
    has one parent, so a walk up from any lost one ends in exactly one cycle."""
    found: list[list[int]] = []
    for start in lost:
        path, n = [], start
        while n not in path:
            path.append(n)
            n = above[n]
        if (ring := sorted(path[path.index(n) :])) not in found:
            found.append(ring)
    return found


def cycle_refusal(above: dict[int, int], lost: list[int]) -> RefusalError:
    """Name each cycle, and the pull requests stacked above one, which are hidden with it."""
    rings = cycles(above, lost)
    members = {n for ring in rings for n in ring}
    clauses = "; ".join(
        f"{numbers(r)} are each other's ancestors" if len(r) > 1 else f"#{r[0]} is based on itself"
        for r in rings
    )
    rest = [n for n in lost if n not in members]
    also = f"; also hidden: {numbers(rest)}" if rest else ""
    return refuse(
        "stack-tree/cycle",
        f"{clauses}, so none hangs under a root{also}",
        "retarget one pull request of each cycle onto main or onto a branch outside it",
    )


def root_order(roots: dict[str, list[int]]) -> list[str]:
    return sorted(roots, key=lambda b: (b != MAIN, b))


def root_label(base: str) -> str:
    return clean(base) + ("" if base == MAIN else " " + ORPHAN)


def text_lines(prs: list[Pr], f: Forest, commits: bool, link: str | None, how: str) -> list[str]:
    """The tree; with a `link`, each number is an OSC 8 hyperlink if `how` is "osc8", or the
    title is followed by its address if it is "url"."""
    by = {p.number: p for p in prs}
    out: list[str] = []

    def draw(n: int, prefix: str, last: bool) -> None:
        p, sub, sk = by[n], prefix + ("   " if last else "│  "), f.kids.get(n, [])
        mark = " (draft)" if p.draft else ""
        num = f"\x1b]8;;{link}{n}\x1b\\#{n}\x1b]8;;\x1b\\" if link and how == "osc8" else f"#{n}"
        url = f" <{link}{n}>" if link and how == "url" else ""
        out.append(f"{prefix}{'└─ ' if last else '├─ '}{num}{mark} {clean(p.title)}{url}")
        if commits:
            bar = f"{sub}{'│' if sk else ' '}  "
            out.extend(f"{bar}{oid} {clean(h)}" for oid, h in p.commits)
        for i, c in enumerate(sk):
            draw(c, sub, i == len(sk) - 1)

    for k, base in enumerate(root_order(f.roots)):
        out += [""] * (k > 0) + [root_label(base)]
        for i, n in enumerate(f.roots[base]):
            draw(n, "", i == len(f.roots[base]) - 1)
    return out


def js_len(text: str) -> int:
    """The length JavaScript gives `text`, which Mermaid compares with MERMAID_MAX: UTF-16 units."""
    return len(text.encode("utf-16-le")) // 2


def mermaid_lines(prs: list[Pr], f: Forest, cut: int | None, link: str | None) -> list[str]:
    """The diagram, unfenced: the trunk on the left, an edge from a branch to each pull request
    based on it, so a stack reads left to right in the order it lands; titles cut to `cut`, and
    a click on a node opens `link` and its number."""

    def esc(text: str) -> str:
        return text.translate(MERMAID_ESCAPES)

    def title(p: Pr) -> str:
        t = clean(p.title)
        return t if cut is None or len(t) <= cut else t[:cut] + "…"

    out = ["graph LR", "  classDef draft stroke-dasharray: 5 5"]
    edges: list[str] = []
    for k, base in enumerate(root_order(f.roots), 1):
        out.append(f'  b{k}["{esc(root_label(base))}"]')
        edges += [f"  b{k} --> p{n}" for n in f.roots[base]]
    out += [f'  p{p.number}["#{p.number} {esc(title(p))}"]' for p in prs]
    for parent, ns in sorted(f.kids.items()):
        edges += [f"  p{parent} --> p{n}" for n in ns]
    drafts = ",".join(f"p{p.number}" for p in prs if p.draft)
    clicks = [f'  click p{p.number} href "{link}{p.number}"' for p in prs if link]
    return [*out, *edges, *([f"  class {drafts} draft"] if drafts else []), *clicks]


def mermaid_block(prs: list[Pr], f: Forest, link: str | None) -> list[str]:
    """The fenced diagram with the longest titles that keep it within MERMAID_MAX, past which
    Mermaid draws an error instead."""
    for cut in CUTS:
        if js_len("\n".join(lines := mermaid_lines(prs, f, cut, link))) <= MERMAID_MAX:
            return ["```mermaid", *lines, "```"]
    raise refuse(
        "stack-tree/limit",
        f"the Mermaid of {len(prs)} pull requests exceeds {MERMAID_MAX} characters untitled",
        "draw them as text: run without --mermaid",
    )


def draw(prs: list[Pr], mermaid: bool, commits: bool, link: str | None, how: str) -> list[str]:
    if not prs:
        return ["no open pull requests"]
    f = forest(prs)
    return mermaid_block(prs, f, link) if mermaid else text_lines(prs, f, commits, link, how)


# --- the edge: the forge, argv, the terminal -------------------------------------------------


def run(cmd: list[str], env: dict[str, str] | None = None) -> str:
    try:
        return subprocess.run(cmd, check=True, capture_output=True, text=True, env=env).stdout
    except subprocess.CalledProcessError as e:
        why = (e.stderr or "").strip().splitlines()[:1] or [f"exit {e.returncode}"]
        raise refuse(
            "stack-tree/forge",
            f"`{' '.join(cmd[:3])} ...` failed: {why[0]}",
            "check the repo name, the account and the network",
        ) from e


def repo_of(url: str) -> str | None:
    """OWNER/NAME of a github remote url, which must be github.com's whole: https, or ssh in
    either spelling, where the host may be a `github.com-<alias>` alias."""
    name = r"([^/\s]+/[^/\s]+?)(?:\.git)?"
    host = r"git@github\.com(?:-[^.:/\s]+)?"
    m = re.fullmatch(
        rf"(?:https://(?:[^@/\s]+@)?github\.com/|{host}:|ssh://{host}/){name}", url.strip()
    )
    return m.group(1) if m else None


def forge_link(url: str) -> str | None:
    """What a pull request's number is appended to, to address it: from a remote's url in any
    spelling git takes (https, ssh:// or [user@]host:path, where github.com-<alias> and the like
    are ssh aliases of github.com, gitlab.com and codeberg.org), on a host of a kind in PR_PATHS:
    github.com, gitlab.com, codeberg.org, or one whose first label names its kind, as
    gitlab.example.org, in any case. None for any other, and for an ssh host that may be an alias
    of another: one without a dot, or whose last label is not shaped as a top-level domain's."""
    m = re.fullmatch(
        r"(?:(?P<scheme>https?)://(?:[^@/\s]+@)?(?P<web>[\w.-]+(?::\d+)?)/"
        r"|ssh://(?:[^@/\s:]+@)?(?P<ssh>[\w.-]+)(?::\d+)?/|(?:[^@/\s:]+@)?(?P<scp>[\w.-]+):)"
        r"(?P<path>[\w.-]+(?:/[\w.-]+)+)/?",
        url.strip(),
        re.ASCII,
    )
    if m is None:
        return None
    alias = r"(?i)^(github\.com|gitlab\.com|codeberg\.org)-[\w-]+$"
    host = m["web"] or re.sub(alias, r"\1", m["ssh"] or m["scp"])
    name = host.split(":")[0].lower()
    if not re.fullmatch(r"[a-z]+|xn--[a-z0-9-]+", name.rsplit(".", 1)[-1]) or not (
        m["web"] or "." in name
    ):
        return None
    kind = {GH_HOST: "github", "gitlab.com": "gitlab"}.get(name, name.split(".")[0])
    pr_path = PR_PATHS.get(kind)
    path = m["path"].removesuffix(".git")
    return pr_path and f"{m['scheme'] or 'https'}://{host}/{path}{pr_path}"


def remote_url() -> str:
    """The url of the `github` remote, the one the forge is read from; empty without one, or
    without git: drawing needs python3 alone."""
    try:
        cmd = ["git", "remote", "get-url", "github"]
        return subprocess.run(cmd, capture_output=True, text=True, check=False).stdout
    except OSError:
        return ""


def default_repo() -> str:
    if (name := repo_of(remote_url())) is None:
        raise refuse(
            "stack-tree/usage",
            "no `github` remote to take the repository from",
            "pass --repo OWNER/NAME",
        )
    return name


def fetch(repo: str | None, with_commits: bool) -> str:
    gh = shutil.which("gh")
    if gh is None:
        raise refuse("stack-tree/gh", "gh is not on PATH", "scripts/layer on github")
    user = os.environ.get("STACK_TREE_GH_USER", "psjg-claude")
    token = run([gh, "auth", "token", "--hostname", "github.com", "--user", user]).strip()
    env = {**os.environ, "GH_TOKEN": token}
    at = ["-R", f"{GH_HOST}/{repo or default_repo()}"]
    listed = run(
        [
            gh,
            "pr",
            "list",
            *at,
            "--state",
            "open",
            "--limit",
            str(LIMIT),
            "--json",
            ",".join(FIELDS),
        ],
        env,
    )
    prs = load(listed, "stack-tree/forge", FORGE_REMEDY)
    try:
        for raw in prs if with_commits else ():
            view = run([gh, "pr", "view", str(raw["number"]), *at, "--json", "commits"], env)
            raw["commits"] = json.loads(view)["commits"]
    except (ValueError, RecursionError, KeyError, TypeError) as e:
        raise refuse(
            "stack-tree/forge",
            f"gh printed what is not a pull request ({e!r})",
            FORGE_REMEDY,
        ) from e
    return json.dumps(prs)


def read_source(name: str) -> str:
    try:
        return sys.stdin.read() if name == "-" else Path(name).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as e:
        raise refuse(
            "stack-tree/input", f"cannot read {name!r} as UTF-8 text ({e})", INPUT_REMEDY
        ) from e


class Parser(argparse.ArgumentParser):
    def error(self, message: str) -> NoReturn:
        raise refuse("stack-tree/usage", message, "see scripts/stack-tree --help")


def main(argv: list[str]) -> int:
    ap = Parser(prog="stack-tree", description="the open pull requests as a tree")
    ap.add_argument("--commits", action="store_true", help="list each pull request's commits")
    ap.add_argument("--mermaid", action="store_true", help="print a Mermaid block instead")
    ap.add_argument("--json", metavar="FILE", help="read gh's JSON from FILE, or - for stdin")
    ap.add_argument("--repo", metavar="OWNER/NAME", help="the repository to ask the forge about")
    ap.add_argument("--forge", metavar="URL", help="link to this remote's pull requests")
    ap.add_argument("--urls", action="store_true", help="print each pull request's address")
    ap.add_argument("--self-test", action="store_true", help="prove the script on fixtures")
    try:
        a = ap.parse_args(argv)
        if a.self_test:
            return self_test()
        commits = a.commits and not a.mermaid
        repo = a.repo or os.environ.get("STACK_TREE_REPO")
        text = read_source(a.json) if a.json else fetch(repo, commits)
        forge = a.forge or (f"https://{GH_HOST}/{repo}" if repo else remote_url())
        how = "url" if a.urls else "osc8" if sys.stdout.isatty() else ""
        lines = draw(read_prs(text, commits), a.mermaid, commits, forge_link(forge), how)
    except RefusalError as e:
        print(f"stack-tree: {e}", file=sys.stderr)
        return 2
    print("\n".join(lines))
    return 0


# --- the proof: the script, as a process, on fixtures ----------------------------------------


def pr(n: int, title: str, head: str, base: str, **kw: object) -> dict:
    return {
        "number": n,
        "title": title,
        "headRefName": head,
        "baseRefName": base,
        "isDraft": kw.get("draft", False),
        "isCrossRepository": kw.get("cross", False),
        "commits": [
            {"oid": f"{n:03d}abcdef0123", "messageHeadline": h} for h in kw.get("commits", ())
        ],
    }


STACK = [
    pr(179, "alpha", "a", "main", commits=("feat: alpha",)),
    pr(195, "gates", "g", "main", commits=("ci: gates", "docs: gates")),
    pr(182, "proof", "p", "g"),
    pr(190, "silence", "s", "g"),
    pr(191, "stamp", "t", "s", draft=True, commits=("feat: stamp",)),
]
STACK_TEXT = """main
├─ #179 alpha
└─ #195 gates
   ├─ #182 proof
   └─ #190 silence
      └─ #191 (draft) stamp"""
STACK_COMMITS = """main
├─ #179 alpha
│     179abcd feat: alpha
└─ #195 gates
   │  195abcd ci: gates
   │  195abcd docs: gates
   ├─ #182 proof
   └─ #190 silence
      └─ #191 (draft) stamp
            191abcd feat: stamp"""
STACK_MERMAID = """```mermaid
graph LR
  classDef draft stroke-dasharray: 5 5
  b1["main"]
  p179["#179 alpha"]
  p182["#182 proof"]
  p190["#190 silence"]
  p191["#191 stamp"]
  p195["#195 gates"]
  b1 --> p179
  b1 --> p195
  p190 --> p191
  p195 --> p182
  p195 --> p190
  class p191 draft
```"""
GH = "https://github.com/o/r/pull/"
STACK_LINKED = (
    STACK_MERMAID[:-3]
    + "".join(f'  click p{n} href "{GH}{n}"\n' for n in (179, 182, 190, 191, 195))
    + "```"
)
FORK = [
    pr(1, "one", "topic", "main"),
    pr(2, "fork", "topic", "main", cross=True),
    pr(3, "fork main", "main", "main", cross=True),
    pr(4, "above one", "above", "topic"),
]
FORK_TEXT = """main
├─ #1 one
│  └─ #4 above one
├─ #2 fork
└─ #3 fork main"""
ORPHANED = [pr(7, "late", "late", "release"), pr(8, "ok", "ok", "main")]
ORPHANED_TEXT = f"""main
└─ #8 ok

release {ORPHAN}
└─ #7 late"""
LAB = "https://gitlab.example.org/g/s/r/-/merge_requests/"
ORPHANED_URLS = f"""main

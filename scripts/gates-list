#!/usr/bin/env bash
#
# scripts/gates-list — what `make gates` runs and lints, read from the files themselves.
#
#   scripts/gates-list          the tools' self-tests, one command per line, in name order
#   scripts/gates-list --lint   the harness's Python that ruff judges, one path per line
#
# A list in quality/noslop.mk that every new tool appends to is a place where two series that
# each add a tool conflict, though neither touches the other's tool. So each tool says what
# proves it, in its own file, and this script collects what they say:
#
#   scripts/<name>-self-test    an executable file so named is a self-test, run as it is:
#                               $S/<name>-self-test
#   # gates: <command>          a line of the header of any other file in scripts/ names the
#                               command that proves the tool, where that proof is a flag or
#                               needs another interpreter: # gates: $BIN/python $S/crap --self-test
#   #!/usr/bin/env python3      a file in scripts/ that opens so is the harness's Python, as is
#                               every quality/*.py: ruff judges each one
#   # noslop: skip <reason>     a line of the header that keeps the file from ruff; the reason
#                               is required, and says why the file is not held to the rules
#
# The header is the run of lines starting with '#' that a file opens with, its shebang
# included. A command is printed as written: $BIN (the root's .venv/bin), $S (scripts/) and
# $ROOT are for the recipe to set and expand (quality/noslop.mk evals each line). The
# commands come in the order of their files' names under LC_ALL=C, so every machine runs them
# in the same order. scripts/gates is not a tool's self-test and declares none; the recipe
# runs it last, once every tool is proven.
#
# Refused, exit 1, naming the rule and the remedy: a *-self-test that is not executable (it
# would not run, and nothing would say so), a gates line or skip marker past the header (no
# one would read it), a second gates line in one file, a gates line in a *-self-test, an empty
# command, a skip without a reason, and finding no self-test at all. Plain bash 3.2: no
# mapfile, no associative arrays; the self-test runs it under /bin/bash and the bash on PATH.

set -euo pipefail
export LC_ALL=C

here="$(cd "$(dirname "$0")" && pwd)"
root="$(dirname "$here")"

case "${1:-}" in
'') lint=0 ;;
--lint) lint=1 ;;
*)
	echo "usage: gates-list [--lint]" >&2
	exit 2
	;;
esac

# refuse <rule> <what> <remedy>
refuse() {
	printf 'gates-list: %s: %s\n            %s\n' "$1" "$2" "$3" >&2
	exit 1
}

for t in "$here"/*-self-test; do
	[ -e "$t" ] || continue
	[ -x "$t" ] || refuse GATES-NOT-EXECUTABLE "${t#"$root"/} is not executable, so it would never run" \
		"chmod +x it, or rename it if it is not a self-test"
done

# One record per finding, tab-separated: `gate <name> <command>` or `py <path>`. A refusal is
# the last line, `! <rule> <what> <remedy>`, and awk exits 1 after it.
files=()
for f in "$here"/* "$root"/quality/*.py; do
	[ -f "$f" ] && files+=("$f")
done
status=0
records="$(awk -v here="$here" '
	function no(rule, what, fix) {
		printf "!\t%s\t%s:%d: %s\t%s\n", rule, rel, FNR, what, fix
		failed = 1
		exit 1
	}
	function flush() { if (path != "" && py && !skip) print "py\t" path }
	FNR == 1 {
		flush()
		path = FILENAME; name = FILENAME; sub(/.*\//, "", name)
		inscripts = substr(path, 1, length(here) + 1) == here "/"
		rel = (inscripts ? "scripts/" : "quality/") name
		selftest = name ~ /-self-test$/
		py = !inscripts || $0 == "#!/usr/bin/env python3"
		header = 1; gates = 0; skip = 0
	}
	header && !/^#/ { header = 0 }
	/^# gates:/ {
		if (!header) no("GATES-PAST-HEADER", "a gates line past the header is read by no one",
			"move it into the run of # lines the file opens with")
		if (!inscripts || selftest) no("GATES-WRONG-FILE", "a gates line outside a tool of scripts/",
			"a *-self-test runs as it is, and only scripts/ holds tools; delete the line")
		if (gates++) no("GATES-TWICE", "a second gates line", "one command per tool; join them with &&")
		cmd = substr($0, 9); sub(/^[ \t]+/, "", cmd); sub(/[ \t]+$/, "", cmd)
		if (cmd == "") no("GATES-EMPTY", "a gates line without a command",
			"name the command that proves the tool")
		print "gate\t" name "\t" cmd
	}
	/^# noslop: skip([ \t]|$)/ {
		if (!header) no("SKIP-PAST-HEADER", "a skip marker past the header is read by no one",
			"move it into the run of # lines the file opens with")
		why = substr($0, 15); sub(/^[ \t]+/, "", why)
		if (why == "") no("SKIP-NO-REASON", "a skip marker without a reason",
			"say why the file is not held to the rules: # noslop: skip <reason>")
		skip = 1
	}
	END { if (!failed) flush() }
' "${files[@]}")" || status=$?
if [ "$status" -ne 0 ]; then
	last="${records##*$'\n'}"
	[ "${last%%$'\t'*}" = "!" ] || refuse GATES-AWK "awk failed (exit $status) without a finding" \
		"run scripts/gates-list under bash -x to see where"
	IFS=$'\t' read -r _ rule what fix <<<"$last"
	refuse "$rule" "$what" "$fix"
fi

if [ "$lint" -eq 1 ]; then
	printf '%s\n' "$records" | sed -n 's/^py	//p'
	exit 0
fi

list="$(
	{
		for t in "$here"/*-self-test; do
			[ -e "$t" ] || continue
			n="${t##*/}"
			# shellcheck disable=SC2016 # $S is written for the recipe to expand
			printf '%s\t$S/%s\n' "$n" "$n"
		done
		printf '%s\n' "$records" | sed -n 's/^gate	//p'
	} | sort -t $'\t' -k1,1 | cut -f2-
)"
[ -n "$list" ] || refuse GATES-NONE "no self-test and no gates line in scripts/" \
	"make gates would prove nothing; check that scripts/ is the harness's"
printf '%s\n' "$list"

#!/usr/bin/env bash
#
# scripts/whoami-check-self-test — proof that scripts/whoami-check reports the three
# identities, nags when an admin account is among them and only then, never prints the
# credential's password, and always exits 0. Run by `make gates`.
#
# The three probes are stand-ins first on PATH: a git whose `credential fill` answers from
# $PUSH (and always adds a password line, which must never reach the output), a gh whose
# `auth status` answers from $GH, an ssh that greets $SSH. An empty value makes that probe
# fail. Where /bin/bash is not the bash running this (a Mac: 3.2), the run is made twice.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/whoami-check-self-test.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/bin"

# The stand-ins expand $PUSH, $GH and $SSH when they run, not when they are written.
# shellcheck disable=SC2016
{
	printf '#!/bin/sh\n[ -n "$PUSH" ] || exit 1\ncat >/dev/null\nprintf "protocol=https\\nhost=github.com\\nusername=%%s\\npassword=SECRET-PW\\n" "$PUSH"\n' >"$tmp/bin/git"
	printf '#!/bin/sh\n[ -n "$GH" ] || exit 1\nprintf "github.com\\n  \\342\\234\\223 Logged in to github.com account other (keyring)\\n  - Active account: false\\n\\n  \\342\\234\\223 Logged in to github.com account %%s (keyring)\\n  - Active account: true\\n" "$GH"\n' >"$tmp/bin/gh"
	printf '#!/bin/sh\n[ -n "$SSH" ] || exit 255\nprintf "Hi %%s! You have successfully authenticated, but GitHub does not provide shell access.\\n" "$SSH"\nexit 1\n' >"$tmp/bin/ssh"
	# timeout is not on a stock Mac; the script must work with or without it.
	printf '#!/bin/sh\nshift\nexec "$@"\n' >"$tmp/bin/timeout"
}
chmod +x "$tmp/bin/"*

fails=0
# expect <bash> <name> <PUSH> <GH> <SSH> <nag: yes|no> <extra grep -F pattern or ''>
expect() {
	local sh="$1" name="$2" out rc=0
	out="$(PATH="$tmp/bin:$PATH" PUSH="$3" GH="$4" SSH="$5" "$sh" "$root/scripts/whoami-check" 2>&1)" || rc=$?
	if [ "$rc" -ne 0 ]; then echo "FAIL $name ($sh): exit $rc"; fails=$((fails + 1)); fi
	case "$out" in *SECRET-PW*) echo "FAIL $name ($sh): the password was printed"; fails=$((fails + 1)) ;; esac
	if [ "$6" = yes ]; then
		case "$out" in *"NAG:"*"psjg-claude"*) : ;; *) echo "FAIL $name ($sh): no NAG"; fails=$((fails + 1)) ;; esac
	else
		case "$out" in *NAG*) echo "FAIL $name ($sh): NAG without an admin account"; fails=$((fails + 1)) ;; esac
	fi
	if [ -n "$7" ]; then
		case "$out" in *"$7"*) : ;; *) echo "FAIL $name ($sh): missing '$7'"; fails=$((fails + 1)) ;; esac
	fi
}

run() {
	local sh="$1"
	expect "$sh" all-admin psjg psjg psjg yes "username=psjg"
	expect "$sh" all-machine psjg-claude psjg-claude psjg-claude no "username=psjg-claude"
	expect "$sh" only-push psjg psjg-claude psjg-claude yes ""
	expect "$sh" only-gh psjg-claude psjg psjg-claude yes "gh:       psjg"
	expect "$sh" only-ssh psjg-claude psjg-claude psjg yes "ssh:      psjg"
	expect "$sh" all-fail "" "" "" no "unknown"
	expect "$sh" mixed-fail psjg-claude "" "" no "username=psjg-claude"
	# The admin list is configurable.
	local out
	out="$(PATH="$tmp/bin:$PATH" PUSH=bob GH=bob SSH=bob FPL_ADMIN_ACCOUNTS="bob" "$sh" "$root/scripts/whoami-check" 2>&1)"
	case "$out" in *NAG*) : ;; *) echo "FAIL admins-env ($sh): no NAG"; fails=$((fails + 1)) ;; esac
	# Without timeout on PATH it still works (a stock Mac).
	rm -f "$tmp/bin/timeout"
	expect "$sh" no-timeout psjg psjg psjg yes "ssh:      psjg"
	printf '#!/bin/sh\nshift\nexec "$@"\n' >"$tmp/bin/timeout"
	chmod +x "$tmp/bin/timeout"
}

# The hook runs it as a message: before the gates, and its failure cannot refuse a push.
hook="$root/.githooks/pre-push"
if ! grep -q 'scripts/whoami-check" >&2 || :$' "$hook"; then
	echo "FAIL hook: .githooks/pre-push does not run scripts/whoami-check as a message"
	fails=$((fails + 1))
fi
if [ "$(grep -n 'scripts/whoami-check' "$hook" | tail -n 1 | cut -d: -f1)" -gt \
	"$(grep -n 'scripts/leak-check' "$hook" | tail -n 1 | cut -d: -f1)" ]; then
	echo "FAIL hook: whoami-check runs after the gates"
	fails=$((fails + 1))
fi

run "$(command -v bash)"
if [ -x /bin/bash ] && [ "$(/bin/bash -c 'echo $BASH_VERSION')" != "$BASH_VERSION" ]; then
	run /bin/bash
fi

if [ "$fails" -ne 0 ]; then echo "whoami-check-self-test: $fails failure(s)"; exit 1; fi
echo "whoami-check-self-test: ok"

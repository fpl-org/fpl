#!/usr/bin/env bash
#
# scripts/present — the presenter's two tools (.claude/agents/presenter.md): ask whether the
# owner has spoken on a pull request, and stamp a series with the line of the session that
# presented it.
#
#   present silent <N>                exit 0 when the owner has posted nothing on pull request
#                                     N: no review, no review comment, no comment in its
#                                     conversation, no comment on a commit of the request.
#                                     Exit 1 when he has, with every URL of his on stdout, one
#                                     a line; 2 when the forge could not be asked. Only exit 0
#                                     is a go.
#   present stamp <base>..HEAD [value] write `Presented-By: <model slug> <session id>` last in
#                                     the trailer block of every commit of the range, by a
#                                     rebase that amends each message and keeps the author and
#                                     the tree. The value is the argument, else the model and
#                                     the session the environment names, read as scripts/acommit
#                                     reads them (FPL_MODEL or CLAUDE_CODE_MODEL, FPL_SESSION_ID
#                                     or CLAUDE_CODE_SESSION_ID). Exit 0 stamped; 1 when a hook
#                                     refused an amend or changed its tree or another line of
#                                     its message, the rebase then undone; 2 usage, or a refusal
#                                     before the rebase.
#
# silent reads, as the machine account, the four places his word can be: pulls/N/reviews,
# pulls/N/comments, issues/N/comments, and commits/<sha>/comments for every commit the forge
# lists under the request (pulls/N/commits: base..head as the forge holds them, which is the
# work tip until the presented one is pushed). His review arrives as commit comments too,
# commit-level and line-level, and GitHub's commit page hides the line-level ones; the API
# serves both. The one line that is not his word is the `@codex review` that a workflow posts
# with his token in the conversation (.github/workflows/codex-review.yml): an issue comment
# whose body is exactly that, nothing around it. It is left aside, and counted in the summary so
# a silent verdict shows what it passed over; the same words in a review, a review comment or a
# commit comment, or with anything around them, are his. The owner is the `*` rule of
# .github/CODEOWNERS as the forge's main holds it when the check runs, read through the API:
# never as a local github/main remembers it, which a change of owner since the last fetch leaves
# behind, and never as the branch judged rewrites it. The machine account is the login inside
# .git/agent-identity; the repository the URL of the remote `github`.
#
# It fails closed: no token for the machine account, a token that is somebody else's, a query
# that fails, an answer of the wrong shape, more commits than one read can list, and the check
# says why and exits 2. The token is taken on a line of its own: in `GH_TOKEN=$(…) gh api …` a
# failed lookup is lost, gh falls back to the machine's active account, and the check would run
# as the owner. Every call names github.com, so GH_HOST cannot send the question to another
# forge, whose silence would mean nothing.
#
# stamp runs `git rebase --exec` with this script's own `_amend` on each commit: the message
# comes out of git and goes back through git, so no message is written to a scratch file, and no
# path reaches the exec line but as printf %q writes it. The `_amend` that runs is a copy, made
# before the rebase, of this script and of .githooks, whose rules it sources, in the git
# directory, where no checkout reaches, named by an absolute path (the exec runs at the top of
# the worktree, wherever the stamp started), and removed on exit: the rebase checks out each
# commit before its exec, and a range that changes this script would otherwise amend its early
# commits with one implementation and its late ones with another, or with none. The soft
# atomicity judge is off for the amend (the diff is unchanged; it ran when the commit was made);
# commit.cleanup is pinned to verbatim for the picks and the amend, so a comment-like line or
# trailing blank of a message survives, and the encoding to UTF-8, as git re-encodes a replayed
# message to i18n.commitEncoding. The rebase moves HEAD alone (--no-update-refs, whatever
# rebase.updateRefs says): another branch pointing into the range is another pull request, whose
# owner's silence this run never asked.
# The trailer block is the one the commit-msg gate reads (commit_trailers, .githooks/
# commit-rules): to the end of the message, a --- line included, with `:` as the only separator.
# An existing Presented-By is replaced, not doubled, and moved last: one presenter a commit, the
# last one. Where the block holds several, all go; interpret-trailers replaces one a call, so
# each extra one is traded for an empty trailer that --trim-empty drops, which drops an empty
# trailer of another key in that block too. A commit whose block already ends with the value is
# left as it is, so stamping twice changes nothing. Placement and the add or replace are given
# on the command line; interpret-trailers runs bare of every trailer.* setting (a key or a
# command for Presented-By), and each amend is read back as the gate reads it: a message that
# does not end with the value then fails it, as under an alias whose key Presented-By prefixes,
# which the gate's own reader applies. It is read back whole too, and must be the message
# written, byte for byte: a hook that rewrites another line, as the commit-msg gate writes a
# trailer key in its own case, fails it. The base is read once, as an id: a fetch that moves a
# base named by a ref while the stamp runs does not move the series. Refused on main, on a dirty
# tree, mid-rebase, on a range that does not end at HEAD or whose base is not an ancestor, on an
# empty range or one with a merge or a message in an encoding other than UTF-8, which the replay
# would re-encode, and where an untracked file stands at a path a commit of the
# range writes or removes, or at one of its directories, in any case where the worktree folds
# case: git takes an ignored file for expendable, and the replay would overwrite or delete it
# without a word. A hook that refuses an amend stops the rebase, and so does one that changes its
# tree, as a formatter that stages what it rewrote: a stamp changes messages only. The rebase is
# aborted, HEAD is where it was, and the refusal is shown.
#
# Plain bash 3.2: no mapfile, no associative arrays. scripts/present-self-test proves each
# case, in throwaway repositories against a gh of its own.
set -euo pipefail

# A replacement ref would make the commands below read another history than the one named.
export GIT_NO_REPLACE_OBJECTS=1

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
repo_root="$(git rev-parse --show-toplevel)"
# shellcheck source=../.githooks/commit-rules
. "${self%/*}/../.githooks/commit-rules"

# die <rule> <what> <remedy>: a refusal names its rule, what failed and what to do; exit 2.
die() {
	printf 'present [%s]: %s\n    remedy: %s\n' "$1" "$2" "$3" >&2
	exit 2
}

# forge <path> [gh api arguments...]: one read of the forge as the machine account, pinned to
# github.com. $tok is the token taken earlier, on its own line.
forge() {
	local path="$1"
	shift
	GH_TOKEN="$tok" gh api --hostname github.com "$@" "repos/$slug/$path"
}

# owner_login: the one login of the `*` rule of .github/CODEOWNERS on the forge's main, the
# last such rule when there are several, as CODEOWNERS reads them; in lower case, as GitHub
# compares logins. Main's file, not the worktree's: the branch judged may rewrite CODEOWNERS,
# and the owner it would name is not the one whose word counts (scripts/land reads main's too).
# The forge's main, not a local github/main: a fetch made before the owner changed would name
# the former one, and his silence would pass for the owner's. Needs $tok and $slug.
owner_login() {
	local text rule who
	text="$(forge "contents/.github/CODEOWNERS?ref=main" --jq '.content | @base64d' 2>/dev/null)" ||
		die owner-unknown "the forge served no .github/CODEOWNERS on main to name the owner" "retry when github.com answers; main names its owner in a rule for *"
	rule="$(printf '%s\n' "$text" | awk '$1 == "*" { r = $0 } END { print r }')"
	# Read by awk, never split by the shell: the * of the rule is a glob to it.
	who="$(printf '%s\n' "$rule" | awk 'NF == 2 { print $2 }')"
	[[ $who =~ ^@[A-Za-z0-9][A-Za-z0-9-]*$ ]] ||
		die owner-unknown "the * rule of .github/CODEOWNERS on the forge's main does not name exactly one @login: '${rule:-none}'" "write it as '* @<login>'"
	printf '%s\n' "${who#@}" | tr '[:upper:]' '[:lower:]'
}

# machine_login: the login inside the noreply address of .git/agent-identity, read by the
# agent-identity beside this script: the checkout that runs the tool, not the one judged.
machine_login() {
	local identity login
	identity="$("${self%/*}/agent-identity" show)" ||
		die machine-unknown "agent identity unset" "scripts/agent-identity set <id>+<login>@users.noreply.github.com"
	login="${identity#*+}"
	login="${login%@*}"
	[ -n "$login" ] && [ "$login" != "$identity" ] ||
		die machine-unknown "cannot read a login from '$identity'" "set the machine account's noreply address (.agents/COMMITS.md)"
	printf '%s\n' "$login"
}

# repo_slug: owner/repo from the URL of the remote `github`.
repo_slug() {
	local url s
	url="$(git remote get-url github 2>/dev/null)" || die forge-unknown "no remote named github" "git remote add github https://github.com/<owner>/<repo>.git"
	s="${url%.git}"
	s="${s#*github.com}"
	s="${s#[:/]}"
	case "$s" in
	*/*) printf '%s\n' "$s" ;;
	*) die forge-unknown "cannot read owner/repo from the URL of github: '$url'" "point the remote at github.com/<owner>/<repo>" ;;
	esac
}

cmd_silent() { # silent <N>
	local n="${1:-}" owner machine who head count list c q kind out line n_word n_aside=0 filter mine
	local reviews=0 review_comments=0 conversation=0 on_commits=0 urls=""
	[ $# -eq 1 ] && [[ $n =~ ^[1-9][0-9]*$ ]] || die usage "a pull request number is needed" "present silent <N>"
	machine="$(machine_login)"
	slug="$(repo_slug)"
	command -v gh >/dev/null || die tooling "no gh on PATH to ask the forge with" "scripts/layer on github, or nix develop .#github -c scripts/present silent $n"
	# On its own line, so that a failed lookup is a refusal and not an empty GH_TOKEN.
	tok="$(gh auth token --hostname github.com --user "$machine" 2>/dev/null)" && [ -n "$tok" ] ||
		die forge-token "gh holds no token for $machine on github.com" "gh auth login --hostname github.com, as $machine"
	who="$(GH_TOKEN="$tok" gh api --hostname github.com user --jq .login 2>/dev/null)" ||
		die forge-query "the forge did not say whose token this is" "retry when github.com answers; gh auth status --hostname github.com"
	[ "$who" = "$machine" ] || die forge-account "the token gh holds for $machine belongs to '$who'" "gh auth login --hostname github.com, as $machine"
	owner="$(owner_login)"

	# The commits of the request, as the forge lists them. One read lists at most 250.
	count="$(forge "pulls/$n" --jq .commits 2>/dev/null)" || die forge-query "the forge did not answer for pulls/$n" "check the number; retry when github.com answers"
	[[ $count =~ ^[0-9]+$ ]] || die forge-shape "pulls/$n does not say how many commits it holds: '$count'" "retry; if it persists, the API changed under this script"
	[ "$count" -le 250 ] || die forge-shape "#$n holds $count commits, more than one read of pulls/$n/commits lists" "present a series of at most 10 commits; split the request"
	list="$(forge "pulls/$n/commits?per_page=100" --paginate --jq '.[].sha' 2>/dev/null)" || die forge-query "the forge did not answer for pulls/$n/commits" "retry when github.com answers"
	[ "$(printf '%s\n' "$list" | grep -c .)" -eq "$count" ] ||
		die forge-shape "pulls/$n says $count commits, pulls/$n/commits lists $(printf '%s\n' "$list" | grep -c .)" "retry; the request may have been pushed to while this read it"

	# His items, each as 'word <url>', or 'aside <url>' for the one automated line that is not
	# his word: in the conversation only, the body exactly as the workflow posts it. The login is
	# a validated word, so it can stand inside the filter; both sides are in lower case, as a
	# login is one account however it is spelled.
	mine='.[] | select(((.user.login // "") | ascii_downcase) == "'"$owner"'")'
	for q in "pulls/$n/reviews" "pulls/$n/comments" "issues/$n/comments" $(for c in $list; do printf 'commits/%s/comments ' "$c"; done); do
		case "$q" in
		issues/*) filter="$mine"' | (if .body == "@codex review" then "aside " else "word " end) + .html_url' ;;
		*) filter="$mine"' | "word " + .html_url' ;;
		esac
		out="$(forge "$q?per_page=100" --paginate --jq "$filter" 2>/dev/null)" ||
			die forge-query "the forge did not answer for $q" "retry when github.com answers; a 404 here means the request or a commit of it is gone"
		n_word=0
		while IFS= read -r line; do
			case "$line" in
			"") ;;
			"aside "*) n_aside=$((n_aside + 1)) ;;
			"word "*) n_word=$((n_word + 1)) urls="$urls${line#word }"$'\n' ;;
			*) die forge-shape "$q answered a line this script does not read: '$line'" "retry; if it persists, the API changed under this script" ;;
			esac
		done <<<"$out"
		case "$q" in
		pulls/*/reviews) reviews=$n_word ;;
		pulls/*/comments) review_comments=$n_word ;;
		issues/*) conversation=$n_word ;;
		commits/*) on_commits=$((on_commits + n_word)) ;;
		esac
	done
	kind="$reviews review(s), $review_comments review comment(s), $conversation conversation comment(s), $on_commits commit comment(s) on $count commit(s); $n_aside '@codex review' line(s) left aside"
	if [ -z "$urls" ]; then
		printf 'present silent: %s is silent on #%s: %s\n' "$owner" "$n" "$kind" >&2
		return 0
	fi
	printf '%s' "$urls"
	printf 'present [owner-spoke]: %s has spoken on #%s: %s\n    remedy: present the history as built, saying why under Limits; a comment of his that asks for this rewrite is its brief, named on the card (.claude/agents/presenter.md)\n' "$owner" "$n" "$kind" >&2
	exit 1
}

# require_clean: index and working tree both equal HEAD. `git diff HEAD` alone misses a change
# staged and then undone in the file, which the rebase would carry or lose.
require_clean() {
	{ git diff --quiet HEAD -- && git diff --cached --quiet -- && git diff --quiet --; } ||
		die dirty "the index or the working tree has uncommitted changes" "commit or set them aside first"
}

# in_the_way <range> <range as named>: refused when an untracked file, ignored or not, stands
# where the replay writes or removes a path: at a path a commit of the range names, under it (the
# path is a file there, so the directory goes), or at one of its directories (the file goes). Git
# refuses to overwrite a plain untracked file mid-rebase, but takes an ignored one for expendable
# and overwrites or deletes it without a word. The paths are every commit's, not base..HEAD's: a
# file the series adds and later drops is written and deleted by the replay too, and --no-renames
# keeps the source of a rename. The disk names the candidates; git says which of them are
# untracked, each candidate a literal pathspec, matched in any case where the worktree folds case
# (core.ignorecase): there the disk finds an ignored config at Config, and a pathspec that tells
# case apart would not. The caller's pathspec settings are set aside, as GIT_LITERAL_PATHSPECS
# would read the magic as part of the path. sed keeps five names and reads the list to its end:
# head would stop reading it, and pipefail would make git's SIGPIPE an exit without a word.
in_the_way() {
	local p d hits magic=':(literal)'
	local -a cands=()
	while IFS= read -r -d '' p; do
		[ -n "$p" ] || continue
		if [ -e "$repo_root/$p" ] || [ -L "$repo_root/$p" ]; then cands+=("$p"); fi
		d="$p"
		while [[ "$d" == */* ]]; do
			d="${d%/*}"
			if [ -L "$repo_root/$d" ] || { [ -e "$repo_root/$d" ] && [ ! -d "$repo_root/$d" ]; }; then cands+=("$d"); fi
		done
	done < <(git log -z --format= --name-only --no-renames "$1")
	[ ${#cands[@]} -gt 0 ] || return 0
	[ "$(git -C "$repo_root" config --type=bool --default=false core.ignorecase)" != true ] || magic=':(literal,icase)'
	hits="$(env -u GIT_LITERAL_PATHSPECS -u GIT_GLOB_PATHSPECS -u GIT_NOGLOB_PATHSPECS -u GIT_ICASE_PATHSPECS \
		git -C "$repo_root" ls-files --others -- "${cands[@]/#/$magic}" | sed -n 1,5p | paste -sd ' ' -)"
	[ -z "$hits" ] ||
		die untracked "untracked files stand where '$2' writes or removes a path, and the replay would overwrite or delete them (an ignored one without a word): $hits" "move them out of the worktree, stamp, and put them back"
}

# default_value: '<slug> <session id>' from the environment, as scripts/acommit derives them.
default_value() {
	local model="${FPL_MODEL:-${CLAUDE_CODE_MODEL:-}}" sid="${FPL_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}" slug
	[ -n "$model" ] && [ -n "$sid" ] ||
		die usage "the model or the session is not known" "present stamp <base>..HEAD '<model slug> <session id>', or set FPL_MODEL and FPL_SESSION_ID"
	slug="$(printf '%s' "$model" | tr '[:upper:] .' '[:lower:]--' | tr -s '-')"
	printf '%s %s\n' "$slug" "$sid"
}

cmd_stamp() { # stamp <base>..HEAD [value]
	local range="${1:-}" base oid tip value exec_cmd err before frozen re='^[a-z0-9][a-z0-9-]* [^[:space:]]+$'
	[ $# -ge 1 ] && [ $# -le 2 ] || die usage "a range is needed" "present stamp <base>..HEAD [value]"
	[[ "$range" == *..* && "$range" != *...* ]] || die range "stamp wants <base>..HEAD, not '$range'" "present stamp <base>..HEAD"
	base="${range%%..*}"
	tip="${range#*..}"
	# The base as an id, read once: a ref that a fetch moves while the stamp runs would have the
	# checks read one history and the rebase replay the series onto another.
	oid="$(git rev-parse -q --verify "$base^{commit}")" || die range "no such base: '$base'" "name a commit this history holds"
	[ "$(git rev-parse -q --verify "$tip^{commit}" 2>/dev/null)" = "$(git rev-parse HEAD)" ] ||
		die range "the range must end at HEAD" "present stamp <base>..HEAD, with the series checked out"
	[ "$(git branch --show-current)" != main ] || die branch "main is never presented" "check out the series, a branch or a detached HEAD"
	[ ! -e "$(git rev-parse --git-path rebase-merge)" ] && [ ! -e "$(git rev-parse --git-path rebase-apply)" ] ||
		die state "a rebase is in progress" "finish or abort it first"
	git merge-base --is-ancestor "$oid" HEAD ||
		die base "'$base' is not an ancestor of HEAD, so the rebase would move the series onto other history" "name the base the series stands on"
	require_clean
	[ -n "$(git rev-list "$oid..HEAD")" ] || die range "the range '$range' holds no commit" "name a non-empty <base>..HEAD"
	[ -z "$(git rev-list --merges "$oid..HEAD")" ] || die range "the range '$range' holds a merge" "a series is linear"
	# A replayed pick is written in i18n.commitEncoding, the message re-encoded, so only UTF-8
	# comes back byte for byte, and the rebase below pins UTF-8 whatever the caller's config says.
	[ -z "$(git log --format=%e "$oid..HEAD" | grep -vixE -e '' -e 'utf-?8')" ] ||
		die encoding "the range '$range' holds a message in an encoding other than UTF-8, which the replay would re-encode" "amend it in UTF-8 first, with i18n.commitEncoding unset"
	in_the_way "$oid..HEAD" "$range"
	if [ $# -eq 2 ]; then value="$2"; else value="$(default_value)" || exit 2; fi
	[[ $value =~ $re ]] ||
		die value "'$value' is not '<model slug> <session id>': a lower-case slug, one space, an id without spaces" "present stamp <base>..HEAD 'claude-opus-5-5 <session id>'"
	before="$(git rev-parse HEAD)"
	# One implementation for the whole rebase, the one asked: a copy in the git directory, which
	# no checkout reaches, while the rebase rewrites the worktree under the exec at every commit.
	frozen="$(mktemp -d "$(git rev-parse --absolute-git-dir)/present-stamp.XXXXXX")" || die tooling "no room in the git directory for the copy of this script" "check that it is writable"
	# shellcheck disable=SC2064 # the path is fixed now; the local is gone by exit
	trap "rm -rf $(printf %q "$frozen")" EXIT
	mkdir "$frozen/scripts"
	cp "$self" "$frozen/scripts/present"
	cp -R "${self%/*}/../.githooks" "$frozen/.githooks"
	printf -v exec_cmd '%q %q _amend %q' "$BASH" "$frozen/scripts/present" "$value"
	# commit.cleanup is pinned for the picks as well as the amend: under strip, the replay of a
	# commit cuts its comment-like lines too, not only the amend does.
	err="$(GIT_SEQUENCE_EDITOR=: git -c commit.cleanup=verbatim -c i18n.commitEncoding=UTF-8 -c i18n.logOutputEncoding=UTF-8 rebase -q --no-autosquash --no-update-refs --exec "$exec_cmd" "$oid" 2>&1)" || {
		printf '%s\n' "$err" >&2
		git rebase --abort >/dev/null 2>&1 || true
		[ "$(git rev-parse HEAD)" = "$before" ] ||
			die rebase "the rebase was refused and could not be undone: HEAD was $before" "git reset --hard $before, once the tree is as you want it"
		printf 'present [rebase]: an amend was refused (above), and the rebase is undone; HEAD is %s again\n    remedy: fix what the message names, then stamp again\n' "$(git rev-parse --short HEAD)" >&2
		exit 1
	}
	printf '%s\n' "$value"
}

# presenters: how many Presented-By the trailer block of the message on stdin holds, as the
# commit-msg gate parses it; in any case, as git matches a key.
presenters() { commit_trailers | grep -ci '^presented-by:' || true; }

# presented <value>: HEAD's trailer block, as the commit-msg gate parses it, holds one
# Presented-By and ends with 'Presented-By: <value>'.
presented() {
	[ "$(git log -1 --format=%B | presenters)" = 1 ] && [ "$(git log -1 --format=%B | commit_trailers | tail -n1)" = "Presented-By: $1" ]
}

# bare_trailers <arguments...>: interpret-trailers under no trailer.* setting of anyone's. Its
# arguments cannot outvote one: trailer.<name>.key remaps any --trailer whose key is a prefix of
# it, and .cmd or .command rewrite the value. So it runs in this script's directory with the
# repository out of reach, and the system, global and command-line config set aside; the
# separator is given here, and the gate's reader, with the repository's config, reads back what
# the amend made.
bare_trailers() {
	(
		cd "${self%/*}" &&
			env -u GIT_DIR -u GIT_WORK_TREE -u GIT_CONFIG_PARAMETERS -u GIT_CONFIG_COUNT \
				GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CEILING_DIRECTORIES="${self%/*/*}" \
				git -c trailer.separators=: interpret-trailers "$@"
	)
}

# _amend <value>: HEAD with 'Presented-By: <value>' last in its trailer block, replacing one that
# is there, and unchanged when it already ends that way. What stamp runs for each commit.
# interpret-trailers runs bare of the caller's config, and the result is read back twice, since a
# hook can still rewrite the message: the way the gate reads it, and whole, byte for byte.
cmd__amend() {
	local msg n tree new
	! presented "$1" || return 0
	tree="$(git rev-parse 'HEAD^{tree}')"
	# The message as git holds it: format:, as --format would end it with one more newline, and
	# the x keeps the trailing blanks that $(...) would cut.
	msg="$(git log -1 --pretty=format:%B; printf x)"
	msg="${msg%x}"
	n="$(printf '%s' "$msg" | presenters)"
	while [ "$n" -gt 1 ]; do
		msg="$(printf '%s' "$msg" | bare_trailers --no-divider --where end --if-exists replace --trim-empty --trailer 'Presented-By:'; printf x)"
		msg="${msg%x}"
		[ "$(printf '%s' "$msg" | presenters)" -lt "$n" ] ||
			die trailer "$(git rev-parse --short HEAD): a Presented-By of its trailer block would not go" "find the hook or the comment character that keeps it"
		n=$((n - 1))
	done
	new="$(printf '%s' "$msg" | bare_trailers --no-divider --where end --if-exists replace --if-missing add --trailer "Presented-By: $1" && printf x)" ||
		die trailer "$(git rev-parse --short HEAD): interpret-trailers did not write the message" "run it on this commit's message by hand to see why"
	new="${new%x}"
	printf '%s' "$new" | FPL_ATOMIC_GATE=off git commit -q --amend --allow-empty --cleanup=verbatim -F -
	[ "$(git rev-parse 'HEAD^{tree}')" = "$tree" ] ||
		die tree "$(git rev-parse --short HEAD): a hook changed the tree in the amend, and a stamp changes messages only" "stamp with the hook that writes or stages files off"
	presented "$1" ||
		die trailer "$(git rev-parse --short HEAD) does not end its trailer block with 'Presented-By: $1' once amended" "find the trailer.* setting or the hook that rewrites the message"
	[ "$(git log -1 --pretty=format:%B; printf x)" = "${new}x" ] ||
		die message "$(git rev-parse --short HEAD): a hook rewrote more of the message than its Presented-By in the amend, and a stamp writes that line only" "amend the commit through the hook first, so its message reads as the hook writes it, then stamp"
}

tok="" slug=""
case "${1:-}" in
silent | stamp | _amend)
	c="cmd_$1"
	shift
	"$c" "$@"
	;;
*) die usage "present {silent <N> | stamp <base>..HEAD [value]}" "see the header of scripts/present" ;;
esac

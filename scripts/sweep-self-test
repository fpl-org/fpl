#!/usr/bin/env bash
#
# scripts/sweep-self-test — proof that scripts/sweep reads a repository without touching it
# (every file checksums the same after a dry run), proposes only what is finished, and removes
# it only when the owner says yes, with what it held saved first: a tag, and the dirty files
# (tracked, staged, untracked) as a patch that gives the worktree back. The fixture has merged,
# rebase-merged, unmerged, dirty and detached worktrees, branches without one, an open pull
# request, the do-not-touch names and a stash. Run by `make gates`.
#
# It runs in a throwaway repository, with Git's config and HOME pointed away from the
# maintainer's, and a stub gh that logs its calls: nothing reaches the network. The suite runs
# once per bash: a bash >= 5 first on PATH, and on a Mac also /bin/bash 3.2. Either missing
# fails the test; on Linux, 3.2 is not covered, and the run says so.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

# --- the driver -----------------------------------------------------------------------------
if [ -z "${SWEEP_SELF_TEST_RUN:-}" ]; then
	tmp="$(mktemp -d "${TMPDIR:-/tmp}/sweep-self-test.XXXXXX")"
	trap 'rm -rf "$tmp"' EXIT
	# shellcheck disable=SC2016 # expanded by the bash asked, not by this one
	major() { "$1" -c 'echo "${BASH_VERSINFO[0]}"' 2>/dev/null || echo 0; }
	bashes="" missing=0
	b5="$(command -v bash || :)"
	if [ -n "$b5" ] && [ "$(major "$b5")" -ge 5 ]; then
		bashes="$b5"
	else
		echo "sweep self-test: needs a bash >= 5 first on PATH (nix develop); found ${b5:-none}" >&2
		missing=1
	fi
	case "$(uname -s)" in
	Darwin)
		[ -x /bin/bash ] && [ "$(major /bin/bash)" -eq 3 ] && bashes="$bashes /bin/bash" ||
			{ echo "sweep self-test: needs /bin/bash 3.2 on a Mac" >&2; missing=1; }
		;;
	*) echo "sweep self-test: bash 3.2 is not covered on $(uname -s); a run on a Mac covers it" ;;
	esac
	[ "$missing" -eq 0 ] || exit 1
	runs=0 failed=0
	for b in $bashes; do
		runs=$((runs + 1))
		# scripts/sweep starts with `#!/usr/bin/env bash`: this bash goes first on PATH.
		mkdir -p "$tmp/bin-$runs"
		ln -s "$b" "$tmp/bin-$runs/bash"
		PATH="$tmp/bin-$runs:$PATH" SWEEP_SELF_TEST_RUN=1 "$b" "$0" || failed=$((failed + 1))
	done
	echo "sweep self-test: $failed of $runs runs failed"
	[ "$failed" -eq 0 ]
	exit
fi

# --- the suite ------------------------------------------------------------------------------
tmp="$(mktemp -d "${TMPDIR:-/tmp}/sweep-self-test.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
: >"$tmp/gitconfig"
export GIT_CONFIG_GLOBAL="$tmp/gitconfig" GIT_CONFIG_NOSYSTEM=1 HOME="$tmp/home" \
	XDG_CONFIG_HOME="$tmp/xdg" GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.invalid \
	GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.invalid TMPDIR="$tmp/scratch"
unset SWEEP_OWNER_YES SWEEP_FORGE SWEEP_FRESH_MIN SWEEP_BASE SWEEP_REPO SWEEP_GH_USER
# shellcheck disable=SC2046 # one variable name per line, no spaces
unset $(git rev-parse --local-env-vars)
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$TMPDIR" "$tmp/stub"
sweep="$root/scripts/sweep"
tab="$(printf '\t')"

# A gh that answers the two calls scripts/sweep may make, and logs every call.
cat >"$tmp/stub/gh" <<EOF
#!/bin/sh
echo "\$*" >>"$tmp/gh.log"
case "\$1 \$2" in
"auth token") echo stub-token-1234 ;;
"pr list") [ "\${GH_TOKEN:-}" = stub-token-1234 ] || exit 3; cat "$tmp/prs.tsv" ;;
*) exit 9 ;;
esac
EOF
chmod +x "$tmp/stub/gh"
export PATH="$tmp/stub:$PATH"

fails=0 total=0
fail() {
	fails=$((fails + 1))
	echo "self-test: $*" >&2
	[ ! -s "$tmp/err" ] || sed 's/^/    err: /' "$tmp/err" >&2
	[ -z "${SWEEP_SELF_TEST_VERBOSE:-}" ] || sed 's/^/    out: /' "$tmp/out" >&2
}
check() { # check <description> <command>
	total=$((total + 1))
	eval "$2" || fail "$1"
}

# --- the fixture ----------------------------------------------------------------------------
repo="$tmp/repo"
g() { git -C "$repo" "$@"; }
mkdir "$repo"
g init -q -b main
printf 'base\n' >"$repo/f.txt"
g add f.txt
g commit -q -m base
# commit_in <dir> <file> <text> <message>
commit_in() {
	printf '%s\n' "$3" >"$1/$2"
	git -C "$1" add "$2"
	git -C "$1" commit -q -m "$4"
}
# wt <path from the repo> <branch>: a worktree on a new branch at main.
wt() {
	mkdir -p "$(dirname "$repo/$1")"
	g worktree add -q "$repo/$1" -b "$2" main
}

wt worktrees/merged agent/claude/stack/merged
commit_in "$repo/worktrees/merged" m.txt m "merged work"
g merge -q --ff-only agent/claude/stack/merged # now an ancestor of main
wt worktrees/rebased agent/claude/stack/rebased
commit_in "$repo/worktrees/rebased" r.txt r "rebased work"
commit_in "$repo" other.txt other "main moves on"
g cherry-pick agent/claude/stack/rebased >/dev/null # the same patch on main: not an ancestor, new = 0
wt worktrees/unmerged agent/claude/stack/unmerged
commit_in "$repo/worktrees/unmerged" u.txt u "unmerged work"
wt worktrees/dirty agent/claude/stack/dirty
printf 'base\nedited\n' >"$repo/worktrees/dirty/f.txt"
printf 'untracked\n' >"$repo/worktrees/dirty/new-untracked.txt"
printf 'staged\n' >"$repo/worktrees/dirty/new-staged.txt"
git -C "$repo/worktrees/dirty" add new-staged.txt
g worktree add -q --detach "$repo/worktrees/detached" main
g worktree add -q "$repo/worktrees/readme" -b stack/readme main
g worktree add -q "$repo/worktrees/a" -b fpl_a main
wt worktrees/fon-bounds agent/claude/stack/fon-bounds
wt .claude/worktrees/app1 claude/app1
wt worktrees/openpr agent/claude/stack/openpr
for b in agent/claude/stack/gone agent/cursor/stack/cursor-harness agent/claude/stack/wip; do g branch "$b" main; done
g branch agent/codex/stack/codex main
g branch agent/claude/stack/onforge main
g symbolic-ref refs/heads/agent/claude/stack/alias refs/heads/main # deleting it would delete main
# a branch without a worktree that holds a commit the base lacks
g worktree add -q --detach "$tmp/tmpwt" main
commit_in "$tmp/tmpwt" w.txt w "work"
g branch -f agent/claude/stack/wip "$(git -C "$tmp/tmpwt" rev-parse HEAD)"
g worktree remove --force "$tmp/tmpwt"
printf 'stashed\n' >>"$repo/f.txt"
g stash -q
printf 'agent/claude/stack/openpr\tOPEN\nagent/claude/stack/onforge\tCLOSED\nagent/claude/stack/onforge\tMERGED\nagent/claude/stack/merged\tMERGED\n' >"$tmp/prs.tsv"
: >"$tmp/gh.log"

# fingerprint: every file of the repository (objects, refs, index, worktrees), one number.
fingerprint() {
	find "$repo" -type f -exec cksum {} + | sort | cksum
}
# sw <args>: scripts/sweep from the repository, output in $tmp/out, exit code in $rc.
sw() {
	rc=0
	(cd "${at:-$repo}" && "$sweep" "$@") >"$tmp/out" 2>"$tmp/err" || rc=$?
}
# col <name> <n>: the n-th field of the row called name in the last output.
col() { awk -F'\t' -v n="$1" -v c="$2" '$2 == n { print $c }' "$tmp/out"; }
action() { col "$1" 9; }

# --- the table ------------------------------------------------------------------------------
export SWEEP_FRESH_MIN=0 SWEEP_REPO=fpl-org/fpl
before="$(fingerprint)"
sw
check "a dry run exits 0" '[ "$rc" -eq 0 ]'
check "a dry run changes nothing" '[ "$(fingerprint)" = "$before" ]'
check "the header names the columns" '[ "$(head -n1 "$tmp/out")" = "kind${tab}name${tab}branch${tab}merged${tab}new${tab}dirty${tab}pr${tab}owner${tab}action${tab}note" ]'
check "merged: an ancestor of main, archive" '[ "$(col worktrees/merged 4)/$(col worktrees/merged 5)/$(action worktrees/merged)" = yes/0/archive ]'
check "rebased: not an ancestor, nothing new by patch, archive" '[ "$(col worktrees/rebased 4)/$(col worktrees/rebased 5)/$(action worktrees/rebased)" = no/0/archive ]'
check "unmerged: one new commit, review" '[ "$(col worktrees/unmerged 5)/$(action worktrees/unmerged)" = 1/review ]'
check "dirty counts tracked, staged and untracked files" '[ "$(col worktrees/dirty 6)/$(action worktrees/dirty)" = 3/archive ]'
check "a detached worktree has no branch and is archive" '[ "$(col worktrees/detached 3)/$(col worktrees/detached 8)/$(action worktrees/detached)" = -/agent/archive ]'
check "the pull request of a branch is its open one, then its merged one" '[ "$(col worktrees/openpr 7)/$(col agent/claude/stack/onforge 7)/$(col worktrees/merged 7)/$(col worktrees/unmerged 7)" = OPEN/MERGED/MERGED/- ]'
check "keep: readme, a, fon-bounds, an app session, an open pull request" '[ "$(action worktrees/readme)/$(action worktrees/a)/$(action worktrees/fon-bounds)/$(action .claude/worktrees/app1)/$(action worktrees/openpr)" = keep/keep/keep/keep/keep ]'
check "the owner of each class" '[ "$(col worktrees/readme 8)/$(col .claude/worktrees/app1 8)/$(col agent/cursor/stack/cursor-harness 8)/$(col agent/codex/stack/codex 8)/$(col worktrees/merged 8)" = PSJ/app-session/Cursor/PSJ/agent ]'
check "a Cursor branch is keep, a Codex branch review" '[ "$(action agent/cursor/stack/cursor-harness)/$(action agent/codex/stack/codex)" = keep/review ]'
check "a branch without a worktree: archive when merged, review when not" '[ "$(action agent/claude/stack/gone)/$(action agent/claude/stack/wip)" = archive/review ]'
check "a symbolic branch ref is review, named for its target" '[ "$(action agent/claude/stack/alias)/$(col agent/claude/stack/alias 10)" = "review/a symbolic ref to main" ]'
check "the root checkout and its branch are not rows" '[ -z "$(col main 1)" ] && ! grep -q "$repo" "$tmp/out"'
check "the footer counts the scope and the stash" 'grep -q "^# scope: 10 worktrees (9 under worktrees/, 1 under .claude/worktrees/, 0 elsewhere), the root checkout not counted; 1 of them dirty" "$tmp/out" && grep -q " 1 stashes (never touched)" "$tmp/out"'
check "the forge is asked once: auth token, then pr list, nothing else" '[ "$(wc -l <"$tmp/gh.log" | tr -d " ")" = 2 ] && grep -q "^auth token --hostname github.com --user psjg-claude" "$tmp/gh.log" && grep -q "^pr list -R github.com/fpl-org/fpl .*--state all" "$tmp/gh.log"'
check "the token is never printed" '! grep -q stub-token "$tmp/out" "$tmp/err"'
: >"$tmp/gh.log"
SWEEP_FORGE=0 sw
check "SWEEP_FORGE=0 asks nothing and leaves pr as ?" '[ ! -s "$tmp/gh.log" ] && [ "$(col worktrees/merged 7)" = "?" ]'

# --- apply: refused ---------------------------------------------------------------------------
before="$(fingerprint)"
sw --apply
check "--apply without SWEEP_OWNER_YES exits 2" '[ "$rc" -eq 2 ]'
check "--apply without SWEEP_OWNER_YES changes nothing" '[ "$(fingerprint)" = "$before" ]'
SWEEP_FORGE=0 SWEEP_OWNER_YES=1 sw --apply
check "--apply without the forge's answer is refused, nothing changed" '[ "$rc" -eq 1 ] && grep -q "needs the forge" "$tmp/err" && [ "$(fingerprint)" = "$before" ]'
mv "$tmp/prs.tsv" "$tmp/prs.full"
awk 'BEGIN { for (i = 0; i < 10000; i++) print "other/" i "\tCLOSED" }' >"$tmp/prs.tsv"
sw
check "a pull request list as long as the limit may be cut short: pr is ?" '[ "$(col worktrees/openpr 7)" = "?" ] && grep -q "forge no full answer" "$tmp/out"'
mv "$tmp/prs.full" "$tmp/prs.tsv"
SWEEP_OWNER_YES=1 sw --apply nosuch
check "a name that picks no archive row is said, nothing changed" 'grep -q "^apply${tab}nosuch${tab}skipped: no archive row" "$tmp/out" && [ "$(fingerprint)" = "$before" ]'
g branch agent/claude/attempt/merged main # a second archive row whose last component is merged
before="$(fingerprint)"
SWEEP_OWNER_YES=1 sw --apply merged
check "a short name that picks two archive rows is said, nothing changed" 'grep -q "^apply${tab}merged${tab}skipped: picks .*merged .*merged; give the full name" "$tmp/out" && [ "$(fingerprint)" = "$before" ]'
g branch -D agent/claude/attempt/merged >/dev/null

# --- apply: an empty name, the checkout that runs sweep ------------------------------------------
before="$(fingerprint)"
SWEEP_OWNER_YES=1 sw --apply ""
check "an empty name selects nothing: refused, nothing changed" '[ "$rc" -eq 1 ] && grep -q "empty name" "$tmp/err" && [ "$(fingerprint)" = "$before" ]'
at="$repo/worktrees/rebased"
sw
check "run from a linked worktree, that worktree is keep, the others as before" '[ "$(action worktrees/rebased)/$(action worktrees/merged)" = keep/archive ] && grep -q "sweep runs here" "$tmp/out"'
SWEEP_OWNER_YES=1 sw --apply rebased
check "--apply from a linked worktree is refused, nothing changed" '[ "$rc" -eq 1 ] && grep -q "apply/root" "$tmp/err" && [ "$(fingerprint)" = "$before" ]'
unset at

# --- apply: one named row, a patch in the way ------------------------------------------------
mkdir -p "$repo/harness/sweep-archive"
printf 'in the way\n' >"$repo/harness/sweep-archive/dirty.patch"
SWEEP_OWNER_YES=1 sw --apply dirty
check "a patch already there fails the row and exits 1" '[ "$rc" -eq 1 ] && grep -q "dirty.patch exists" "$tmp/out"'
check "...and the worktree, its branch and the old patch stay" '[ -d "$repo/worktrees/dirty" ] && g rev-parse -q --verify refs/heads/agent/claude/stack/dirty >/dev/null && [ "$(cat "$repo/harness/sweep-archive/dirty.patch")" = "in the way" ]'
rm -r "$repo/harness"
SWEEP_OWNER_YES=1 sw --apply merged
check "a named row alone is removed" '[ "$rc" -eq 0 ] && [ ! -d "$repo/worktrees/merged" ] && [ -d "$repo/worktrees/rebased" ]'
check "...its branch is deleted and its tag kept at its head" '! g rev-parse -q --verify refs/heads/agent/claude/stack/merged >/dev/null && g rev-parse -q --verify refs/tags/archive/agent/claude/stack/merged >/dev/null'

# --- apply: all -------------------------------------------------------------------------------
main_before="$(g rev-parse main)"
# config a patch must survive: colour even into a file, no a/ b/ prefixes
git config --global color.diff always
git config --global diff.noprefix true
umask 022
SWEEP_OWNER_YES=1 sw --apply
check "--apply exits 0" '[ "$rc" -eq 0 ]'
check "the archive and its patches are private under umask 022" 'ls -ld "$repo/harness" "$repo/harness/sweep-archive" | grep -c "^drwx------" | grep -qx 2 && ls -l "$repo/harness/sweep-archive/dirty.patch" | grep -q "^-rw-------"'
for n in rebased dirty detached; do
	check "$n: removed" '[ ! -d "$repo/worktrees/'"$n"'" ]'
done
check "the rebased branch is tagged at its head, then deleted" '! g rev-parse -q --verify refs/heads/agent/claude/stack/rebased >/dev/null && g rev-parse -q --verify refs/tags/archive/agent/claude/stack/rebased >/dev/null'
check "a detached worktree is tagged archive/worktree/<name>" 'g rev-parse -q --verify refs/tags/archive/worktree/detached >/dev/null'
check "a branch without a worktree is tagged, then deleted" '! g rev-parse -q --verify refs/heads/agent/claude/stack/gone >/dev/null && g rev-parse -q --verify refs/tags/archive/agent/claude/stack/gone >/dev/null'
check "the dirty patch holds the tracked, staged and untracked files" 'p="$repo/harness/sweep-archive/dirty.patch"; [ -s "$p" ] && grep -q "^+edited" "$p" && grep -q "^+untracked" "$p" && grep -q "^+staged" "$p"'
git clone -q "$repo" "$tmp/v"
git -C "$tmp/v" checkout -q archive/agent/claude/stack/dirty
git -C "$tmp/v" apply "$repo/harness/sweep-archive/dirty.patch"
check "the patch over the tagged commit gives back the files" '[ "$(cat "$tmp/v/f.txt")" = "$(printf "base\nedited")" ] && [ "$(cat "$tmp/v/new-untracked.txt")" = untracked ] && [ "$(cat "$tmp/v/new-staged.txt")" = staged ]'
check "the do-not-touch rows stay, worktrees and branches" '[ -d "$repo/worktrees/readme" ] && [ -d "$repo/worktrees/a" ] && [ -d "$repo/worktrees/fon-bounds" ] && [ -d "$repo/.claude/worktrees/app1" ] && g rev-parse -q --verify refs/heads/agent/cursor/stack/cursor-harness >/dev/null && g rev-parse -q --verify refs/heads/stack/readme >/dev/null && g rev-parse -q --verify refs/heads/fpl_a >/dev/null'
check "the review and keep rows stay" '[ -d "$repo/worktrees/unmerged" ] && [ -d "$repo/worktrees/openpr" ] && g rev-parse -q --verify refs/heads/agent/claude/stack/wip >/dev/null && g rev-parse -q --verify refs/heads/agent/codex/stack/codex >/dev/null'
check "main did not move, the stash is still there" '[ "$(g rev-parse main)" = "$main_before" ] && [ "$(g stash list | wc -l | tr -d " ")" = 1 ]'
check "the symbolic ref still points to main" '[ "$(g symbolic-ref -q refs/heads/agent/claude/stack/alias)" = refs/heads/main ]'
sw
check "after the sweep nothing is left to archive" '! grep -q "${tab}archive${tab}" "$tmp/out"'
# names no tag can carry: below a tag of the same path, and with a space
g branch agent/claude/stack/dfx main
SWEEP_OWNER_YES=1 sw --apply agent/claude/stack/dfx
g branch agent/claude/stack/dfx/tip main
g worktree add -q --detach "$repo/worktrees/my work" main
SWEEP_OWNER_YES=1 sw --apply agent/claude/stack/dfx/tip "my work"
check "a branch below an archived one and a name with a space are tagged by their commit id" '[ "$rc" -eq 0 ] && [ ! -d "$repo/worktrees/my work" ] && ! g rev-parse -q --verify refs/heads/agent/claude/stack/dfx/tip >/dev/null && [ "$(g rev-parse refs/tags/archive/sha/"$main_before")" = "$main_before" ] && [ "$(grep -c "removed; tag archive/sha/" "$tmp/out")" = 2 ]'

# --- fresh ------------------------------------------------------------------------------------
g worktree add -q "$repo/worktrees/young" -b agent/claude/stack/young main
g worktree add -q "$repo/worktrees/old" -b agent/claude/stack/old main
printf 'x\n' >"$repo/worktrees/young/loose.txt"
unset SWEEP_FRESH_MIN
sw
check "a worktree touched a moment ago is review, not archive" '[ "$(action worktrees/young)/$(action worktrees/old)" = review/review ] && grep -q "touched in the last 60 min" "$tmp/out"'
SWEEP_FRESH_MIN=08 sw
check "SWEEP_FRESH_MIN=08 is eight minutes, not a bad octal number" '[ "$rc" -eq 0 ] && grep -q "touched in the last 8 min" "$tmp/out"'
old_gitdir="$(git -C "$repo/worktrees/old" rev-parse --absolute-git-dir)"
touch -t 202001010000 "$old_gitdir/HEAD"
sw
check "once old enough, archive; the one still young stays review" '[ "$(action worktrees/old)/$(action worktrees/young)" = archive/review ]'
# index-only work: a deleted file leaves no file to date, a staged mode change leaves an old one
for n in deleted staged; do
	g worktree add -q "$repo/worktrees/$n" -b "agent/claude/stack/$n" main
	touch -t 202001010000 "$(git -C "$repo/worktrees/$n" rev-parse --absolute-git-dir)/HEAD"
done
rm "$repo/worktrees/deleted/f.txt"
touch -t 202001010000 "$(git -C "$repo/worktrees/deleted" rev-parse --absolute-git-dir)/index"
touch -t 202001010000 "$repo/worktrees/staged/f.txt"
git -C "$repo/worktrees/staged" update-index --chmod=+x f.txt
sw
check "a deleted file and a staged change count as recent work" '[ "$(action worktrees/deleted)/$(action worktrees/staged)" = review/review ]'
# a chmod moves only the change time; touch -t sets the modification time back as well
g worktree add -q "$repo/worktrees/chmodded" -b agent/claude/stack/chmodded main
chmod +x "$repo/worktrees/chmodded/f.txt"
gd="$(git -C "$repo/worktrees/chmodded" rev-parse --absolute-git-dir)"
touch -t 202001010000 "$repo/worktrees/chmodded/f.txt" "$gd/HEAD" "$gd/index"
sw
check "a file whose mode changed a moment ago counts as recent work" '[ "$(action worktrees/chmodded)" = review ]'
# a clean worktree goes without --force, ignored files with it
printf 'ignored.log\n' >"$repo/.git/info/exclude"
printf 'x\n' >"$repo/worktrees/old/ignored.log"
SWEEP_OWNER_YES=1 sw --apply old
check "a clean worktree holding an ignored file is removed, no patch made" '[ "$rc" -eq 0 ] && [ ! -d "$repo/worktrees/old" ] && [ ! -e "$repo/harness/sweep-archive/old.patch" ]'

# --- apply: another session moves in between the table and the removal ---------------------------
# A git that runs $SWEEP_RACE once, just before the git command $SWEEP_RACE_AT (default tag, made
# after the checks of a row; stash, run once by the footer, comes after the table).
mkdir -p "$tmp/race"
cat >"$tmp/race/git" <<EOF
#!/bin/sh
if [ "\$1" = "\${SWEEP_RACE_AT:-tag}" ] && [ -n "\${SWEEP_RACE:-}" ] && [ ! -e "$tmp/raced" ]; then : >"$tmp/raced"; sh -c "\$SWEEP_RACE"; fi
exec "$(command -v git)" "\$@"
EOF
chmod +x "$tmp/race/git"
g branch agent/claude/stack/racebr main
g worktree add -q "$repo/worktrees/racewt" -b agent/claude/stack/racewt main
touch -t 202001010000 "$(git -C "$repo/worktrees/racewt" rev-parse --absolute-git-dir)/HEAD"
rm -f "$tmp/raced"
export SWEEP_RACE="git -C '$repo' update-ref refs/heads/agent/claude/stack/racebr \$(git -C '$repo' commit-tree -p agent/claude/stack/racebr -m race 'main^{tree}')"
PATH="$tmp/race:$PATH" SWEEP_OWNER_YES=1 sw --apply racebr
check "a branch without a worktree that moved meanwhile is not deleted" '[ "$rc" -eq 1 ] && grep -q "branch delete" "$tmp/out" && [ "$(g rev-list --count main..agent/claude/stack/racebr)" = 1 ]'
rm -f "$tmp/raced"
export SWEEP_RACE="printf 'late\n' >'$repo/worktrees/racewt/late.txt'"
PATH="$tmp/race:$PATH" SWEEP_OWNER_YES=1 sw --apply racewt
check "a clean worktree dirtied meanwhile is left with its file" '[ "$rc" -eq 1 ] && [ "$(cat "$repo/worktrees/racewt/late.txt")" = late ] && g rev-parse -q --verify refs/heads/agent/claude/stack/racewt >/dev/null'
# Another run writes the patch between the test that it is absent and the write: a mkdir that
# makes it first. The write must not replace it, and the worktree must stay.
g worktree add -q "$repo/worktrees/clobber" -b agent/claude/stack/clobber main
printf 'mine\n' >"$repo/worktrees/clobber/c.txt"
mkdir -p "$tmp/racemk"
cat >"$tmp/racemk/mkdir" <<EOF
#!/bin/sh
"$(command -v mkdir)" "\$@" && printf 'theirs\n' >"$repo/harness/sweep-archive/clobber.patch"
EOF
chmod +x "$tmp/racemk/mkdir"
PATH="$tmp/racemk:$PATH" SWEEP_FRESH_MIN=0 SWEEP_OWNER_YES=1 sw --apply clobber
check "a patch another run wrote meanwhile is not overwritten, and the worktree stays" '[ "$rc" -eq 1 ] && grep -q "could not create" "$tmp/out" && [ "$(cat "$repo/harness/sweep-archive/clobber.patch")" = theirs ] && [ "$(cat "$repo/worktrees/clobber/c.txt")" = mine ]'
g worktree remove --force "$repo/worktrees/clobber" && g branch -q -D agent/claude/stack/clobber && rm "$repo/harness/sweep-archive/clobber.patch"
unset SWEEP_RACE

# --- apply: what a removal must not take with it -------------------------------------------------
# The race commands run inside the git sweep calls: keep them off any repository its environment names.
ng="env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git"
g branch agent/claude/stack/symbr main
rm -f "$tmp/raced"
SWEEP_RACE_AT=stash SWEEP_RACE="$ng -C '$repo' symbolic-ref refs/heads/agent/claude/stack/symbr refs/heads/main" \
	PATH="$tmp/race:$PATH" SWEEP_FRESH_MIN=0 SWEEP_OWNER_YES=1 sw --apply symbr
check "a branch that became a symbolic ref is not deleted, nor its target" '[ "$rc" -eq 1 ] && grep -q "symbolic ref now" "$tmp/out" && [ "$(g rev-parse main)" = "$main_before" ] && [ "$(g symbolic-ref -q refs/heads/agent/claude/stack/symbr)" = refs/heads/main ]'
g branch agent/claude/stack/symtag main
rm -f "$tmp/raced"
SWEEP_RACE="$ng -C '$repo' symbolic-ref refs/heads/agent/claude/stack/symtag refs/heads/main" \
	PATH="$tmp/race:$PATH" SWEEP_FRESH_MIN=0 SWEEP_OWNER_YES=1 sw --apply symtag
check "a branch that became a symbolic ref while being tagged does not take main with it" '[ "$(g rev-parse -q --verify refs/heads/main)" = "$main_before" ] && g rev-parse -q --verify refs/tags/archive/agent/claude/stack/symtag >/dev/null'
g worktree add -q --detach "$repo/worktrees/movewt" main
rm -f "$tmp/raced"
SWEEP_RACE="$ng -C '$repo/worktrees/movewt' commit -q --allow-empty -m moved" \
	PATH="$tmp/race:$PATH" SWEEP_FRESH_MIN=0 SWEEP_OWNER_YES=1 sw --apply movewt
check "a detached worktree that moved on while being tagged is left, not removed with its new commit" '[ "$rc" -eq 1 ] && grep -q "head moved while being saved" "$tmp/out" && [ "$(git -C "$repo/worktrees/movewt" log -1 --format=%s)" = moved ]'
g branch agent/claude/stack/occupied main
rm -f "$tmp/raced"
SWEEP_RACE="$ng -C '$repo' worktree add -q '$repo/worktrees/occupy' agent/claude/stack/occupied" \
	PATH="$tmp/race:$PATH" SWEEP_FRESH_MIN=0 SWEEP_OWNER_YES=1 sw --apply occupied
check "a branch checked out meanwhile is not deleted; its worktree's head resolves" '[ "$rc" -eq 1 ] && grep -q "checked out meanwhile" "$tmp/out" && git -C "$repo/worktrees/occupy" rev-parse -q --verify HEAD >/dev/null'
g branch agent/claude/stack/rebasing main
gd="$(git -C "$repo/worktrees/unmerged" rev-parse --absolute-git-dir)" # a rebase there detaches its head
rm -f "$tmp/raced"
SWEEP_RACE="mkdir '$gd/rebase-merge' && echo refs/heads/agent/claude/stack/rebasing >'$gd/rebase-merge/head-name'" \
	PATH="$tmp/race:$PATH" SWEEP_FRESH_MIN=0 SWEEP_OWNER_YES=1 sw --apply rebasing
check "a branch a worktree rebases is not deleted" '[ "$rc" -eq 1 ] && grep -q "checked out meanwhile" "$tmp/out" && g rev-parse -q --verify refs/heads/agent/claude/stack/rebasing >/dev/null'
rm -rf "$gd/rebase-merge"
g worktree add -q "$repo/worktrees/embedded" -b agent/claude/stack/embedded main
printf 'x\n' >"$repo/worktrees/embedded/loose.txt"
git init -q "$repo/worktrees/embedded/inner"
SWEEP_FRESH_MIN=0 sw
check "a worktree holding an untracked repository is review" '[ "$(action worktrees/embedded)" = review ] && col worktrees/embedded 10 | grep -q "holds a repository at inner"'

# --- a merge commit is not a patch ---------------------------------------------------------------
# A branch whose only commit by patch is in the base, plus a merge with a change of its own, is
# not "all in the base": git cherry skips the merge. SWEEP_BASE keeps main where the checks above
# left it.
g branch basebr main
g worktree add -q --detach "$tmp/mw1" main
commit_in "$tmp/mw1" side.txt side "side work"
g worktree add -q "$tmp/mw2" basebr
commit_in "$tmp/mw2" side.txt side "side work" # the same patch, in the base
printf 'resolution\n' >"$tmp/mw1/merge-only.txt"
git -C "$tmp/mw1" add merge-only.txt
g branch agent/claude/stack/mergey "$(git -C "$tmp/mw1" commit-tree -p HEAD -p main -m merge "$(git -C "$tmp/mw1" write-tree)")"
g branch agent/claude/stack/plainside "$(git -C "$tmp/mw1" rev-parse HEAD)"
SWEEP_BASE=basebr SWEEP_FRESH_MIN=0 sw
check "a branch whose merge commit is not in the base is review, its patch-equal twin without the merge is archive" '[ "$(col agent/claude/stack/mergey 5)/$(action agent/claude/stack/mergey)/$(col agent/claude/stack/plainside 5)/$(action agent/claude/stack/plainside)" = 1/review/0/archive ]'
SWEEP_BASE=agent/claude/stack/plainside SWEEP_FRESH_MIN=0 sw
check "the branch named as the base is keep, not an archive row of itself" '[ "$(action agent/claude/stack/plainside)/$(col agent/claude/stack/plainside 10)" = "keep/the base" ]'
g worktree add -q --detach "$tmp/elsewhere" main
g worktree add -q --detach "$HOME/.cursor/worktrees/fpl/c1" main
SWEEP_FRESH_MIN=0 sw
real="$(cd "$tmp" && pwd -P)" # git lists a worktree by its real path
check "a detached worktree outside worktrees/ is PSJ's and review, one under .cursor Cursor's and keep" '[ "$(col "$real/elsewhere" 8)/$(action "$real/elsewhere")/$(col "$real/home/.cursor/worktrees/fpl/c1" 8)/$(action "$real/home/.cursor/worktrees/fpl/c1")" = PSJ/review/Cursor/keep ]'

if [ "$fails" -eq 0 ]; then
	echo "sweep self-test: $total checks passed (bash ${BASH_VERSION%%(*})"
else
	echo "sweep self-test: $fails of $total checks failed (bash ${BASH_VERSION%%(*})" >&2
	exit 1
fi

#!/usr/bin/env bash
#
# scripts/series-self-test — proof that the identity of a series still holds: the Series-Id
# trailer is accepted once and in its place by .githooks/commit-msg, and scripts/series mints it
# deterministically, stamps it onto a range without changing a patch, refuses to stamp once the
# maintainer has spoken, checks it, writes a byte-stable manifest and prints its digest alone.
# Run by `make gates`.
#
# Everything happens in a throwaway repository, with Git's global and system config, HOME and
# XDG_CONFIG_HOME pointed away from the maintainer's, and a stub gh in place of the forge. The
# run counts what it was asked and what it got: a refusal that never came, or a pass that should
# not have been, fails the test. Runs under any bash, 3.2 included; the script under test runs
# under the bash that runs this.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/series-self-test.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
: >"$tmp/gitconfig"
export GIT_CONFIG_GLOBAL="$tmp/gitconfig" GIT_CONFIG_NOSYSTEM=1 HOME="$tmp/home" \
	XDG_CONFIG_HOME="$tmp/xdg" GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.invalid \
	GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.invalid FPL_LEAK_GATE=off \
	FPL_ATOMIC_GATE=off FPL_MAIN_GATE=off SERIES_GH="$tmp/gh" \
	FPL_MODEL="Claude Test 1" FPL_SESSION_ID=series-self-test
unset FPL_BRANCH_GATE FPL_AGENT_EMAILS FPL_LINT_BRANCH FPL_LINT_COMMIT GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE
mkdir -p "$HOME" "$XDG_CONFIG_HOME"

# The forge: a stub gh that answers the GETs scripts/series makes from STUB_* variables.
cat >"$tmp/gh" <<'EOF'
#!/usr/bin/env bash
echo "$*" >>"${STUB_LOG:-/dev/null}"
case "$*" in
"auth token"*) [ -z "${STUB_NOTOKEN:-}" ] || exit 1; echo token ;;
*"pulls?state=all"*"stack/demo-1"*) echo "${STUB_PR_B:-}" ;;
*"pulls?state=all"*) echo "${STUB_PR:-}" ;;
*"pulls/9/reviews"*) echo "${STUB_REVIEWS_9:-}" ;;
*reviews*) if [ -n "${STUB_REVIEWS_FILE:-}" ]; then cat "$STUB_REVIEWS_FILE"; else echo "${STUB_REVIEWS:-}"; fi ;;
*) echo "${STUB_COMMENTS:-}" ;;
esac
EOF
chmod +x "$tmp/gh"

repo="$tmp/repo"
git init -q -b main "$repo"
cd "$repo"
cp -R "$root/.githooks" "$root/scripts" .
git add -A
git -c core.hooksPath=/dev/null commit -q -m "chore(harness): base" -m "Human-Only: true"
scripts/agent-identity set bot@example.invalid >/dev/null
git config core.hooksPath .githooks
git switch -q -c agent/claude/stack/demo
base0="$(git rev-parse HEAD)"

fails=0 total=0
# verdict <what> <rc> <want> <text>: the exit code is the wanted one and the output holds the text.
verdict() {
	local what="$1" rc="$2" want="$3" text="$4"
	total=$((total + 1))
	if [ "$rc" -ne "$want" ]; then
		fails=$((fails + 1)); echo "self-test: $what: exit $rc, want $want" >&2; sed 's/^/    /' "$tmp/out" >&2
	elif [ -n "$text" ] && ! grep -Fq -- "$text" "$tmp/out"; then
		fails=$((fails + 1)); echo "self-test: $what: output lacks '$text'" >&2; sed 's/^/    /' "$tmp/out" >&2
	fi
}
# sr <want> <what> <text> <args>...: scripts/series with these arguments; output in $tmp/out.
sr() {
	local want="$1" what="$2" text="$3" rc=0
	shift 3
	"$BASH" scripts/series "$@" >"$tmp/out" 2>&1 || rc=$?
	verdict "series $what" "$rc" "$want" "$text"
}
# same <what> <a> <b>: two values are equal.
same() { printf '%s' "$2" >"$tmp/out"; verdict "$1" "$([ "$2" = "$3" ] && echo 0 || echo 1)" 0 ""; }
differ() { printf '%s' "$2" >"$tmp/out"; verdict "$1" "$([ "$2" != "$3" ] && echo 0 || echo 1)" 0 ""; }
# mk <file> <Series-Id or ->: a human commit on the branch adding <file>, with a Stack: and, where given, a Series-Id.
mk() {
	echo "$1" >"$1"; git add "$1"
	{ printf 'feat(demo): add %s\n\nBody of %s.\n# a comment-like line, kept verbatim\n\nStack: demo\n' "$1" "$1"; [ "$2" = - ] || echo "Series-Id: $2"; echo "Human-Only: true"; } >"$tmp/m"
	git commit -q -F "$tmp/m"
}
patch_ids() { grep -o '"patch_id": [^,]*' "$tmp/out"; }

mk f1 -; mk f2 -; mk f3 -
tip0="$(git rev-parse HEAD)"

# --- mint -------------------------------------------------------------------------------------
sr 0 "mint" "demo-${tip0:0:7}" mint agent/claude/stack/demo
id="$(cat "$tmp/out")"
sr 0 "mint is deterministic" "$id" mint agent/claude/stack/demo

# --- check, manifest: before any stamp -------------------------------------------------------------
sr 1 "check refuses an unstamped range" "series-missing" check "$base0..HEAD"
sr 1 "manifest refuses an empty range" "range" manifest "HEAD..HEAD"
sr 1 "manifest refuses an unknown base" "range" manifest "nosuch..HEAD"
sr 0 "manifest" '"digest"' manifest "$base0..HEAD"
cp "$tmp/out" "$tmp/man0"
sr 0 "manifest, again" "" manifest "$base0..HEAD"
verdict "manifest is byte-stable" "$(cmp -s "$tmp/out" "$tmp/man0" && echo 0 || echo 1)" 0 ""
# digest: the manifest's digest alone, one line, as scripts/land reads it for the fpl/series
# receipt; and from a copy outside the tree, where the lander runs main's scripts/series.
d0="$(grep -o '"digest": "[0-9a-f]*"' "$tmp/man0" | cut -d'"' -f4)"
sr 0 "digest" "$d0" digest "$base0..HEAD"
cp "$tmp/out" "$tmp/dig" # same writes $tmp/out: read the answer from a copy
same "digest prints the manifest's digest and nothing else" "$(cat "$tmp/dig")" "$d0"
same "digest prints one line" "$(wc -l <"$tmp/dig" | tr -d ' ')" 1
cp scripts/series "$tmp/series.copy"
"$BASH" "$tmp/series.copy" digest "$base0..HEAD" >"$tmp/out" 2>&1 && rc=0 || rc=$?
verdict "digest from a copy outside the tree, as the lander runs it" "$rc" 0 "$d0"
sr 1 "digest refuses an empty range" "range" digest "HEAD..HEAD"
same "a refused digest prints nothing on stdout" "$("$BASH" scripts/series digest HEAD..HEAD 2>/dev/null || true)" ""

# --- stamp: the forge's say first -----------------------------------------------------------------
export STUB_PR=7 STUB_LOG="$tmp/gh.log"
for kind in STUB_REVIEWS STUB_COMMENTS; do
	env "$kind=psjg" "$BASH" scripts/series stamp "$base0..HEAD" >"$tmp/out" 2>&1 && rc=0 || rc=$?
	verdict "stamp refuses when the owner is in $kind" "$rc" 1 "owner-spoke"
done
# The owner is the first of a long answer (well over a pipe's buffer): the match must not leave early.
awk 'BEGIN { print "psjg"; for (i = 0; i < 40000; i++) print "someone" }' >"$tmp/long"
STUB_REVIEWS_FILE="$tmp/long" "$BASH" scripts/series stamp "$base0..HEAD" >"$tmp/out" 2>&1 && rc=0 || rc=$?
verdict "stamp refuses when the owner heads a long answer" "$rc" 1 "owner-spoke"
STUB_NOTOKEN=1 "$BASH" scripts/series stamp "$base0..HEAD" >"$tmp/out" 2>&1 && rc=0 || rc=$?
verdict "stamp refuses blind (no token)" "$rc" 1 "forge-token"
# The owner's latest review decides: one that requests changes asks for the rewrite; an approval
# or a plain review after it does not. A review row is login, state, id, tab-separated.
tab="$(printf '\t')"
STUB_REVIEWS="psjg${tab}APPROVED${tab}31" sr 1 "stamp refuses after the owner's approval" \
	"review 31, APPROVED" stamp "$base0..HEAD"
STUB_REVIEWS="psjg${tab}CHANGES_REQUESTED${tab}32
psjg${tab}APPROVED${tab}33" sr 1 "stamp refuses when his approval follows his request" \
	"review 33, APPROVED" stamp "$base0..HEAD"
STUB_REVIEWS="psjg${tab}CHANGES_REQUESTED${tab}34
psjg${tab}COMMENTED${tab}35" sr 1 "stamp refuses when his plain review follows his request" \
	"review 35, COMMENTED" stamp "$base0..HEAD"
same "every forge call names github.com" "$(grep -vc -e '--hostname github.com' "$tmp/gh.log" || true)" 0
same "every pull request discovery reads all pages" "$(grep -e 'pulls?state=all' "$tmp/gh.log" | grep -vc -e '--paginate' || true)" 0
differ "the forge was asked" "$(wc -l <"$tmp/gh.log" | tr -d ' ')" 0
same "the refused stamps left the branch alone" "$(git rev-parse HEAD)" "$tip0"
# A boundary branch inside the range moves with the rebase (--update-refs): its pull request is
# asked too, and the owner's word on it refuses the stamp although the tip's is silent.
git branch agent/claude/stack/demo-1 HEAD~1
STUB_PR_B=9 STUB_REVIEWS_9=psjg "$BASH" scripts/series stamp "$base0..HEAD" >"$tmp/out" 2>&1 && rc=0 || rc=$?
verdict "stamp refuses when the owner is on a boundary branch's pull request" "$rc" 1 "owner-spoke"
same "the refused stamp left the tip alone" "$(git rev-parse HEAD)" "$tip0"
same "the refused stamp left the boundary alone" "$(git rev-parse agent/claude/stack/demo-1)" "$(git rev-parse HEAD~1)"
git switch -q main
sr 1 "stamp refuses main" "branch" stamp "$base0..HEAD"
git switch -q agent/claude/stack/demo
# A change staged and then undone in the file: the tree equals HEAD, the index does not.
echo staged >>f1; git add f1; git show HEAD:f1 >f1
sr 1 "stamp refuses a staged change the tree no longer shows" "dirty" stamp "$base0..HEAD"
git reset -q
# A base off this branch: a rebase onto it would move the series onto other history.
side="$(git commit-tree -p "$base0" -m side "$(git rev-parse "$base0^{tree}")")"
sr 1 "stamp refuses a base that is not an ancestor of HEAD" "not an ancestor" stamp "$side..HEAD"
same "the refused stamp left the tip alone (no ancestor)" "$(git rev-parse HEAD)" "$tip0"

# --- stamp: the identity goes on, the patches do not change ----------------------------------------
GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=commit.cleanup GIT_CONFIG_VALUE_0=strip \
	STUB_REVIEWS=someone-else sr 0 "stamp" "$id" stamp "$base0..HEAD"
same "stamp moved the boundary branch with the series" "$(git rev-parse agent/claude/stack/demo-1)" "$(git rev-parse HEAD~1)"
git branch -q -D agent/claude/stack/demo-1
same "stamp keeps a comment-like line under commit.cleanup=strip" "$(git log --format=%B "$base0..HEAD" | grep -c '^# a comment-like')" 3
sr 0 "check after stamp" "$id" check "$base0..HEAD"
sr 0 "manifest after stamp" "" manifest "$base0..HEAD"
same "stamp leaves every patch id alone" "$(patch_ids)" "$(grep -o '"patch_id": [^,]*' "$tmp/man0")"
differ "stamp changes the message hashes" "$(grep -o '"digest".*' "$tmp/out")" "$(grep -o '"digest".*' "$tmp/man0")"
same "the id sits after Stack:" "$(git log -1 --format=%B | sed -n '/^Stack:/{n;p;}')" "Series-Id: $id"
same "no Patch-Id trailer anywhere" "$(git log --format=%B "$base0..HEAD" | grep -ci '^patch-id' || true)" 0
tip1="$(git rev-parse HEAD)"
STUB_REVIEWS=someone-else sr 0 "stamp again" "$id" stamp "$base0..HEAD"
same "stamp is idempotent" "$(git rev-parse HEAD)" "$tip1"
# His latest review requests changes, after an approval of his and another's: the stamp goes on,
# names the review, and a comment of his does not withdraw the request. The commit it stamps is
# taken off again: what follows reads the series as it was.
mk f9 -
STUB_REVIEWS="psjg${tab}APPROVED${tab}36
someone-else${tab}APPROVED${tab}37
PSJG${tab}CHANGES_REQUESTED${tab}38" STUB_COMMENTS=psjg sr 0 "stamp when his latest review requests changes" \
	"in review 38, his latest" stamp "$base0..HEAD"
sr 0 "check after the requested stamp" "$id" check "$base0..HEAD"
git reset -q --hard "$tip1"

# --- the manifest is the landed history, whatever the clone's config and replacement refs say ------
sr 0 "manifest to compare" "" manifest "$base0..HEAD"
man1="$(cat "$tmp/out")"
mid="$(git rev-parse HEAD~1)"
git replace -f "$mid" "$base0"
sr 0 "manifest under a replacement ref" "" manifest "$base0..HEAD"
git replace -d "$mid" >/dev/null
same "a replacement ref does not change the manifest" "$(cat "$tmp/out")" "$man1"
# A change whose hunk can slide: its patch id differs with the indent heuristic on and off.
git switch -q -c agent/claude/stack/slide "$base0"
printf '\n}\n\tx;\n{\n\tx;\n\ty;\n' >slide; git add slide
git -c core.hooksPath=/dev/null commit -q -m "chore(demo): slide" -m "Human-Only: true"
slide0="$(git rev-parse HEAD)"
printf '\n}\nif (a) {\n\n}\n\tx;\n{\n\tx;\n\ty;\n' >slide
git -c core.hooksPath=/dev/null commit -q -a -m "chore(demo): slide more" -m "Human-Only: true"
pid_with="$(git diff-tree -p --indent-heuristic HEAD | git patch-id --verbatim | cut -c1-40)"
pid_without="$(git diff-tree -p --no-indent-heuristic HEAD | git patch-id --verbatim | cut -c1-40)"
differ "the fixture really is sensitive to the indent heuristic" "$pid_with" "$pid_without"
sr 0 "manifest of the sliding change" "" manifest "$slide0..HEAD"
man2="$(cat "$tmp/out")"
for v in true false; do
	GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=diff.indentHeuristic GIT_CONFIG_VALUE_0=$v "$BASH" scripts/series manifest "$slide0..HEAD" >"$tmp/out" 2>&1
	same "diff.indentHeuristic=$v does not change the manifest" "$(cat "$tmp/out")" "$man2"
done
# A blank context line: with diff.suppressBlankEmpty it loses its leading space, and the plain
# patch id changes (it can even come out as two ids).
git switch -q -c agent/claude/stack/blank "$base0"
printf 'a\n\nb\n\nc\n' >blank; git add blank
git -c core.hooksPath=/dev/null commit -q -m "chore(demo): blank" -m "Human-Only: true"
blank0="$(git rev-parse HEAD)"
printf 'a\n\nB\n\nc\n' >blank
git -c core.hooksPath=/dev/null commit -q -a -m "chore(demo): blank more" -m "Human-Only: true"
pid_sbe="$(git -c diff.suppressBlankEmpty=true diff-tree -p HEAD | git patch-id --verbatim | cut -d' ' -f1 | tr '\n' ' ')"
pid_plain="$(git -c diff.suppressBlankEmpty=false diff-tree -p HEAD | git patch-id --verbatim | cut -d' ' -f1 | tr '\n' ' ')"
differ "the fixture really is sensitive to diff.suppressBlankEmpty" "$pid_sbe" "$pid_plain"
sr 0 "manifest of the blank-line change" "" manifest "$blank0..HEAD"
man3="$(cat "$tmp/out")"
GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=diff.suppressBlankEmpty GIT_CONFIG_VALUE_0=true "$BASH" scripts/series manifest "$blank0..HEAD" >"$tmp/out" 2>&1
same "diff.suppressBlankEmpty=true does not change the manifest" "$(cat "$tmp/out")" "$man3"
git switch -q agent/claude/stack/demo

# --- check: stray commits ----------------------------------------------------------------------
mk f4 -
sr 1 "check refuses a commit without the id" "series-missing" check "$base0..HEAD"
git reset -q --hard HEAD~1
mk f4 other-abcdef0
sr 1 "check refuses a second series" "series-mixed" check "$base0..HEAD"
git reset -q --hard HEAD~1

# --- the commit-msg gate --------------------------------------------------------------------------
# gate <want> <what> <text> <trailers>: the hook's judgment of a human commit message with them.
gate() {
	local want="$1" what="$2" text="$3" rc=0
	printf 'feat(demo): a thing\n\n%s\n' "$4" >"$tmp/msg"
	.githooks/commit-msg "$tmp/msg" >"$tmp/out" 2>&1 || rc=$?
	verdict "commit-msg $what" "$rc" "$want" "$text"
}
gate 0 "takes a Series-Id after Stack" "" $'Stack: demo\nSeries-Id: a-abcdef0\nHuman-Only: true'
gate 1 "refuses two" "series-many" $'Stack: demo\nSeries-Id: a-abcdef0\nSeries-Id: b-abcdef0\nHuman-Only: true'
gate 1 "refuses a malformed value" "series-value" $'Stack: demo\nSeries-Id: Nope\nHuman-Only: true'
gate 1 "refuses one before Stack" "trailer-order" $'Series-Id: a-abcdef0\nStack: demo\nHuman-Only: true'

# --- a move keeps the manifest -----------------------------------------------------------------
git switch -q -c agent/claude/stack/alt "$base0"
echo other >other; git add other; git -c core.hooksPath=/dev/null commit -q -m "chore(demo): other" -m "Human-Only: true"
alt0="$(git rev-parse HEAD)"
git -c core.hooksPath=/dev/null cherry-pick "$base0..agent/claude/stack/demo" >/dev/null
sr 0 "manifest of the moved series" "" manifest "$alt0..HEAD"
digest_moved="$(grep -o '"digest".*' "$tmp/out")"
# Run in this shell, not in a command substitution: a verdict counted in a subshell is lost.
sr 0 "manifest of the original series" "" manifest "$base0..agent/claude/stack/demo"
same "a move keeps the manifest digest" "$digest_moved" "$(grep -o '"digest".*' "$tmp/out")"
sr 0 "digest of the moved series" "" digest "$alt0..HEAD"
digest_moved="$(cat "$tmp/out")"
sr 0 "digest of the original series" "" digest "$base0..agent/claude/stack/demo"
same "a move keeps the digest" "$digest_moved" "$(cat "$tmp/out")"
git switch -q agent/claude/stack/demo

if [ "$fails" -ne 0 ]; then
	echo "series self-test: $fails of $total checks failed" >&2
	exit 1
fi
echo "series self-test: $total checks passed"

#!/usr/bin/env bash
#
# scripts/pr — open the pull request for an agent branch, as the machine account.
#
#   scripts/pr                     the current branch, on main; title and body from its
#                                  first commit, and with more than one commit the body
#                                  also lists every subject
#   scripts/pr <branch>            that branch, without checking it out
#   scripts/pr -t <title> -b <text>
#   scripts/pr -B <parent>         stack on the branch of an open pull request (below)
#   scripts/pr --draft             open it as a draft
#   scripts/pr --body-file FILE    the body from a file, not generated
#   scripts/pr -n                  dry run: print what would be sent
#
# And four things to do to a pull request that is open, by its number:
#
#   scripts/pr --update-body N FILE   replace its body with the file
#   scripts/pr --quiet N              say whether every bot is quiet on its head; reads only
#   scripts/pr --ready N              take it out of draft, once the bots are quiet
#   scripts/pr --reviewer N LOGIN     ask LOGIN to review it, once the bots are quiet
#
# The body, a file or generated, and a new body go through the leak gate first. --ready
# looks at the head commit: it waits, up to FPL_PR_WAIT seconds (default 900, polling every
# FPL_PR_POLL, default 15), until no check run or status is pending and no review is
# requested and unanswered, and otherwise stops and names what is still pending. A bot
# that has not yet started a check is not pending to the forge: run it after a push has
# had a minute to start its checks. No labels are set or read.
#
# Quiet on the head H is measured, not assumed from silence, and --quiet and --reviewer judge
# it by every rule below; --ready by all but pr/codex, as Codex reviews no draft
# (codex-review.yml). Each rule that fails prints its name, what it saw and the remedy, and
# nothing is asked or marked:
#
#   pr/threads    no review thread is unresolved, outdated ones included, whoever opened it:
#                 a bot or a person, the maintainer too. The message names who opened each.
#   pr/codex      Codex's own state comment (codex-review-state:v1, which it edits in place)
#                 says its review of H completed, with no unresolved finding flagged or none
#                 of its threads open (the threads decide). Every other state refuses, and the
#                 message names it from what followed the last "@codex review": its usage
#                 limit, an ask from an account without Codex, a 👀 and no review, a review
#                 running since a time, or no answer yet. The verdict rests on the state's
#                 fields; a wrong reading of that prose changes the message, never the verdict.
#   pr/coderabbit the CodeRabbit commit status on H is not pending (a skipped review is done).
#   pr/claude     no check run on H whose name starts with "claude" is still running.
#   pr/reviewer   --reviewer asks nobody to read a draft: --ready first.
#   pr/budget     a thread is deferred only once FPL_PR_ROUNDS (default 3) Codex rounds are
#                 spent. A round is one completed Codex review of this pull request: a review
#                 with findings, or a receipt that found no major issues. Counted per pull
#                 request: a series that moves to a new number starts again.
#   pr/deferred   a resolved bot thread with a reply "Deferred to <issue url>" points at an
#                 open issue of this repository that lists the thread's url and names the
#                 follow-up branch on a line "Follow-up branch: `agent/...`", not the pull
#                 request's own, where the finding is fixed forward after it lands. A bot
#                 thread resolved at the head it was found on, with no later head to hold its
#                 fix, must be so deferred: nothing a bot found is dropped. A person's thread
#                 is never deferred.
#
# --reviewer and --quiet judge once. --ready waits, under FPL_PR_WAIT, on what time alone can
# clear (a review running) and refuses at once on the rest. Right before its mutation each
# reads the pull request and judges again: a push or a review request since (pr/moved), or a
# new thread, refuses. One round trip remains: GitHub's mutations take no expected state.
#
# A call to the forge that gets no answer ends in an error, not a hang: each call may wait
# FPL_PR_TIMEOUT seconds (default 30) for the forge to send, and during --ready no longer
# than what is left of FPL_PR_WAIT, but at least one second.
#
# A pull request is based on main. It is based on another branch only when that is a stack
# the author chose: -B <parent> names the head branch of a pull request that is open, and
# the branch must already be built on it. If it is not, this stops and says how to rebase
# onto it. -B main is the default spelled out.
#
# A pull request opens ready, not as a draft, unless --draft says otherwise: every bot
# reviewer and check starts at once, so they are done before a human reads.
#
# Naming the branch matters when the checkout is someone's working copy: switching it to
# the branch rewrites their files, and a session that may not delete files can leave it
# half switched. Nothing below reads the working tree, only refs.
#
# Prints the URL of the pull request, and nothing else, on stdout. If the branch already
# has an open pull request, that one's URL is printed and nothing is created.
#
# The author of a pull request cannot approve it, so agent work is filed by the machine
# account and the maintainer reviews it (.agents/WORKFLOW.md). gh falls back to the active
# account without a word when a token lookup comes back empty, which would file the
# request as the maintainer and leave nobody to approve it. So this refuses unless the
# token belongs to the account named in .git/agent-identity, and unless the branch on the
# forge is the commit you have here. It does not push: a push is yours or the
# maintainer's to make (WORKFLOW.md, rule 8).
#
# It talks to the forge over its API, with python3 from the default dev shell, so the
# github layer is not needed. The token is gh's if gh has one for the machine account,
# else the one in .git/agent-credentials (.agents/WORKFLOW.md, which lists the permissions it
# needs: --ready also reads check runs and commit statuses). FPL_API_URL names another
# API for scripts/pr-self-test; only this machine's loopback is accepted.
set -euo pipefail

die() {
	printf 'pr: %s\n' "$*" >&2
	exit 1
}

usage="usage: scripts/pr [-n] [--draft] [-t <title>] [-b <text>|--body-file <file>] [-B <parent>] [<branch>]
       scripts/pr --update-body <number> <file> | --quiet <number> | --ready <number>
       scripts/pr --reviewer <number> <login>"
base="" title="" body="" bodyfile="" dry=0 draft=0 mode=create num="" arg=""
while [ $# -gt 0 ]; do
	case "$1" in
	--body-file)
		[ $# -ge 2 ] || die "$1 needs a file; $usage"
		bodyfile="$2" && shift 2
		;;
	--update-body | --reviewer)
		[ $# -ge 3 ] || die "$1 needs two values; $usage"
		mode="${1#--}" num="$2" arg="$3" && shift 3
		;;
	--ready | --quiet)
		[ $# -ge 2 ] || die "$1 needs a number; $usage"
		mode="${1#--}" num="$2" && shift 2
		;;
	-t | -b | -B)
		[ $# -ge 2 ] || die "$1 needs a value; $usage"
		case "$1" in -t) title="$2" ;; -b) body="$2" ;; *) base="$2" ;; esac
		shift 2
		;;
	-n) dry=1 && shift ;;
	--draft) draft=1 && shift ;;
	-*) die "$usage" ;;
	*) break ;;
	esac
done
[ $# -le 1 ] || die "$usage"
if [ "$mode" != create ]; then
	case "$num" in '' | *[!0-9]*) die "'$num' is not a pull request number; $usage" ;; esac
	[ $# -eq 0 ] && [ -z "$base$title$body$bodyfile" ] && [ "$draft$dry" = 00 ] ||
		die "$mode takes only its own arguments; $usage"
fi
[ -z "$body" ] || [ -z "$bodyfile" ] || die "-b and --body-file both give the body; take one"
[ -z "$bodyfile" ] || [ -r "$bodyfile" ] || die "cannot read '$bodyfile'"

top="$(git rev-parse --show-toplevel)"
branch="" stack=""
if [ "$mode" = create ]; then
	branch="${1:-$(git branch --show-current)}"
	[ -n "$branch" ] || die "detached HEAD; name the branch to file"
	git rev-parse -q --verify "refs/heads/$branch" >/dev/null ||
		die "no local branch '$branch'"
	parsed="$("$top/scripts/branch-lint" --parse "$branch")" ||
		die "branch '$branch' does not parse"
	kind="$(sed -n 's/^kind=//p' <<<"$parsed")"
	stack="$(sed -n 's/^stack=//p' <<<"$parsed")"
	case "$kind" in
	agent-* | vendor) ;;
	*) die "'$branch' is not an agent branch; a human files their own pull request" ;;
	esac
fi

# The machine account: the login inside the noreply address of .git/agent-identity.
identity="$("$top/scripts/agent-identity" show)" ||
	die "agent identity unset (scripts/agent-identity)"
login="${identity#*+}"
login="${login%@*}"
[ -n "$login" ] && [ "$login" != "$identity" ] ||
	die "cannot read a login from '$identity'"

# The forge is the remote the branch tracks, else the one the parent -B names tracks, else
# the one main tracks: a branch stacked on another agent branch usually tracks nothing, and
# a parent that has an open pull request was pushed to the forge it is on. Failing all
# three, a clone with a single remote has only one forge to mean.
remote=""
[ -z "$branch" ] || remote="$(git config "branch.$branch.remote" || true)"
[ -n "$remote" ] || [ -z "$base" ] || remote="$(git config "branch.$base.remote" || true)"
[ -n "$remote" ] || remote="$(git config branch.main.remote || true)"
asked=""
for b in "$branch" "$base" main; do [ -z "$b" ] || asked="$asked${asked:+, }'$b'"; done
[ -n "$remote" ] || { [ "$(git remote | wc -l)" -eq 1 ] && remote="$(git remote)"; } ||
	die "cannot tell the forge: no remote is tracked by $asked, and there is more than one"

# .git/agent-credentials, if it is there: a git credential-store file holding one
# https://<login>:<token>@github.com line for the machine account (.agents/WORKFLOW.md).
cred="$(cd "$(git rev-parse --git-common-dir)" && pwd)/agent-credentials"
[ -r "$cred" ] || cred=""

# A private repository answers nothing to an anonymous read, and the session an agent runs
# in has no keyring for git to ask. So a call to the forge goes out with that file, and
# with the inherited helpers cleared first: a helper that answers for the maintainer would
# be the wrong account, silently.
git_forge() {
	if [ -n "$cred" ]; then
		git -c credential.helper= -c credential.helper="store --file=$cred" "$@"
	else
		git "$@"
	fi
}

# The token of the machine account. gh keeps one per account in the system keyring;
# .git/agent-credentials is the fallback, a git credential-store file holding one
# https://<login>:<token>@github.com line. Its login must be the machine account's: a
# credential for somebody else is not a fallback, it is the wrong author.
token=""
if command -v gh >/dev/null; then
	token="$(gh auth token -u "$login" 2>/dev/null || true)"
fi
if [ -z "$token" ] && [ -n "$cred" ]; then
	line="$(grep -m1 -E "^https://$login:[^@]+@github\\.com" "$cred" || true)"
	token="${line#*:*:}"
	token="${token%@*}"
fi
[ -n "$token" ] || die "no token for '$login': gh has none, and neither has ${cred:-.git/agent-credentials}"

# owner/repo from the remote's configured address, not the one an insteadOf rewrites it to.
slug="$(git config --get "remote.$remote.url" || git remote get-url "$remote")"
slug="${slug%.git}"
slug="${slug#*github.com}"
slug="${slug#[:/]}"
case "$slug" in
*/*) ;;
*) die "cannot read owner/repo from the url of '$remote'" ;;
esac

# The forge side, one python program for every call: pyapi <command> <argument>...
# It first checks that the token is the machine account's, whichever command follows.
read -r -d '' pysrc <<'PY' || true
import json, os, re, socket, sys, time, urllib.error, urllib.request

slug, login, token = os.environ["FPL_SLUG"], os.environ["FPL_LOGIN"], os.environ["FPL_TOKEN"]
root = os.environ.get("FPL_API_URL", "https://api.github.com")
cap = float(os.environ["FPL_PR_TIMEOUT"])
deadline = None  # set by ready: the end of the wait the caller allowed


def die(message):
    print(f"pr: {message}", file=sys.stderr)
    raise SystemExit(1)


if root != "https://api.github.com" and not root.startswith("http://127.0.0.1:"):
    die(f"FPL_API_URL '{root}' is neither GitHub nor this machine; the token stays home")


def bound():
    """Seconds one call to the forge may wait on its socket: the cap, and while --ready waits,
    no more than is left of the wait, but at least a second, so that a wait of 0 still reads
    once. The limit is on each wait for the forge to send, not on the whole transfer."""
    if deadline is None:
        return cap
    return min(cap, max(deadline - time.monotonic(), 1.0))


def api(path, payload=None, method=None, refused="", absent=None):
    """One call to the forge; the answer as JSON. `refused` is added to a 403: the permission
    the token lacks. `absent`, when given, is the answer to a 404 instead of a stop."""
    request = urllib.request.Request(
        root + path,
        data=None if payload is None else json.dumps(payload).encode(),
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "Content-Type": "application/json",
        },
        method=method or ("GET" if payload is None else "POST"),
    )
    seconds = bound()
    try:
        with urllib.request.urlopen(request, timeout=seconds) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        if error.code == 404 and absent is not None:
            return absent
        detail = json.loads(error.read() or b"{}")
        remedy = f"; {refused}" if refused and error.code == 403 else ""
        die(f"{path}: {error.code} {detail.get('message', error.reason)}{remedy}")
    except (urllib.error.URLError, OSError) as error:
        reason = getattr(error, "reason", error)
        if isinstance(reason, socket.timeout):
            die(f"{path}: no answer in {seconds:.1f}s (FPL_PR_TIMEOUT, FPL_PR_WAIT)")
        die(f"{path}: {reason}")


def pages(path, key, refused=""):
    """Every item under `key` of a paginated list: GitHub caps a page at 100 and a head can
    carry more check runs or status contexts than that. Reads page after page until the
    items reach the list's own total_count, or a page is empty, or, with no total_count, short.
    The combined status's top-level state is not a shortcut: it reads pending when a head has
    no statuses at all, which is the common case, and --ready would never succeed."""
    items, page = [], 1
    while True:
        got = api(f"{path}?per_page=100&page={page}", refused=refused)
        items += got[key]
        total = got.get("total_count")
        if not got[key] or (len(items) >= total if total is not None else len(got[key]) < 100):
            return items
        page += 1


def listing(path):
    """Every item of a list the forge serves bare, with no total_count (reviews, comments,
    reactions): page after page until one comes back short."""
    items, page, got = [], 1, [None] * 100
    while len(got) == 100:
        got = api(f"{path}?per_page=100&page={page}")
        items, page = items + got, page + 1
    return items


THREADS = """query($owner: String!, $name: String!, $number: Int!, $after: String) {
  repository(owner: $owner, name: $name) { pullRequest(number: $number) {
    reviewThreads(first: 100, after: $after) {
      pageInfo { hasNextPage endCursor }
      nodes { id isResolved isOutdated path line comments(first: 100) { NODES } } } } } }"""
NODES = """pageInfo { hasNextPage endCursor } nodes {
  databaseId url body author { __typename login } originalCommit { oid } }"""
COMMENTS = """query($id: ID!, $after: String) { node(id: $id) { ... on PullRequestReviewThread {
  comments(first: 100, after: $after) { NODES } } } }"""
THREADS, COMMENTS = THREADS.replace("NODES", NODES), COMMENTS.replace("NODES", NODES)


def threads(number):
    """Every review thread of the pull request, over GraphQL (REST does not say whether one is
    resolved), page after page. An answer that is no page fails pr/threads closed."""
    owner, name = slug.split("/", 1)
    found, after = [], None
    while True:
        variables = {"owner": owner, "name": name, "number": int(number), "after": after}
        got = api("/graphql", {"query": THREADS, "variables": variables})
        try:
            page = got["data"]["repository"]["pullRequest"]["reviewThreads"]
            found += page["nodes"]
            more, after = page["pageInfo"]["hasNextPage"], page["pageInfo"]["endCursor"]
        except (KeyError, TypeError):
            die(f"pr/threads: the forge's answer is not a page of review threads of #{number}:"
                f" {json.dumps(got)[:200]}; run this again, or read the threads on the forge")
        if not more:
            break
    for t in found:  # a thread of over 100 comments: the rest, where a deferral is appended
        page = t["comments"]
        while page["pageInfo"]["hasNextPage"]:
            variables = {"id": t["id"], "after": page["pageInfo"]["endCursor"]}
            got = api("/graphql", {"query": COMMENTS, "variables": variables})
            try:
                page = got["data"]["node"]["comments"]
                t["comments"]["nodes"] += page["nodes"]
            except (KeyError, TypeError):
                die(f"pr/threads: the forge's answer is not a page of comments of {where(t)}:"
                    f" {json.dumps(got)[:200]}; run this again, or read the thread on the forge")
    return found


CODEX = "chatgpt-codex-connector"  # GraphQL's spelling of the login; REST adds [bot]
STATE = re.compile(r"<!-- codex-review-state:v1 (\{.*?\}) -->", re.S)
SINCE = re.compile(r'since <relative-time datetime="([^"]+)"')
DEFERRAL = (
    "Deferred to https://github.com/{slug}/issues/{number}, the follow-up of this pull request."
)
BRANCH = re.compile(r"^Follow-up branch: `(agent/[^`\s]+)`\s*$", re.M)


def who(user):
    """The login of a REST user or a GraphQL author, without the [bot] REST gives an App."""
    return ((user or {}).get("login") or "").removesuffix("[bot]")


def first(thread):
    nodes = thread["comments"]["nodes"]
    return nodes[0] if nodes else {}


def where(thread):
    """A thread, for a human: the url of its first comment, else its path and line."""
    return first(thread).get("url") or f"{thread['path']}:{thread['line']}"


def by_bot(thread):
    author = first(thread).get("author") or {}
    return author.get("__typename") == "Bot" or who(author) in (CODEX, "coderabbitai", "claude")


def deferred(thread):
    """The numbers of the issues a thread is deferred to: its replies, by anyone but a bot, that
    say so in the words of DEFERRAL."""
    pattern = re.escape(DEFERRAL.format(slug=slug, number="NUMBER")).replace("NUMBER", r"(\d+)")
    return {
        int(k)
        for c in thread["comments"]["nodes"][1:]
        if (c.get("author") or {}).get("__typename") != "Bot"
        for k in re.findall(pattern, c["body"])
    }


issues = {}  # by number, read once each


def unfit(number, url, own):
    """Why issue `number` cannot carry the deferral of the thread at `url` off the pull request
    whose branch is `own`, or None."""
    if number not in issues:
        issues[number] = api(f"/repos/{slug}/issues/{number}", absent={})
    issue, body = issues[number], issues[number].get("body") or ""
    branch = BRANCH.search(body)
    if not issue:
        return f"issue #{number} does not exist"
    if "pull_request" in issue:
        return f"#{number} is a pull request, not an issue"
    if issue.get("state") != "open":
        return f"issue #{number} is {issue.get('state')}"
    if not branch:
        return f"issue #{number} names no follow-up branch (a line Follow-up branch: `agent/...`)"
    if branch.group(1) == own:
        return f"issue #{number} names the pull request's own branch, which its approval freezes"
    if url not in body:
        return f"issue #{number} does not list {url}"
    return None


def seen(number):
    """What the pull request holds: its review threads, its comments, Codex's among them, and
    the Codex rounds spent (pr/budget)."""
    found = threads(number)
    said = listing(f"/repos/{slug}/issues/{number}/comments")
    mine = [c for c in said if who(c["user"]) == CODEX]
    reviews = listing(f"/repos/{slug}/pulls/{number}/reviews")
    rounds = sum(who(r["user"]) == CODEX for r in reviews)
    rounds += sum("Didn't find any major issues" in c["body"] for c in mine)
    return found, said, mine, rounds


def judge_threads(number, pull, found, rounds):
    """pr/threads, pr/budget and pr/deferred, as the header has them."""
    sha, own = pull["head"]["sha"], pull["head"].get("ref")
    out, short, budget = [], sha[:7], int(os.environ["FPL_PR_ROUNDS"])
    loose = [t for t in found if not t["isResolved"]]
    if loose:
        what = f"{len(loose)} of {len(found)} review threads unresolved, outdated ones included"
        named = [f"{where(t)} (by {who(first(t).get('author')) or 'nobody known'})" for t in loose]
        fix = f"fix each and push, or answer it and resolve it ({rounds} of {budget} Codex rounds)"
        if rounds >= budget and any(by_bot(t) for t in loose):
            fix = (
                f"the budget of {budget} Codex rounds is spent ({rounds}): move the bots' to a"
                " follow-up issue, and each thread links it (.agents/WORKFLOW.md, rule 10);"
                " answer a person's here"
            )
        out.append(("pr/threads", False, f"{what}: {' '.join(named)}", fix))
    for t in (t for t in found if t["isResolved"]):
        cited, mine = deferred(t), by_bot(t)
        if cited and not mine:
            fix = "a person's thread is never deferred: reopen it"
            out.append(("pr/deferred", False, f"{where(t)} is a person's thread, deferred", fix))
            continue
        if not cited and mine and (first(t).get("originalCommit") or {}).get("oid") == sha:
            what = f"{where(t)} was found at {short} and is resolved, with no later head to hold"
            fix = "push its fix, or defer it to the follow-up; nothing a bot found is dropped"
            out.append(("pr/deferred", False, f"{what} its fix and no deferral", fix))
        if cited and rounds < budget:
            what = f"{where(t)} is deferred after {rounds} Codex rounds, under the budget of"
            what += f" {budget}"
            fix = "fix it on this pull request; a finding moves to a follow-up only once the"
            out.append(("pr/budget", False, what, f"{fix} budget is spent (FPL_PR_ROUNDS)"))
        for why in filter(None, (unfit(k, first(t).get("url", ""), own) for k in sorted(cited))):
            fix = f"the issue a thread is deferred to is open, lists {where(t)} and names the"
            fix += " follow-up branch: edit its body, or defer the thread again"
            out.append(("pr/deferred", False, why, fix))
    return out


def silence(said, mine, short, rerun):
    """pr/codex where Codex has no finished or running review of the head: which silence it
    is, read from what followed the last "@codex review". Only the message depends on it."""
    asks = [c for c in said if c["body"].strip() == "@codex review"]
    ask = asks[-1] if asks else None
    after = [c["body"] for c in mine if ask and c["created_at"] >= ask["created_at"]]
    after = [b for b in after if not STATE.search(b)]
    wait = f"wait and run this again; if no review comes, {rerun}"
    if any("usage limits" in b for b in after):
        return False, "Codex answered the last ask with its usage limit", f"once it resets, {rerun}"
    if any("create a Codex account" in b for b in after):
        what = "Codex refused the last ask as an ask from an account without Codex"
        return False, what, f"{rerun}; an ask from the machine account is refused"
    eyes = listing(f"/repos/{slug}/issues/comments/{ask['id']}/reactions") if ask else []
    if any(who(r["user"]) == CODEX and r["content"] == "eyes" for r in eyes):
        return True, f"Codex took the last ask (eyes) and has posted no review of {short}", wait
    if ask:
        return True, f"Codex was asked at {ask['created_at']} and has not reviewed {short}", wait
    what = f"Codex has not been asked to review {short}"
    return True, what, f"codex-review.yml asks on each push; {rerun}"


def judge_codex(sha, found, said, mine):
    """pr/codex, from Codex's state comment: one comment it edits in place, the newest edit."""
    short = sha[:7]
    rerun = f"re-run the codex-review job of {short}, which asks as the owner"
    states = [c for c in mine if STATE.search(c["body"])]
    latest = max(states, key=lambda c: c.get("updated_at") or "") if states else None
    state = json.loads(STATE.search(latest["body"]).group(1)) if latest else {}
    state = state.get("code_review") or {}
    status = state.get("status") if state.get("commit_sha") == sha else None
    if status == "completed":
        mine = [t for t in found if not t["isResolved"] and who(first(t).get("author")) == CODEX]
        if state.get("has_unresolved_findings") and mine:
            what = f"Codex finished {short} with findings unresolved"
            return [("pr/codex", False, what, "see pr/threads")]
        return []
    if status == "running":
        since = SINCE.search(latest["body"])
        what = f"Codex is reviewing {short}, running since {since and since.group(1)}"
        stalled = f"wait and run this again; a review running for an hour has stalled: {rerun}"
        return [("pr/codex", True, what, stalled)]
    wait, what, remedy = silence(said, mine, short, rerun)
    if status:  # a review of the head that neither runs nor completed
        wait, what = False, f"{what} (its review of {short} is {status})"
    return [("pr/codex", wait, what, remedy)]


def judge_others(sha):
    """pr/coderabbit and pr/claude: the reviews that show as a status or a check run."""
    out, short = [], sha[:7]
    for s in pages(f"/repos/{slug}/commits/{sha}/status", "statuses"):
        if s["context"] == "CodeRabbit" and s["state"] == "pending":
            what = f"CodeRabbit is reviewing {short} ({s.get('description')})"
            out.append(("pr/coderabbit", True, what, "wait and run this again"))
    for r in pages(f"/repos/{slug}/commits/{sha}/check-runs", "check_runs"):
        if r["name"].startswith("claude") and r["status"] != "completed":
            what = f"{r['name']} is {r['status']} on {short}"
            out.append(("pr/claude", True, what, "wait and run this again"))
    return out


def quiet(number, pull, bots=None, codex=True):
    """The refusals of the header's rules on the head, pr/codex only where `codex`: a list of
    (rule, wait, what, remedy), empty when quiet; `wait` where time alone may clear it."""
    sha = pull["head"]["sha"]
    found, said, mine, rounds = bots or seen(number)
    codex = judge_codex(sha, found, said, mine) if codex else []
    return judge_threads(number, pull, found, rounds) + codex + judge_others(sha)


def again(number, pull, codex=True):
    """The judgment once more, right before a mutation: the pull request read again, unchanged,
    and its bots judged again, so a push, a request or a thread since `pull` was judged refuses."""
    latest = api(f"/repos/{slug}/pulls/{number}")
    if view(latest) != view(pull):
        moved = f"{pull['head']['sha'][:7]} to {latest['head']['sha'][:7]}"
        what = f"the head or the review requests changed while it was read ({moved})"
        return [("pr/moved", True, what, "run this again")]
    return quiet(number, latest, codex=codex)


def failed(got, name, key):
    """Why `got` is no answer of mutation `name` holding `key` (errors, {}, data null), or None."""
    if got.get("errors"):
        return got["errors"][0].get("message")
    if not ((got.get("data") or {}).get(name) or {}).get(key):
        return f"the forge's answer is not the mutation's: {json.dumps(got)[:200]}"
    return None


def told(refusals):
    """The refusals, one line each, for a human: the rule, what it saw, the remedy."""
    return "\n".join(f"pr: {rule}: {what}; {remedy}" for rule, _, what, remedy in refusals)


def view(pull):
    """What --ready judged a pull request by, and must find unchanged before it marks it."""
    return (
        pull["state"],
        pull["draft"],
        pull["head"]["sha"],
        sorted(u["login"] for u in pull["requested_reviewers"]),
        sorted(t["slug"] for t in pull["requested_teams"]),
    )


def open_pull(branch):
    owner = slug.split("/")[0]
    found = api(f"/repos/{slug}/pulls?state=open&head={owner}:{branch}")
    return found[0] if found else None


whoami = api("/user").get("login")
if whoami != login:
    die(f"the token belongs to '{whoami}', not '{login}'")

command, args = sys.argv[1], sys.argv[2:]
if command == "open-url":  # the url of the open pull request of a branch, or nothing
    found = open_pull(args[0])
    if found:
        print(found["html_url"])
elif command == "create":
    branch, base, title, body, draft = args
    created = api(
        f"/repos/{slug}/pulls",
        {"title": title, "body": body, "head": branch, "base": base, "draft": draft == "1"},
    )
    print(created["html_url"])
elif command == "update-body":
    api(f"/repos/{slug}/pulls/{args[0]}", {"body": open(args[1]).read()}, "PATCH")
    print(f"pr: body of #{args[0]} replaced", file=sys.stderr)
elif command == "quiet":
    pull = api(f"/repos/{slug}/pulls/{args[0]}")
    refusals = quiet(args[0], pull)
    if refusals:
        die(f"#{args[0]} at {pull['head']['sha'][:7]} is not quiet:\n{told(refusals)}")
    print(f"pr: every bot is quiet at {pull['head']['sha'][:7]} on #{args[0]}", file=sys.stderr)
elif command == "reviewer":
    pull = api(f"/repos/{slug}/pulls/{args[0]}")
    if pull["draft"]:
        die(f"pr/reviewer: #{args[0]} is a draft, so nobody was asked; scripts/pr --ready it first")
    refusals = quiet(args[0], pull) or again(args[0], pull)
    if refusals:
        sha = pull["head"]["sha"][:7]
        die(f"#{args[0]} at {sha} is not quiet, so nobody was asked:\n{told(refusals)}")
    api(f"/repos/{slug}/pulls/{args[0]}/requested_reviewers", {"reviewers": [args[1]]})
    print(f"pr: asked {args[1]} to review #{args[0]}", file=sys.stderr)
elif command == "ready":
    number = args[0]
    wait, poll = float(os.environ["FPL_PR_WAIT"]), float(os.environ["FPL_PR_POLL"])
    deadline = time.monotonic() + wait
    unread = (
        "the token needs Checks read and Commit statuses read beside the rest"
        " (.agents/WORKFLOW.md, The agent's credential)"
    )
    while True:
        pull = api(f"/repos/{slug}/pulls/{number}")
        if pull["state"] != "open":
            die(f"#{number} is {pull['state']}")
        if not pull["draft"]:
            print(f"pr: #{number} is ready already", file=sys.stderr)
            raise SystemExit(0)
        sha = pull["head"]["sha"]
        refusals = quiet(number, pull, codex=False)
        work = [r for r in refusals if not r[1]]
        if work:  # waiting would not clear these
            die(f"#{number} at {sha[:7]} is not quiet, so it stays a draft:\n{told(work)}")
        pending = [f"{rule}: {what}" for rule, _, what, _ in refusals]
        pending += [f"review requested from {u['login']}" for u in pull["requested_reviewers"]]
        pending += [f"review requested from team {t['slug']}" for t in pull["requested_teams"]]
        runs = pages(f"/repos/{slug}/commits/{sha}/check-runs", "check_runs", unread)
        pending += [f"check {r['name']} is {r['status']}" for r in runs if r["status"] != "completed"]
        statuses = pages(f"/repos/{slug}/commits/{sha}/status", "statuses", unread)
        pending += [f"status {s['context']} is pending" for s in statuses if s["state"] == "pending"]
        if not pending:  # anything that moved sends the loop round again, same deadline
            pending = [f"{rule}: {what}" for rule, _, what, _ in again(number, pull, codex=False)]
            if not pending:
                break
        if time.monotonic() >= deadline:
            die(f"#{number} at {sha[:7]} is not quiet after {wait:g}s: " + "; ".join(pending))
        time.sleep(min(poll, max(deadline - time.monotonic(), 0)))
    deadline = None  # the wait is over; the mutation gets the cap, not what is left
    marked = api(
        "/graphql",
        {
            "query": "mutation($id: ID!) { markPullRequestReadyForReview(input: {pullRequestId: $id})"
            " { pullRequest { isDraft } } }",
            "variables": {"id": pull["node_id"]},
        },
    )
    why = failed(marked, "markPullRequestReadyForReview", "pullRequest")
    if why:
        die(f"#{number} stays a draft: {why}")
    print(f"pr: #{number} is ready, the bots are quiet at {sha[:7]}", file=sys.stderr)
else:
    die(f"no command '{command}'")
PY
pyapi() {
	FPL_SLUG="$slug" FPL_LOGIN="$login" FPL_TOKEN="$token" FPL_PR_WAIT="${FPL_PR_WAIT:-900}" \
		FPL_PR_POLL="${FPL_PR_POLL:-15}" FPL_PR_ROUNDS="${FPL_PR_ROUNDS:-3}" FPL_PR_TIMEOUT="${FPL_PR_TIMEOUT:-30}" python3 -c "$pysrc" "$@"
}

# What goes to the forge is first written here and leak-checked here, and the copy is what
# is sent: a file read twice, once for the gate and once for the request, could change in
# between, and the forge would get text the gate never saw.
said="$(mktemp -d)"
trap 'rm -rf -- "$said"' EXIT

# The modes that work on a pull request already open need no branch.
case "$mode" in
update-body)
	cat -- "$arg" >"$said/body" || die "cannot read '$arg'"
	"$top/scripts/leak-check" --text "$said/body" || die "nothing was sent"
	pyapi update-body "$num" "$said/body"
	exit 0
	;;
ready | quiet)
	pyapi "$mode" "$num"
	exit 0
	;;
reviewer)
	pyapi reviewer "$num" "$arg"
	exit 0
	;;
esac

here="$(git rev-parse "refs/heads/$branch")"
there="$(git_forge ls-remote "$remote" "refs/heads/$branch" | cut -f1)"
[ -n "$there" ] || die "'$branch' is not on $remote yet; push it first"
[ "$there" = "$here" ] || die "$remote has ${there:0:7}, you have ${here:0:7}; push first"

# A branch that already has an open pull request is not filed twice.
filed="$(pyapi open-url "$branch")"
if [ -n "$filed" ]; then
	printf 'pr: already open\n' >&2
	printf '%s\n' "$filed"
	exit 0
fi

# The base: main, unless -B names the branch of an open pull request this one is built on.
# Ancestry is judged first, from refs, so a branch that is not on top of its parent is told
# how to get there whether or not the parent has a pull request.
[ -n "$base" ] || base=main
if [ "$base" != main ]; then
	git_forge fetch -q "$remote" "+refs/heads/$base:refs/remotes/$remote/$base" ||
		die "cannot fetch '$base' from $remote"
fi
git merge-base --is-ancestor "$remote/$base" "$here" ||
	die "'$branch' is not on top of $base; git rebase --onto $remote/$base $remote/main $branch, push, and run this again"
if [ "$base" != main ] && [ -z "$(pyapi open-url "$base")" ]; then
	die "'$base' is not the branch of an open pull request; a pull request is based on main: git rebase --onto $remote/main $remote/$base $branch, push, and run this again without -B"
fi

first="$(git rev-list --reverse "$remote/$base..$here" | sed -n 1p)"
[ -n "$first" ] || die "no commits between $remote/$base and $branch"
count="$(git rev-list --count "$remote/$base..$here")"
[ -n "$title" ] || title="$(git log -1 --format=%s "$first")"
# Default body: the first paragraph of the first commit's body, as one line.
[ -n "$body" ] || body="$(git log -1 --format=%b "$first" |
	awk 'NF==0{exit} {printf "%s%s", sep, $0; sep=" "}')"
[ -z "$bodyfile" ] || body="$(cat "$bodyfile")"
# One commit speaks for itself. More than one: the first commit's paragraph describes only
# the first change, so list them all.
subjects=""
[ "$count" = 1 ] || subjects="$(git log --reverse --format='- %s' "$remote/$base..$here")"$'\n\n'
if [ -n "$bodyfile" ]; then
	text="$body"
else
	text="$(printf '%s%s\n\n%slanding: fast-forward by the lander after review.' \
		"${stack:+Stack: $stack$'\n\n'}" "$body" "$subjects")"
fi

# The forge is public: the title, the text and the branch name go through the leak gate
# first (scripts/leak-check; FPL_LEAK_GATE=warn overrides), dry run or not.
printf '%s\n%s\n\n%s\n' "$branch" "$title" "$text" >"$said/pull-request"
"$top/scripts/leak-check" --text "$said/pull-request" || die "nothing was sent"

if [ "$dry" -eq 1 ]; then
	printf 'as:    %s\nbase:  %s\nhead:  %s\ndraft: %s\ntitle: %s\n\n%s\n' \
		"$login" "$base" "$branch" "$([ "$draft" -eq 1 ] && echo yes || echo no)" "$title" "$text" >&2
	exit 0
fi

pyapi create "$branch" "$base" "$title" "$text" "$draft"

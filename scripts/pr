#!/usr/bin/env bash
#
# scripts/pr — open the pull request for the current agent branch, as the machine account.
#
#   scripts/pr                     title and body from the first commit of the branch; with
#                                  more than one commit the body also lists every subject
#   scripts/pr -t <title> -b <text>
#   scripts/pr -B <base>           target another branch than main (the PR below, in a stack)
#   scripts/pr -n                  dry run: print what would be sent
#
# Prints the URL of the pull request, and nothing else, on stdout. If the branch already
# has an open pull request, that one's URL is printed and nothing is created.
#
# The author of a pull request cannot approve it, so agent work is filed by the machine
# account and the maintainer reviews it (docs/WORKFLOW.md). gh falls back to the active
# account without a word when a token lookup comes back empty, which would file the
# request as the maintainer and leave nobody to approve it. So this refuses unless the
# token belongs to the account named in .git/agent-identity, and unless the branch on the
# forge is the commit you have here. It does not push: a push is yours or the
# maintainer's to make (WORKFLOW.md, rule 8). Needs gh: `scripts/layer on github`.
set -euo pipefail

die() {
	printf 'pr: %s\n' "$*" >&2
	exit 1
}

base=main title="" body="" dry=0
while getopts "t:b:B:n" opt; do
	case "$opt" in
	t) title="$OPTARG" ;;
	b) body="$OPTARG" ;;
	B) base="$OPTARG" ;;
	n) dry=1 ;;
	*) die "usage: scripts/pr [-n] [-t <title>] [-b <body>] [-B <base>]" ;;
	esac
done

top="$(git rev-parse --show-toplevel)"
branch="$(git branch --show-current)"
[ -n "$branch" ] || die "detached HEAD; switch to the branch to file"
parsed="$("$top/scripts/branch-lint" --parse "$branch")" ||
	die "branch '$branch' does not parse"
kind="$(sed -n 's/^kind=//p' <<<"$parsed")"
stack="$(sed -n 's/^stack=//p' <<<"$parsed")"
case "$kind" in
agent-* | vendor) ;;
*) die "'$branch' is not an agent branch; a human files their own pull request" ;;
esac

# The machine account: the login inside the noreply address of .git/agent-identity.
identity="$("$top/scripts/agent-identity" show)" ||
	die "agent identity unset (scripts/agent-identity)"
login="${identity#*+}"
login="${login%@*}"
[ -n "$login" ] && [ "$login" != "$identity" ] ||
	die "cannot read a login from '$identity'"

remote="$(git config "branch.$branch.remote" || echo origin)"
here="$(git rev-parse HEAD)"
there="$(git ls-remote "$remote" "refs/heads/$branch" | cut -f1)"
[ -n "$there" ] || die "'$branch' is not on $remote yet; push it first"
[ "$there" = "$here" ] || die "$remote has ${there:0:7}, you have ${here:0:7}; push first"

first="$(git rev-list --reverse "$remote/$base..HEAD" | head -n1)"
[ -n "$first" ] || die "no commits between $remote/$base and HEAD"
count="$(git rev-list --count "$remote/$base..HEAD")"
[ -n "$title" ] || title="$(git log -1 --format=%s "$first")"
# Default body: the first paragraph of the first commit's body, as one line.
[ -n "$body" ] || body="$(git log -1 --format=%b "$first" |
	awk 'NF==0{exit} {printf "%s%s", sep, $0; sep=" "}')"
# One commit speaks for itself. More than one: the first commit's paragraph describes only
# the first change, so list them all.
subjects=""
[ "$count" = 1 ] || subjects="$(git log --reverse --format='- %s' "$remote/$base..HEAD")"$'\n\n'
text="$(printf '%s%s\n\n%s%s commit%s, rebase-merge.' \
	"${stack:+Stack: $stack$'\n\n'}" "$body" "$subjects" "$count" "$([ "$count" = 1 ] || echo s)")"

if [ "$dry" -eq 1 ]; then
	printf 'as:    %s\nbase:  %s\nhead:  %s\ntitle: %s\n\n%s\n' \
		"$login" "$base" "$branch" "$title" "$text" >&2
	exit 0
fi

command -v gh >/dev/null || die "gh not found; scripts/layer on github"
token="$(gh auth token -u "$login" 2>/dev/null)" || token=""
[ -n "$token" ] || die "gh has no token for '$login'; run: gh auth login (as $login)"
whoami="$(GH_TOKEN="$token" gh api user -q .login)" || die "the token for '$login' is not accepted"
[ "$whoami" = "$login" ] || die "the token belongs to '$whoami', not '$login'"

open_url='select(.state=="OPEN").url'
if url="$(GH_TOKEN="$token" gh pr view "$branch" --json url,state -q "$open_url" 2>/dev/null)" &&
	[ -n "$url" ]; then
	printf 'pr: already open\n' >&2
	printf '%s\n' "$url"
	exit 0
fi
GH_TOKEN="$token" gh pr create --base "$base" --head "$branch" --title "$title" --body "$text"

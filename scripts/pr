#!/usr/bin/env bash
#
# scripts/pr — open the pull request for an agent branch, as the machine account.
#
#   scripts/pr                     the current branch, on main; title and body from its
#                                  first commit, and with more than one commit the body
#                                  also lists every subject
#   scripts/pr <branch>            that branch, without checking it out
#   scripts/pr -t <title> -b <text>
#   scripts/pr -B <parent>         stack on the branch of an open pull request (below)
#   scripts/pr --draft             open it as a draft
#   scripts/pr -n                  dry run: print what would be sent
#
# A pull request is based on main. It is based on another branch only when that is a stack
# the author chose: -B <parent> names the head branch of a pull request that is open, and
# the branch must already be built on it. If it is not, this stops and says how to rebase
# onto it. -B main is the default spelled out.
#
# A pull request opens ready, not as a draft, unless --draft says otherwise: every bot
# reviewer and check starts at once, so they are done before a human reads.
#
# Naming the branch matters when the checkout is someone's working copy: switching it to
# the branch rewrites their files, and a session that may not delete files can leave it
# half switched. Nothing below reads the working tree, only refs.
#
# Prints the URL of the pull request, and nothing else, on stdout. If the branch already
# has an open pull request, that one's URL is printed and nothing is created.
#
# The author of a pull request cannot approve it, so agent work is filed by the machine
# account and the maintainer reviews it (.agents/WORKFLOW.md). gh falls back to the active
# account without a word when a token lookup comes back empty, which would file the
# request as the maintainer and leave nobody to approve it. So this refuses unless the
# token belongs to the account named in .git/agent-identity, and unless the branch on the
# forge is the commit you have here. It does not push: a push is yours or the
# maintainer's to make (WORKFLOW.md, rule 8).
#
# It talks to the forge over its API, with python3 from the default dev shell, so the
# github layer is not needed. The token is gh's if gh has one for the machine account,
# else the one in .git/agent-credentials (.agents/WORKFLOW.md). FPL_API_URL names another
# API for scripts/pr-self-test; only this machine's loopback is accepted.
set -euo pipefail

die() {
	printf 'pr: %s\n' "$*" >&2
	exit 1
}

usage="usage: scripts/pr [-n] [--draft] [-t <title>] [-b <text>] [-B <parent>] [<branch>]"
base="" title="" body="" dry=0 draft=0
while [ $# -gt 0 ]; do
	case "$1" in
	-t | -b | -B)
		[ $# -ge 2 ] || die "$1 needs a value; $usage"
		case "$1" in -t) title="$2" ;; -b) body="$2" ;; *) base="$2" ;; esac
		shift 2
		;;
	-n) dry=1 && shift ;;
	--draft) draft=1 && shift ;;
	-*) die "$usage" ;;
	*) break ;;
	esac
done
[ $# -le 1 ] || die "$usage"

top="$(git rev-parse --show-toplevel)"
branch="${1:-$(git branch --show-current)}"
[ -n "$branch" ] || die "detached HEAD; name the branch to file"
git rev-parse -q --verify "refs/heads/$branch" >/dev/null ||
	die "no local branch '$branch'"
parsed="$("$top/scripts/branch-lint" --parse "$branch")" ||
	die "branch '$branch' does not parse"
kind="$(sed -n 's/^kind=//p' <<<"$parsed")"
stack="$(sed -n 's/^stack=//p' <<<"$parsed")"
case "$kind" in
agent-* | vendor) ;;
*) die "'$branch' is not an agent branch; a human files their own pull request" ;;
esac

# The machine account: the login inside the noreply address of .git/agent-identity.
identity="$("$top/scripts/agent-identity" show)" ||
	die "agent identity unset (scripts/agent-identity)"
login="${identity#*+}"
login="${login%@*}"
[ -n "$login" ] && [ "$login" != "$identity" ] ||
	die "cannot read a login from '$identity'"

# The forge is the remote the branch tracks, else the one the parent -B names tracks, else
# the one main tracks: a branch stacked on another agent branch usually tracks nothing, and
# a parent that has an open pull request was pushed to the forge it is on. Failing all
# three, a clone with a single remote has only one forge to mean.
remote="$(git config "branch.$branch.remote" || true)"
[ -n "$remote" ] || [ -z "$base" ] || remote="$(git config "branch.$base.remote" || true)"
[ -n "$remote" ] || remote="$(git config branch.main.remote || true)"
asked=""
for b in "$branch" "$base" main; do [ -z "$b" ] || asked="$asked${asked:+, }'$b'"; done
[ -n "$remote" ] || { [ "$(git remote | wc -l)" -eq 1 ] && remote="$(git remote)"; } ||
	die "cannot tell the forge: no remote is tracked by $asked, and there is more than one"

# .git/agent-credentials, if it is there: a git credential-store file holding one
# https://<login>:<token>@github.com line for the machine account (.agents/WORKFLOW.md).
cred="$(cd "$(git rev-parse --git-common-dir)" && pwd)/agent-credentials"
[ -r "$cred" ] || cred=""

# A private repository answers nothing to an anonymous read, and the session an agent runs
# in has no keyring for git to ask. So a call to the forge goes out with that file, and
# with the inherited helpers cleared first: a helper that answers for the maintainer would
# be the wrong account, silently.
git_forge() {
	if [ -n "$cred" ]; then
		git -c credential.helper= -c credential.helper="store --file=$cred" "$@"
	else
		git "$@"
	fi
}

# The token of the machine account. gh keeps one per account in the system keyring;
# .git/agent-credentials is the fallback, a git credential-store file holding one
# https://<login>:<token>@github.com line. Its login must be the machine account's: a
# credential for somebody else is not a fallback, it is the wrong author.
token=""
if command -v gh >/dev/null; then
	token="$(gh auth token -u "$login" 2>/dev/null || true)"
fi
if [ -z "$token" ] && [ -n "$cred" ]; then
	line="$(grep -m1 -E "^https://$login:[^@]+@github\\.com" "$cred" || true)"
	token="${line#*:*:}"
	token="${token%@*}"
fi
[ -n "$token" ] || die "no token for '$login': gh has none, and neither has ${cred:-.git/agent-credentials}"

# owner/repo from the remote's configured address, not the one an insteadOf rewrites it to.
slug="$(git config --get "remote.$remote.url" || git remote get-url "$remote")"
slug="${slug%.git}"
slug="${slug#*github.com}"
slug="${slug#[:/]}"
case "$slug" in
*/*) ;;
*) die "cannot read owner/repo from the url of '$remote'" ;;
esac

# The forge side, one python program for every call: pyapi <command> <argument>...
# It first checks that the token is the machine account's, whichever command follows.
read -r -d '' pysrc <<'PY' || true
import json, os, sys, urllib.error, urllib.request

slug, login, token = os.environ["FPL_SLUG"], os.environ["FPL_LOGIN"], os.environ["FPL_TOKEN"]
root = os.environ.get("FPL_API_URL", "https://api.github.com")


def die(message):
    print(f"pr: {message}", file=sys.stderr)
    raise SystemExit(1)


if root != "https://api.github.com" and not root.startswith("http://127.0.0.1:"):
    die(f"FPL_API_URL '{root}' is neither GitHub nor this machine; the token stays home")


def api(path, payload=None, method=None):
    request = urllib.request.Request(
        root + path,
        data=None if payload is None else json.dumps(payload).encode(),
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "Content-Type": "application/json",
        },
        method=method or ("GET" if payload is None else "POST"),
    )
    try:
        with urllib.request.urlopen(request) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        detail = json.loads(error.read() or b"{}")
        die(f"{path}: {error.code} {detail.get('message', error.reason)}")


def open_pull(branch):
    owner = slug.split("/")[0]
    found = api(f"/repos/{slug}/pulls?state=open&head={owner}:{branch}")
    return found[0] if found else None


whoami = api("/user").get("login")
if whoami != login:
    die(f"the token belongs to '{whoami}', not '{login}'")

command, args = sys.argv[1], sys.argv[2:]
if command == "open-url":  # the url of the open pull request of a branch, or nothing
    found = open_pull(args[0])
    if found:
        print(found["html_url"])
elif command == "create":
    branch, base, title, body, draft = args
    created = api(
        f"/repos/{slug}/pulls",
        {"title": title, "body": body, "head": branch, "base": base, "draft": draft == "1"},
    )
    print(created["html_url"])
else:
    die(f"no command '{command}'")
PY
pyapi() {
	FPL_SLUG="$slug" FPL_LOGIN="$login" FPL_TOKEN="$token" python3 -c "$pysrc" "$@"
}

here="$(git rev-parse "refs/heads/$branch")"
there="$(git_forge ls-remote "$remote" "refs/heads/$branch" | cut -f1)"
[ -n "$there" ] || die "'$branch' is not on $remote yet; push it first"
[ "$there" = "$here" ] || die "$remote has ${there:0:7}, you have ${here:0:7}; push first"

# A branch that already has an open pull request is not filed twice.
filed="$(pyapi open-url "$branch")"
if [ -n "$filed" ]; then
	printf 'pr: already open\n' >&2
	printf '%s\n' "$filed"
	exit 0
fi

# The base: main, unless -B names the branch of an open pull request this one is built on.
# Ancestry is judged first, from refs, so a branch that is not on top of its parent is told
# how to get there whether or not the parent has a pull request.
[ -n "$base" ] || base=main
if [ "$base" != main ]; then
	git_forge fetch -q "$remote" "+refs/heads/$base:refs/remotes/$remote/$base" ||
		die "cannot fetch '$base' from $remote"
fi
git merge-base --is-ancestor "$remote/$base" "$here" ||
	die "'$branch' is not on top of $base; git rebase --onto $remote/$base $remote/main $branch, push, and run this again"
if [ "$base" != main ] && [ -z "$(pyapi open-url "$base")" ]; then
	die "'$base' is not the branch of an open pull request; a pull request is based on main: git rebase --onto $remote/main $remote/$base $branch, push, and run this again without -B"
fi

first="$(git rev-list --reverse "$remote/$base..$here" | sed -n 1p)"
[ -n "$first" ] || die "no commits between $remote/$base and $branch"
count="$(git rev-list --count "$remote/$base..$here")"
[ -n "$title" ] || title="$(git log -1 --format=%s "$first")"
# Default body: the first paragraph of the first commit's body, as one line.
[ -n "$body" ] || body="$(git log -1 --format=%b "$first" |
	awk 'NF==0{exit} {printf "%s%s", sep, $0; sep=" "}')"
# One commit speaks for itself. More than one: the first commit's paragraph describes only
# the first change, so list them all.
subjects=""
[ "$count" = 1 ] || subjects="$(git log --reverse --format='- %s' "$remote/$base..$here")"$'\n\n'
text="$(printf '%s%s\n\n%slanding: fast-forward by the lander after review.' \
	"${stack:+Stack: $stack$'\n\n'}" "$body" "$subjects")"

# The forge is public: the title, the text and the branch name go through the leak gate
# first (scripts/leak-check; FPL_LEAK_GATE=warn overrides), dry run or not.
said="$(mktemp -d)"
trap 'rm -rf -- "$said"' EXIT
printf '%s\n%s\n\n%s\n' "$branch" "$title" "$text" >"$said/pull-request"
"$top/scripts/leak-check" --text "$said/pull-request" || die "nothing was sent"

if [ "$dry" -eq 1 ]; then
	printf 'as:    %s\nbase:  %s\nhead:  %s\ndraft: %s\ntitle: %s\n\n%s\n' \
		"$login" "$base" "$branch" "$([ "$draft" -eq 1 ] && echo yes || echo no)" "$title" "$text" >&2
	exit 0
fi

pyapi create "$branch" "$base" "$title" "$text" "$draft"

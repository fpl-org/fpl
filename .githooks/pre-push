#!/usr/bin/env bash
#
# .githooks/pre-push — refuse to push to a remote branch whose name does not parse
# under docs/BRANCHES.md.
#
# reference-transaction stops a bad name at creation, but only in a clone whose
# hooks are wired (scripts/setup). This is the second local net: the name that
# would appear on the forge is judged right before it gets there. Deletions are
# let through so a non-conforming remote branch can still be cleaned up.
#
#   FPL_BRANCH_GATE = block (default) | warn | off

set -euo pipefail

mode="${FPL_BRANCH_GATE:-block}"
[ "$mode" = "off" ] && exit 0

# Radicle is not a forge with branch names of its own choosing: its remote helper keeps a
# patch under refs/heads/patches/<id>, and a new revision of a patch is a push there. The
# grammar is for names on the forge, so a push to a rad:// remote is not judged.
case "${2:-}" in rad://*) exit 0 ;; esac
lint="$(git rev-parse --show-toplevel)/scripts/branch-lint"
[ -x "$lint" ] || exit 0

rc=0
while read -r local_ref _local_sha remote_ref _remote_sha; do
	[ "$local_ref" = "(delete)" ] && continue
	case "$remote_ref" in refs/heads/*) : ;; *) continue ;; esac
	"$lint" "${remote_ref#refs/heads/}" || rc=1
done

[ "$rc" -eq 0 ] && exit 0
echo "pre-push: nothing was pushed. FPL_BRANCH_GATE=warn to override." >&2
[ "$mode" = "warn" ] && exit 0
exit 1

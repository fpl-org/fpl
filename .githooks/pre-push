#!/usr/bin/env bash
#
# .githooks/pre-push — two gates on what reaches a remote:
#
#   1. No private term or secret in what is pushed (scripts/leak-check): the patches,
#      file names and messages of every commit the remote does not have yet, and the
#      names of the refs pushed. A branch new to the remote is judged by the commits no
#      remote-tracking ref has. This runs for every remote, Radicle included: publishing
#      is publishing. FPL_LEAK_GATE = block (default) | warn | off, read by the script.
#
#   2. Refuse to push to a remote branch whose name does not parse under
#      docs/BRANCHES.md. reference-transaction stops a bad name at creation, but only in
#      a clone whose hooks are wired (scripts/setup). This is the second local net: the
#      name that would appear on the forge is judged right before it gets there.
#      Deletions are let through so a non-conforming remote branch can still be cleaned
#      up. FPL_BRANCH_GATE = block (default) | warn | off

set -euo pipefail

top="$(git rev-parse --show-toplevel)"
zero='^0+$'
mapfile -t updates

# 1. leak gate -------------------------------------------------------------------------
leak=0
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
names="$scratch/ref-names"
: >"$names"
for u in "${updates[@]}"; do
	read -r local_ref local_sha remote_ref remote_sha <<<"$u"
	[ "$local_ref" = "(delete)" ] && continue
	printf '%s\n' "$remote_ref" >>"$names"
	if [[ "$remote_sha" =~ $zero ]] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		revs="$local_sha --not --remotes"
	else
		revs="$remote_sha..$local_sha"
	fi
	"$top/scripts/leak-check" --range "$revs" || leak=1
done
"$top/scripts/leak-check" --text "$names" || leak=1
[ "$leak" -eq 0 ] || { echo "pre-push: nothing was pushed." >&2; exit 1; }

# 2. branch names ----------------------------------------------------------------------
mode="${FPL_BRANCH_GATE:-block}"
[ "$mode" = "off" ] && exit 0

# Radicle is not a forge with branch names of its own choosing: its remote helper keeps a
# patch under refs/heads/patches/<id>, and a new revision of a patch is a push there. The
# grammar is for names on the forge, so a push to a rad:// remote is not judged.
case "${2:-}" in rad://*) exit 0 ;; esac
lint="$top/scripts/branch-lint"
[ -x "$lint" ] || exit 0

rc=0
for u in "${updates[@]}"; do
	read -r local_ref _local_sha remote_ref _remote_sha <<<"$u"
	[ "$local_ref" = "(delete)" ] && continue
	case "$remote_ref" in refs/heads/*) : ;; *) continue ;; esac
	"$lint" "${remote_ref#refs/heads/}" || rc=1
done

[ "$rc" -eq 0 ] && exit 0
echo "pre-push: nothing was pushed. FPL_BRANCH_GATE=warn to override." >&2
[ "$mode" = "warn" ] && exit 0
exit 1

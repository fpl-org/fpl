#!/usr/bin/env bash
#
# .githooks/commit-msg — enforce .agents/COMMITS.md.
#
# Hard gates (reject on failure):
#   1. header  <type>(<scope>)<!?>: <summary>  — type in the allowed set, scope
#      [a-z0-9/._-]+, summary starts lower-case and has no trailing period,
#      whole header <= 72 chars
#   2. line 2 blank whenever a body/trailer follows
#   3. body lines <= 72 chars, except fenced code, table rows, and lines with no
#      break opportunity after column 72 (a long URL or path)
#   4. provenance: Assisted-By: + Session-Id: together, or a lone Human-Only: true
#   5. known trailers appear in canonical order
#   6. unless Human-Only, the commit author email equals .git/agent-identity
#   7. oracle guard: editing docs/DESIGN.md, docs/SPEC.md, fpl/features/*/spec.md or
#      fpl/features/*/examples/* requires the literal marker [spec] in the message
#  7b. policy guard: editing what sets how hard the gate judges (quality/, and the
#      pyproject.toml, Makefile and mutants.allow of the root and of bootstrap/)
#      requires the literal marker [policy], and such a commit may not also touch
#      the code or tests of a project (fpl/ or tests/, at the root or in bootstrap/)
#   8. stack record: on a stack branch, human or agent (scripts/branch-lint),
#      the message carries 'Stack: <name>'; a Stack: value is always
#      [a-z0-9][a-z0-9._-]*
#   9. agent territory: a commit that is not Human-Only sits on an agent branch
#      (agent/<id>/... or the flat vendor form <id>/<slug>, .agents/BRANCHES.md).
#      The branch <id> is the lead, not an exclusive author, so it is NOT
#      compared with Assisted-By; human commits on agent branches are legal.
#
# Advisory (documented, not machine-checkable): imperative mood, one logical
# change per commit, hunk-level staging.
#
# Leak gate (first, before any bypass: a merge message names branches): no private
# term or secret in the message (scripts/leak-check; FPL_LEAK_GATE=warn overrides).
#
# Bypassed for a real merge, a real revert (see is_merge, is_revert) and, outside lint mode,
# fixup!/squash!/amend! messages. A revert is real only when it holds the tree git revert
# makes of the commit it names.
#
# Lint mode (scripts/commit-lint, CI): FPL_LINT_COMMIT=<sha> judges a commit that
# already exists instead of the one being made. The author and the changed files
# then come from that commit, the branch from FPL_LINT_BRANCH (unset: gates 8
# and 9 do not compare against a branch), FPL_AGENT_EMAILS adds accepted agent
# addresses to the one in .git/agent-identity, and gate 10 is skipped.
# A fixup!/squash!/amend! commit is rejected there: a rebase-merge would land it
# as it is.

set -euo pipefail

msg_file="$1"
repo_root="$(git rev-parse --show-toplevel)"
first="$(sed -n '1p' "$msg_file")"
lint_commit="${FPL_LINT_COMMIT:-}"

# The private list is local, so there is nothing to judge a landed commit against in CI.
[ -n "$lint_commit" ] || "$repo_root/scripts/leak-check" --message "$msg_file"

fail() {
	echo "commit-msg: $1" >&2
	echo "           see .agents/COMMITS.md" >&2
	exit 1
}

case "$first" in
"fixup! "*|"squash! "*|"amend! "*)
	[ -z "$lint_commit" ] || fail "'${first%% *}' commit left in the branch; autosquash before landing"
	exit 0
	;;
esac

# A merge and a revert are what git wrote, not what a person typed: their messages cannot
# meet the header and trailer gates, and the diff of a merge is somebody else's work. They
# pass unjudged. What makes one is the commit, never the word its message opens with, or
# any commit could open with "Merge" and edit what it likes.
#   merge   a subject "Merge ..." on a commit with more than one parent (lint mode), or
#           with a merge in the making (MERGE_HEAD)
#   revert  a line 'This reverts commit <id>' naming a commit that exists, under any title,
#           over the tree git revert makes of that commit (is_revert). git writes the line in
#           two forms: '<sha>.' under its own title Revert "..." (Reapply "..." for the revert
#           of a revert), and, with --reference or revert.reference=true, '<abbrev>
#           (<subject>, <date>).' under the person's title or a comment line asking for one;
#           the person may retitle either. The revert of a merge (-m N) ends the line in
#           ', reversing' and names the parent on the next. The text alone is a sentence anyone
#           can type: the tree is what makes the revert.
# Not recognised: an amend of either. git tells commit-msg nothing of it (no argument, and
# no variable but the author's, which a plain commit has too), so the amended message of a
# merge or revert, reworded or not, is judged as a new commit and refused (an amend with
# nothing staged changes nothing against HEAD, so is no revert of it either). Telling the
# two apart would be a guess, and a guess is what a forger needs. The refusal below says how
# to get past it.
# Measured (git 2.54): `commit --amend -m/-F` and `commit -F` on a new commit give commit-msg
# the same arguments and GIT_* variables, and prepare-commit-msg the same source (message);
# `commit --amend` with no message and `commit -C HEAD` both give "commit HEAD". "HEAD has
# two parents" is no sign of an amend: it is also true of every commit made on top of a merge.
is_merge() {
	case "$first" in "Merge "*) ;; *) return 1 ;; esac
	if [ -n "$lint_commit" ]; then
		# rev-list --parents prints the commit, then each of its parents.
		local ids
		read -r -a ids < <(git rev-list --parents -n 1 "$lint_commit")
		[ "${#ids[@]}" -gt 2 ]
	else
		git rev-parse -q --verify MERGE_HEAD >/dev/null
	fi
}

# is_revert: whether the commit judged is the one `git revert` makes of the commit its message
# names. That is a tree, not a diff that agrees with it: git revert merges the parent of the
# named commit into the commit's own parent, over the named commit as the base, and the result
# is what the revert holds. The check makes the same merge (git merge-tree, git's merge, with
# its renames: a revert follows a file renamed since) and compares the trees, so the reverted
# lines must come back where they were. A comparison of diffs could not: git patch-id drops
# the line numbers, and a removed line put back at the end of a protected file read as its
# revert. A merge is undone against one of its parents (git revert -m N): any of them will do.
# A root commit is undone against the empty tree. Not recognised, and judged as any commit: a
# revert that did not merge cleanly (the person resolved it), one made with -X, and one that
# changes nothing. git merge-tree takes a tree for the empty side from git 2.45 on.
# The reference form names the commit by an abbreviated id: it must name one commit, and an id
# that two commits share names none. It is read as an object id only (rev-parse --disambiguate
# lists every object it starts), never as a ref that happens to be spelt in hex.
is_revert() {
	local reverted ids base made want i
	reverted="$(sed -En '/^This reverts commit [0-9a-f]{4,64}( \(.*\))?(\.|, reversing)$/{s/^This reverts commit ([0-9a-f]*).*/\1/p;q;}' "$msg_file")"
	[ -n "$reverted" ] || return 1
	reverted="$(git rev-parse --disambiguate="$reverted" 2>/dev/null |
		git cat-file --batch-check='%(objecttype) %(objectname)' | sed -n 's/^commit //p')"
	case "$reverted" in "" | *$'\n'*) return 1 ;; esac
	# The commit judged: its one parent and its tree (lint mode), or HEAD and what is staged.
	if [ -n "$lint_commit" ]; then
		read -r -a ids < <(git rev-list --parents -n 1 "$lint_commit")
		[ "${#ids[@]}" -eq 2 ] || return 1
		base="${ids[1]}"
		made="$(git rev-parse "$lint_commit^{tree}")"
	else
		base="$(git rev-parse -q --verify HEAD)" || return 1
		made="$(git write-tree 2>/dev/null)" || return 1
	fi
	[ "$made" != "$(git rev-parse "$base^{tree}")" ] || return 1
	read -r -a ids < <(git rev-list --parents -n 1 "$reverted")
	if [ "${#ids[@]}" -eq 1 ]; then ids+=("$(git hash-object -t tree /dev/null)"); fi
	for ((i = 1; i < ${#ids[@]}; i++)); do
		want="$(git merge-tree --write-tree --merge-base="$reverted" "$base" "${ids[$i]}" 2>/dev/null)" || continue
		[ "${want%%$'\n'*}" != "$made" ] || return 0
	done
	return 1
}
if is_merge || is_revert; then exit 0; fi

# Who wrote it. In lint mode that is the commit's author, not the environment's.
if [ -n "$lint_commit" ]; then
	author_email="$(git log -1 --format=%ae "$lint_commit")"
else
	author_email="${GIT_AUTHOR_EMAIL:-$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')}"
fi

# 1. header ----------------------------------------------------------------
types='feat|fix|docs|refactor|perf|test|build|ci|chore|revert'
if ! printf '%s' "$first" | grep -Eq "^(${types})(\([a-z0-9/._-]+\))?!?: .+"; then
	note=""
	case "${lint_commit:+lint}:$first" in
	:"Merge "*|:'Revert "'*|:'Reapply "'*)
		note=$'\n           a Merge, Revert or Reapply subject passes for a real merge or revert only; git does not tell this hook of an amend, so an amend of one, reworded or not, is judged as a new commit; to amend one: git commit --amend --no-verify'
		;;
	esac
	fail "header must be '<type>(<scope>): <summary>' — got: $first$note"
fi
[ "${#first}" -le 72 ] || fail "header is ${#first} chars (>72)"
summary="${first#*: }"
case "$summary" in
[A-Z]*) fail "summary must start lower-case: $summary" ;;
*.)     fail "summary must not end with a period: $summary" ;;
esac

# 2. blank line 2 --------------------------------------------------------------
if [ -n "$(sed -n '2p' "$msg_file")" ]; then
	fail "line 2 must be blank (one blank line between header and body)"
fi

# Split body / trailer block. The trailer block is the last paragraph when every
# one of its lines looks like  Token: value  (or a folded continuation).
# Not mapfile: bash 3.2, still /bin/bash on macOS, lacks it, and pre-push reaches this hook
# through scripts/commit-lint wherever a push is made.
lines=()
while IFS= read -r line || [ -n "$line" ]; do lines+=("$line"); done <"$msg_file"
n=${#lines[@]}
trailer_start=$n
if [ "$n" -gt 0 ]; then
	i=$((n - 1))
	# skip trailing blank lines
	while [ "$i" -ge 0 ] && [ -z "${lines[$i]}" ]; do i=$((i - 1)); done
	end=$i
	while [ "$i" -ge 0 ] && [ -n "${lines[$i]}" ]; do i=$((i - 1)); done
	blk_start=$((i + 1))
	is_block=1
	for ((j = blk_start; j <= end; j++)); do
		case "${lines[$j]}" in
		[A-Za-z]*:\ *|[[:space:]]*) : ;;   # trailer or folded continuation
		*) is_block=0; break ;;
		esac
	done
	[ "$is_block" -eq 1 ] && [ "$blk_start" -gt 1 ] && trailer_start=$blk_start
fi

# 3. body width --------------------------------------------------------------
in_fence=0
for ((k = 2; k < trailer_start; k++)); do
	line="${lines[$k]:-}"
	case "$line" in '```'*) in_fence=$((1 - in_fence)); continue ;; esac
	[ "$in_fence" -eq 1 ] && continue
	case "$line" in '|'*) continue ;; esac
	[ "${#line}" -le 72 ] && continue
	# allowed only if there is no space at/after column 73 (unbreakable token)
	rest="${line:72}"
	case "$rest" in *" "*) fail "body line $((k + 1)) is ${#line} chars (>72): $line" ;; esac
done

# 4. provenance --------------------------------------------------------------
if ! grep -Eq '^Human-Only:[[:space:]]*true[[:space:]]*$' "$msg_file"; then
	grep -Eq '^Assisted-By:[[:space:]]*\S' "$msg_file" \
		|| fail "missing 'Assisted-By:' trailer (or 'Human-Only: true')"
	grep -Eq '^Session-Id:[[:space:]]*\S' "$msg_file" \
		|| fail "missing 'Session-Id:' trailer (or 'Human-Only: true')"

	# 6. author identity ----------------------------------------------------
	id_file="$(git rev-parse --git-dir)/agent-identity"
	want=""
	[ -s "$id_file" ] && want="$(head -n1 "$id_file")"
	[ -z "$lint_commit" ] || want="$want ${FPL_AGENT_EMAILS:-}"
	want="$(printf '%s' "$want" | xargs)" # trim
	[ -n "$want" ] \
		|| fail "agent identity unset; run scripts/agent-identity set <email> (or commit with 'Human-Only: true')"
	known=0
	# An array, not an unquoted $want: the shell would glob an address such as
	# 41898282+claude[bot]@users.noreply.github.com against the working directory.
	read -r -a wanted <<<"$want"
	for w in "${wanted[@]}"; do
		[ "$author_email" = "$w" ] && known=1
	done
	[ "$known" -eq 1 ] \
		|| fail "author email is '$author_email', expected the machine account '$want' (use acommit, or -H for a human commit)"
fi

# 5. trailer order --------------------------------------------------------------
order="Refs Stack BREAKING-CHANGE Advisor Assisted-By Reasoning-Effort Session-Id Co-Authored-By"
prev=0
while IFS= read -r tok; do
	rank=0 idx=0
	for known in $order; do
		idx=$((idx + 1))
		[ "$tok" = "$known" ] && rank=$idx
	done
	[ "$rank" -eq 0 ] && continue
	[ "$rank" -ge "$prev" ] || fail "trailer '$tok' is out of order (expected: $order)"
	prev=$rank
done < <(sed -n 's/^\([A-Za-z][A-Za-z-]*\):[[:space:]].*/\1/p' "$msg_file")

# 7. oracle guard --------------------------------------------------------------
# has <regex>: some line of stdin matches. Not grep -q: that stops at the first match, the
# writer of a long list takes SIGPIPE, and under pipefail the match reads as no match.
has() { grep -E "$1" >/dev/null; }
protected='^(docs/DESIGN\.md|docs/SPEC\.md|fpl/features/[^/]+/spec\.md|fpl/features/[^/]+/examples/.+)$'
if [ -n "$lint_commit" ]; then
	changed="$(git diff-tree --no-commit-id --name-only -r --root "$lint_commit")"
else
	changed="$(git diff --cached --name-only)"
fi
if printf '%s\n' "$changed" | has "$protected"; then
	grep -Fq '[spec]' "$msg_file" \
		|| fail "this commit edits a protected spec file; add [spec] to the message if intentional"
fi

# 7b. policy guard ---------------------------------------------------------------
# The gate's strictness lives in files an attempt could otherwise loosen in the same
# breath as the code that needed it loosened (.agents/QUALITY.md). A change to them is
# named as one, and travels alone, so a reviewer sees it apart from any code.
policy='^(quality/.+|(bootstrap/)?(pyproject\.toml|Makefile|mutants\.allow))$'
if printf '%s\n' "$changed" | has "$policy"; then
	grep -Fq '[policy]' "$msg_file" \
		|| fail "this commit changes the gate's policy ($(printf '%s\n' "$changed" | grep -E "$policy" | head -n3 | xargs)); add [policy] to the message if intentional"
	if printf '%s\n' "$changed" | has '^(bootstrap/)?(fpl|tests)/'; then
		fail "a [policy] commit may not also change fpl/ or tests/ (or bootstrap/fpl/, bootstrap/tests/); split it"
	fi
fi

# 8. stack record ------------------------------------------------------------
# The refs of a landed stack get deleted and a linear landing leaves no merge
# commit, so the trailer is the only in-repo record of which commits formed one
# unit. Detached HEAD (mid-rebase) has no branch and is not judged.
stack_val="$(sed -n 's/^Stack:[[:space:]]*//p' "$msg_file" | head -n1)"
if [ -n "$stack_val" ]; then
	printf '%s' "$stack_val" | grep -Eq '^[a-z0-9][a-z0-9._-]*$' \
		|| fail "Stack: value '$stack_val' must match [a-z0-9][a-z0-9._-]*"
fi
if [ -n "$lint_commit" ]; then
	branch="${FPL_LINT_BRANCH:-}"
else
	branch="$(git branch --show-current)"
fi
parsed=""
[ -n "$branch" ] && parsed="$("$repo_root/scripts/branch-lint" --parse "$branch" 2>/dev/null || true)"
want_stack="$(printf '%s\n' "$parsed" | sed -n 's/^stack=//p')"
if [ -n "$want_stack" ]; then
	[ "$stack_val" = "$want_stack" ] \
		|| fail "on branch $branch the message needs 'Stack: $want_stack' (got '${stack_val:-none}'; acommit adds it)"
fi

# 9. agent territory ------------------------------------------------------------
# FPL_BRANCH_GATE = block (default) | warn | off, shared with the ref-name hooks.
branch_gate="${FPL_BRANCH_GATE:-block}"
if [ "$branch_gate" != "off" ] && [ -n "$branch" ] \
	&& ! grep -Eq '^Human-Only:[[:space:]]*true[[:space:]]*$' "$msg_file"; then
	branch_kind="$(printf '%s\n' "$parsed" | sed -n 's/^kind=//p')"
	case "$branch_kind" in
	agent-*|vendor) : ;;
	*)
		note="agent commit on '$branch', which is not an agent branch; work on agent/<id>/${branch} (.agents/BRANCHES.md)"
		[ "$branch_gate" = "warn" ] && echo "commit-msg: $note" >&2 || fail "$note"
		;;
	esac
fi

# 10. soft atomicity gate (LLM judge; fails open — see .githooks/atomic-check) ---
[ -n "$lint_commit" ] || "$repo_root/.githooks/atomic-check" "$msg_file" || exit $?

exit 0

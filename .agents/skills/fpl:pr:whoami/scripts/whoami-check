#!/usr/bin/env bash
#
# whoami-check — which account would a push from here use? A message, never a gate. It lives
# in .agents/skills/fpl:pr:whoami/scripts/; the skill fpl:pr:whoami says when to run it.
#
# Three identities can write to GitHub from one Mac, and they are not always the same one:
#
#   push   what git's credential helper hands out for https://github.com (the username line
#          only: the password is never read into a variable, let alone printed);
#   gh     the account `gh auth status` marks active;
#   ssh    the login GitHub greets for `ssh -T git@github.com`.
#
# When the owner's own (admin) account is any of them, an agent's push would go out under it
# and not under the machine account, so a NAG line says so and names the remedy. The script
# prints and exits 0 whatever it finds or cannot find: .githooks/pre-push runs it first as a
# message, and a refusal there would be a gate on the wrong thing.
#
#   FPL_ADMIN_ACCOUNTS   space-separated logins that count as admin (default: psjg)
#   FPL_MACHINE_ACCOUNT  the account the remedy names (default: psjg-claude)
#   FPL_WHOAMI_DEADLINE  seconds each probe may run before it is cut off (default: 10)
#
# Usage: whoami-check [DESTINATION-URL]. Run by hand it judges all three. Given the URL a
# push goes to (.githooks/pre-push passes its $2), it judges only the identity that URL's
# transport uses, so a push that already follows the remedy is not nagged: https without
# credentials uses the git credential helper; ssh uses the ssh key; an https URL that carries
# its own credentials (user:password@) uses neither (it is not judged: the credentials are not
# read); a bare user@ names the account itself. The probes ask about the URL's own host, user and
# port, so an ssh_config alias picks the key that is judged. The URL is only classified, never printed.
# A URL of any other shape is judged as if none were given. A probe whose identity the URL does
# not use is not run, so an https push never wakes the ssh key.
#
# Each probe is a plain command found on PATH (git, gh, ssh), which is how the self-test
# stubs them. Runs under bash 3.2.

set -u
# The admin list is split on spaces below: no word of it may expand as a pathname.
set -f

admins="${FPL_ADMIN_ACCOUNTS:-psjg}"
machine="${FPL_MACHINE_ACCOUNT:-psjg-claude}"

# via: which transport the destination uses, hence which identities decide the push, and the
# host, user and port the probes must ask about. A URL of any other shape, or none, keeps the
# defaults: all three probes, about github.com.
url="${1:-}"
c_push=1 c_gh=1 c_ssh=1 via=""
proto="https" host="github.com" named="" ssh_user="git" ssh_host="github.com" ssh_port=""
case "$url" in
https://* | http://*)
	proto="${url%%://*}"
	auth="${url#*://}"
	auth="${auth%%/*}"
	host="${auth##*@}"
	c_gh=0 c_ssh=0 via="https"
	# A password after a colon in the userinfo is what makes the URL carry its own credentials;
	# a bare user@ names the account itself, and the helper is not asked.
	case "$auth" in *@*) case "${auth%@*}" in
	*:*) c_push=0 via="https with credentials in the URL" ;;
	*) named="${auth%@*}" ;;
	esac ;; esac
	;;
ssh://*)
	auth="${url#ssh://}"
	auth="${auth%%/*}"
	c_push=0 c_gh=0 via="ssh" ssh_user=""
	case "$auth" in *@*) ssh_user="${auth%%@*}" ;; esac
	ssh_host="${auth##*@}"
	case "$ssh_host" in *:*) ssh_port="${ssh_host#*:}" ssh_host="${ssh_host%%:*}" ;; esac
	;;
*://* | /* | ./* | ../*) : ;; # another scheme, or a path on this machine: not judged by shape
*:*)                         # scp-like: [user@]host:path, as git reads it when no "/" comes first
	left="${url%%:*}"
	case "$left" in
	*/*) : ;;
	*)
		c_push=0 c_gh=0 via="ssh" ssh_user=""
		case "$left" in *@*) ssh_user="${left%%@*}" ;; esac
		ssh_host="${left##*@}"
		;;
	esac
	;;
esac
# What reaches a probe's command line is plain: a name or number, never an option or a control
# character; anything else goes back to the default.
case "$host" in '' | -* | *[[:cntrl:]]*) host="github.com" ;; esac
case "$ssh_host" in '' | -* | *[[:cntrl:]]*) ssh_host="github.com" ssh_user="git" ;; esac
case "$ssh_user" in -* | *[[:cntrl:]]*) ssh_user="git" ;; esac
case "$ssh_port" in *[!0-9]*) ssh_port="" ;; esac
[ -z "$via" ] || printf 'whoami-check: this push goes by %s\n' "$via"

# Every probe is cut off after FPL_WHOAMI_DEADLINE seconds (default 10): a credential helper that
# opens a dialog, a gh that waits on a keychain, a key that waits on a Touch ID tap must not hold
# up a push. timeout where there is one, else perl's alarm (a stock Mac has perl, not timeout),
# else no deadline. The empty array is expanded as ${bound[@]+...}: bash 3.2 under set -u fails
# on a bare "${bound[@]}".
dl="${FPL_WHOAMI_DEADLINE:-10}"
case "$dl" in '' | *[!0-9]*) dl=10 ;; esac
bound=()
if command -v timeout >/dev/null 2>&1; then
	bound=(timeout "$dl")
elif command -v perl >/dev/null 2>&1; then
	bound=(perl -e 'alarm shift; exec @ARGV' "$dl")
fi

# push: git's answer for the destination's host, the username line and nothing else. When the
# URL names the account (user@), that is the account and nobody is asked. Nor does git ask anyone
# itself: GIT_TERMINAL_PROMPT=0 stops only the terminal prompt, and git tries GIT_ASKPASS,
# core.askPass and SSH_ASKPASS before it, so all three are set empty. Git takes the first one it
# finds set, so the empty GIT_ASKPASS alone ends the search; the other two are cleared so the
# probe does not lean on that order. A credential helper's own dialog is not git's to stop: the
# deadline cuts it off.
push=""
if [ "$c_push" -eq 1 ]; then
	if [ -n "$named" ]; then
		push="$named"
	else
		push="$(printf 'protocol=%s\nhost=%s\n\n' "$proto" "$host" |
			GIT_TERMINAL_PROMPT=0 GIT_ASKPASS= SSH_ASKPASS= ${bound[@]+"${bound[@]}"} git -c core.askPass= credential fill 2>/dev/null |
			sed -n 's/^username=//p' | head -n 1)" || push=""
	fi
fi

# gh: the account whose block says "Active account: true"; the block opens with the login.
gh_acct=""
if [ "$c_gh" -eq 1 ]; then
	gh_acct="$(${bound[@]+"${bound[@]}"} gh auth status 2>&1 | awk '
		/Logged in to .* account / { for (i = 1; i < NF; i++) if ($i == "account") acct = $(i + 1) }
		/Active account: true/ { print acct; exit }')" || gh_acct=""
fi

# ssh: "Hi <login>! You've successfully authenticated ...". ssh exits 1 on success here. Never
# interactive: BatchMode=yes forbids every prompt, ConnectTimeout=5 bounds the connect, and the
# deadline bounds the whole probe. It dials the destination's own host (user, port and ssh_config
# alias included), so the key ssh_config picks for that name is the key judged. Not run at all
# when the destination does not use ssh.
ssh_acct=""
if [ "$c_ssh" -eq 1 ]; then
	ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=5)
	[ -z "$ssh_port" ] || ssh_cmd=("${ssh_cmd[@]}" -p "$ssh_port")
	ssh_cmd=("${ssh_cmd[@]}" -T -- "${ssh_user:+$ssh_user@}$ssh_host")
	ssh_acct="$(${bound[@]+"${bound[@]}"} "${ssh_cmd[@]}" 2>&1 </dev/null | sed -n 's/^Hi \([^!]*\)!.*/\1/p' | head -n 1)" ||
		ssh_acct=""
fi

nag=0
show() { # show <label> <login> <counts>: label "username" prints as username=<login>, others as label: <login>
	local who="${2:-}" a
	if [ -z "$who" ]; then
		if [ "${3:-1}" -eq 1 ]; then printf 'whoami-check: %sunknown\n' "$1"; else printf 'whoami-check: %snot used by this push\n' "$1"; fi
		return
	fi
	printf 'whoami-check: %s%s\n' "$1" "$who"
	[ "${3:-1}" -eq 1 ] || return 0
	for a in $admins; do [ "$who" = "$a" ] && nag=1; done
}
show "username=" "$push" "$c_push"
show "gh:       " "$gh_acct" "$c_gh"
show "ssh:      " "$ssh_acct" "$c_ssh"

if [ "$nag" -eq 1 ]; then
	echo "whoami-check: NAG: an admin account ($admins) is among these; a push would go out as it, not as $machine."
	echo "whoami-check: remedy: push with the machine account token URL:"
	echo "whoami-check:   TOKEN=\$(gh auth token --user $machine); git push \"https://x-access-token:\$TOKEN@github.com/<owner>/<repo>.git\" HEAD:refs/heads/<branch>"
	echo "whoami-check:   or log the admin account out of gh and the credential helper."
fi
exit 0

# Linked git worktrees live here (see docs/WORKTREES.md).
# Ignored so they don't show as untracked content in the main tree;
# `git worktree list` still tracks them normally.
worktrees/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/

# What the noslop lanes leave behind in a worktree (quality/noslop.mk)
.noslop/
mutants/
.hypothesis/
.import_linter_cache/

# direnv's cache of the dev shell (docs/DEVSHELL.md)
.direnv/

# Which dev shell direnv loads in this checkout, and a person's own additions to it
# (docs/DEVSHELL.md). Per-checkout choices, so they must never travel with a commit.
.fpl-shell
.envrc.local

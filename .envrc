# direnv: load the dev shell of flake.nix when you cd into the repo or a worktree
# (docs/DEVSHELL.md). Run `direnv allow` once per checkout; direnv refuses to load
# an .envrc it has not been shown, and asks again whenever this file changes.
#
# The default shell is always loaded. Forge tools are opt-in layers on top of it,
# chosen per checkout in the git-ignored file .fpl-shell, one name per line:
#
#   (no file)    no forge tooling at all
#   github       GitHub's CLI (gh)
#
# The file holds names, not code: `#` starts a comment, each line is reduced to
# [a-z0-9-] and must be one of the names below, which mirror `layers` in
# flake.nix. direnv would not vet a sourced script, so nothing here is sourced.
use flake

watch_file .fpl-shell
fpl_layers=""
if [ -f .fpl-shell ]; then
	while IFS= read -r fpl_line || [ -n "$fpl_line" ]; do
		fpl_name="$(printf '%s' "${fpl_line%%#*}" | tr -cd 'a-z0-9-')"
		case "$fpl_name" in
		"" | default) ;;
		github)
			case "$fpl_layers " in
			*" .#$fpl_name "*) ;; # named twice
			*) fpl_layers="$fpl_layers .#$fpl_name" ;;
			esac
			;;
		*) log_error "unknown layer '$fpl_name' in .fpl-shell (known: github); skipped" ;;
		esac
	done <.fpl-shell
fi

# Drop the roots of layers that are no longer asked for.
rm -f .direnv/fpl-layer .direnv/fpl-layer-*
if [ -n "$fpl_layers" ]; then
	# One build for all layers. The out-links under .direnv/ are garbage-collector
	# roots; PATH gets the store paths themselves, so `command -v gh` still shows
	# where a tool comes from.
	mkdir -p .direnv
	# shellcheck disable=SC2086 # fpl_layers is a list of validated installables
	if fpl_paths="$(nix build --out-link .direnv/fpl-layer --print-out-paths $fpl_layers)"; then
		for fpl_path in $fpl_paths; do
			[ -d "$fpl_path/bin" ] && PATH_add "$fpl_path/bin"
		done
	else
		log_error "could not build the layers$fpl_layers; continuing with the default shell"
	fi
fi
unset fpl_layers fpl_line fpl_name fpl_paths fpl_path

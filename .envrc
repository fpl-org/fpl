# Loads the dev shell of flake.nix (docs/DEVSHELL.md). Run `direnv allow` once per checkout.
#
# .fpl-shell, git-ignored, names the opt-in layers that are on in this checkout, one per
# line; `#` starts a comment. `scripts/layer` lists the layers and writes the file. No file
# means no forge tooling. Lines are read as names, never as code: each is cut down to
# [a-z0-9] and must be in the flake's own list.
watch_file .fpl-shell
fpl_known=" $(nix eval --raw .#lib.layerNames) "
fpl_names=""
if [ -f .fpl-shell ]; then
	while IFS= read -r fpl_line || [ -n "$fpl_line" ]; do
		fpl_name="$(printf '%s' "${fpl_line%%#*}" | tr -cd 'a-z0-9')"
		case "$fpl_name" in
		"" | default) continue ;;
		esac
		case "$fpl_known" in
		*" $fpl_name "*) fpl_names="$fpl_names $fpl_name" ;;
		*) log_error "unknown layer '$fpl_name' in .fpl-shell (known:${fpl_known% }); skipped" ;;
		esac
	done <.fpl-shell
fi

# The shell for a set of layers is named by their names, sorted and joined with "-".
# shellcheck disable=SC2086 # fpl_names is a list of validated words
fpl_shell="$(printf '%s\n' $fpl_names | LC_ALL=C sort -u | paste -sd- -)"
use flake ".#${fpl_shell:-default}"
unset fpl_known fpl_names fpl_line fpl_name fpl_shell

# direnv: load a dev shell of flake.nix when you cd into the repo or a worktree
# (docs/DEVSHELL.md). Run `direnv allow` once per checkout; direnv refuses to load
# an .envrc it has not been shown, and asks again whenever this file changes.
#
# Which shell is a per-checkout choice kept in the git-ignored file .fpl-shell:
#
#   (no file)                   default: no forge tooling at all
#   echo github > .fpl-shell    default + GitHub's CLI (gh)
#
# The file holds a name, not code: it is reduced to [a-z0-9-] and must be one of
# the names below, which mirror the devShells in flake.nix. direnv would not vet
# a sourced script, so nothing here is sourced.
watch_file .fpl-shell
fpl_shell=""
[ -f .fpl-shell ] && fpl_shell="$(tr -cd 'a-z0-9-' < .fpl-shell)"
case "$fpl_shell" in
"" | default) fpl_shell=default ;;
github) ;;
*)
	log_error "unknown dev shell '$fpl_shell' in .fpl-shell (known: default github); using default"
	fpl_shell=default
	;;
esac
use flake ".#$fpl_shell"
